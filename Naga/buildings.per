(or	(civilian-population g:>= desired-civ-pop)
(or	(up-compare-goal custom-civ-pop-total g:>= desired-civ-pop)
	(population g:>= max-civ-pop)))
(or	(up-compare-flag power-unit-flag == f-unique)
