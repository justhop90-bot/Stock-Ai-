(defrule
(or	(up-compare-goal custom-civ-pop-total g:>= desired-civ-pop)
	(population g:>= max-civ-pop))
	(dropsite-min-distance gold s:<= sn-maximum-gold-drop-distance)
	(dropsite-min-distance stone s:<= sn-maximum-stone-drop-distance)
	(dropsite-min-distance wood s:<= sn-maximum-wood-drop-distance)
	(dropsite-min-distance gold >= 0)
	(dropsite-min-distance stone >= 0)
	(dropsite-min-distance wood >= 0)
	(up-gaia-type-count-total c: wood >= 100)
	(up-gaia-type-count c: gold >= 10)
	(up-gaia-type-count c: stone >= 10)
=>
	(up-jump-rule 4))
(defrule
	(and	(up-compare-goal excess-gold >= 4450)
		(up-compare-goal excess-stone >= 1550))
=>
	(up-jump-rule 3))
(defrule
	(population-headroom < 40)
(or	(up-compare-goal trade-units >= 20)
(or	(up-compare-goal relic-count >= 5)
	(and	(up-compare-flag power-unit-flag == f-unique)
		(building-type-count-total castle <= 0))))
=>
	(up-jump-rule 2))
(defrule
	(population g:< del-civ-pop)
