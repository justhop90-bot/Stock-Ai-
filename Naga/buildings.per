	(up-reset-search 0 1 0 0)
	(up-jump-rule -2))
(defrule
	(goal temporary-goal 1)
	(up-compare-goal temporary-goal3 < 30)
(or	(up-compare-goal temp-x g:!= temp2-x)
	(up-compare-goal temp-y g:!= temp2-y))
	(up-compare-goal temp-x >= 0)
	(up-compare-goal temp-y >= 0)
	(up-compare-goal temp-x g:<= map-size)
	(up-compare-goal temp-y g:<= map-size)
	(up-point-distance temp-x temp2-x < 30)
(nor	(up-point-contains temp-x c: 934)
(or	(up-point-contains temp-x c: tree-class)
(or	(up-point-contains temp-x c: gold-mine-class)
(or	(up-point-contains temp-x c: stone-mine-class)
(or	(up-point-contains temp-x c: forage-bush-class)
