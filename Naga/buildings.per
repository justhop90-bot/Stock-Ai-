(defrule
	(goal temporary-goal 1)
	(up-set-target-object search-local c: 0)
(nor	(up-point-contains temp3-x c: 934)
(or	(up-point-contains temp3-x c: tree-class)
(or	(up-point-contains temp3-x c: gold-mine-class)
(or	(up-point-contains temp3-x c: stone-mine-class)
