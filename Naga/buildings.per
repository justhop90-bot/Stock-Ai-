(or	(unit-type-count-total elephant-archer-line g:< train-elearcher)
(or	(unit-type-count-total slinger g:< train-slinger)
(or	(unit-type-count-total grenadier g:< train-grenadier)
	(unit-type-count-total genitour-line g:< train-genitour)))))))))
=>
	(up-modify-flag desired-building-flag c:+ f-archery-range))
(defrule
	(strategic-number sn-current-age >= cimperial)
(or	(up-compare-flag power-unit-flag == f-cavalry-archer)
(or	(up-compare-flag power-unit-flag == f-hand-cannoneer)
(or	(up-compare-flag power-unit-flag == f-arbalester)
	(up-compare-flag power-unit-flag == f-elephant-archer))))
=>
	(up-modify-flag desired-building-flag c:+ f-archery-range))
(defrule
(or	(and	(building-type-count-total stable <= 0)
		(strategic-number sn-current-age >= cimperial))
(or	(unit-type-count-total knight-unit g:< train-knight)
(or	(unit-type-count-total camel-line g:< train-camel)
(or	(unit-type-count-total scout-cavalry-line g:< train-hussar)
(or	(unit-type-count-total battle-elephant-line g:< train-battle)
(or	(unit-type-count-total steppe-lancer-line g:< train-steppe)
(or	(unit-type-count-total shrivamsha-rider-line g:< train-shrivamsha)
	(and	(civ-selected hun)
