=>
	(up-copy-point temp3-x temp7-x)
	(up-find-local g: temporary-goal4 c: 1)
	(up-set-target-object search-local c: 0)
	(up-get-point position-object temp6-x)
	(up-copy-point temp5-x temp6-x)
	(up-lerp-tiles temp6-x temp3-x c: -2)
	(up-set-target-point temp6-x))
(defrule
	(up-set-target-object search-local c: 0)
(or	(up-point-explored temp6-x == explored-no)
(or	(or	(up-compare-goal temp6-x g:>= map-size)
		(up-compare-goal temp6-y g:>= map-size))
	(or	(up-compare-goal temp6-x < 0)
		(up-compare-goal temp6-y < 0))));)
=>
