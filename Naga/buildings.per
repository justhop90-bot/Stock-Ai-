	(up-point-terrain temp-x == terrain-water))))));))))))))
=>
;	(up-chat-data-to-self "Huh: %d." g: temporary-goal3)
	(up-lerp-tiles temp-x temp2-x c: -1)
	(up-set-target-point temp-x)
;	(up-send-flare temp-x)
	(up-modify-goal temporary-goal3 c:+ 1)
	(up-jump-rule -5))
