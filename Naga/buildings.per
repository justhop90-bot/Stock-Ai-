(defrule
	(true)
=>
	(up-get-fact building-type-count-total lumber-camp temporary-goal15)
	(up-modify-goal temporary-goal15 c:- 1)
	(up-modify-goal temporary-goal15 c:max 0)
	(up-get-fact building-type-count-total mule-cart temporary-goal19)
	(up-modify-goal temporary-goal19 c:- 1)
	(up-modify-goal temporary-goal19 c:max 0)
	(up-modify-goal temporary-goal15 g:+ temporary-goal19)
	(up-get-fact building-type-count-total settlement temporary-goal19)
	(up-modify-goal temporary-goal19 c:- 2); 1
	(up-modify-goal temporary-goal19 c:max 0)
	(up-modify-goal temporary-goal15 g:+ temporary-goal19)
	(up-get-fact building-type-count-total town-center temporary-goal19)
	(up-modify-goal temporary-goal19 c:- 1)
	(up-modify-goal temporary-goal19 c:max 0)
	(up-modify-goal temporary-goal15 g:+ temporary-goal19)
	(set-goal desired-building-flag 0))
(defrule
(or	(and	(building-type-count-total siege-workshop <= 0)
		(strategic-number sn-current-age >= cimperial))
(or	(and	(unit-available traction-trebuchet)
		(unit-type-count-total trebuchet-unit g:< train-trebuchet))
(or	(unit-type-count-total ram-unit g:< train-ram)
(or	(unit-type-count-total flaming-camel g:< train-flaming)
(or	(unit-type-count-total mangonel-unit g:< train-mangonel)
(or	(up-compare-goal scorpion-unit-count-total g:< train-scorpion)
(or	(unit-type-count-total mounted-trebuchet g:< train-mounted-trebuchet)
	(unit-type-count-total bombard-cannon-line g:< train-bombard))))))))
=>
	(up-modify-flag desired-building-flag c:+ f-siege-workshop))
(defrule
(or	(unit-type-count-total militiaman-line g:< train-champ)
(or	(unit-type-count-total spearman-line g:< train-pike)
(or	(unit-type-count-total eagle-scout-line g:< train-eagle)
(or	(unit-type-count-total champi-line g:< train-champi)
(or	(unit-type-count-total ibirapema-warrior-line g:< train-ibirapema)
(or	(unit-type-count-total temple-guard-line g:< train-temple-guard)
(or	(unit-type-count-total condottiero g:< train-condottiero)
(or	(unit-type-count-total flemish-militia-set g:< train-flemish)
(or	(unit-type-count-total fire-lancer-line g:< train-fire-lancer)
(or	(up-compare-goal jian-swordsman-count g:< train-jian)
	(and	(civ-selected gothic)
		(and	(unit-type-count-total huskarl-set g:< train-unique)
			(and	(up-research-status c: ri-anarchy >= research-pending)
				(or	(unit-available barracks-huskarl)
					(unit-available elite-barracks-huskarl)))))))))))))))
=>
	(up-modify-flag desired-building-flag c:+ f-barracks))
(defrule
	(strategic-number sn-current-age >= cimperial)
(or	(building-type-count-total barracks <= 0)
(or	(up-compare-flag power-unit-flag == f-champion)
(or	(up-compare-flag power-unit-flag == f-condottiero)
(or	(up-compare-flag power-unit-flag == f-eagle-warrior)
(or	(up-compare-flag power-unit-flag == 65536)
(or	(up-compare-flag power-unit-flag == 131072)
(or	(up-compare-flag power-unit-flag == 262144)
(or	(up-compare-flag power-unit-flag == f-fire-lancer)
	(up-compare-flag power-unit-flag == f-jian-swordsman)))))))))
=>
	(up-modify-flag desired-building-flag c:+ f-barracks))
(defrule
(or	(and	(building-type-count-total archery-range <= 0)
		(strategic-number sn-current-age >= cimperial))
(or	(unit-type-count-total archer-line g:< train-archer)
(or	(unit-type-count-total skirmisher-line g:< train-skirm)
(or	(unit-type-count-total hand-cannoneer g:< train-handcannon)
