	(and	(up-compare-goal trade-units < 4)
		(building-type-count-total feitoria <= 0)))
(or	(up-gaia-type-count c: gold <= 0)
(or	(up-gaia-type-count c: stone <= 0)
(or	(up-compare-const sd-game == 1)
(or	(up-compare-goal excess-wood < 475)
(or	(up-compare-goal excess-food < 475)
(or	(up-compare-goal excess-gold < 475)
	(and	(up-compare-goal excess-stone < castle-stone)
		(or	(and	(up-research-status c: ri-bombard-tower >= research-pending)
				(building-type-count-total bombard-tower < 4))
			(building-type-count-total castle < 4)))))))))
=>
	(up-get-fact building-type-count-total feitoria temporary-goal)
	(up-modify-goal construct-feitoria g:max temporary-goal)
	(up-modify-goal construct-feitoria c:+ 1)
	(up-modify-goal construct-feitoria g:min feitoria-cap)
	(up-jump-rule 1))
(defrule
	(population g:< del-civ-pop)
(or	(up-compare-goal custom-civ-pop-total g:< desired-civ-pop)
(or	(and	(up-compare-goal trade-units < 8)
