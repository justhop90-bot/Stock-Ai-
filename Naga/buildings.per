	(up-modify-goal temporary-goal c:+ 10); 8
	(up-filter-distance g: temporary-goal c: -1)
	(up-find-local c: lumber-camp c: 32)
	(up-find-local c: mining-camp c: 32)
	(up-remove-objects search-local object-data-progress-type >= 1)
	(up-target-point 0 action-delete -1 -1))

(defrule
	(up-pending-objects c: fish-trap >= 1)
	(unit-type-count-total fishing-ship-class <= 0); more traps than fish
	(unit-type-count-total fishing-ship-class g:>= train-fish); and
	(up-compare-goal excess-wood < 1000); no more pond fishing / production
=>
	(up-full-reset-search)
	(up-filter-status c: status-pending c: list-active)
	(up-find-status-local c: fish-trap c: 1))
(defrule
	(up-pending-objects c: fish-trap >= 1)
	(unit-type-count-total fishing-ship-class <= 0); more traps than fish
	(unit-type-count-total fishing-ship-class g:>= train-fish); and
	(up-compare-goal excess-wood < 1000); no more pond fishing / production
	(up-set-target-object search-local c: 0)
=>
;	(chat-local-to-self "Deleting pending fish-trap.")
	(up-target-point 0 action-delete -1 -1))


