(defrule
	(up-set-target-object search-local c: 0)
(or	(up-point-contains temp6-x c: 934)
(or	(up-point-contains temp6-x c: tree-class)
(or	(up-point-contains temp6-x c: gold-mine-class)
(or	(up-point-contains temp6-x c: stone-mine-class)
(or	(up-point-contains temp6-x c: forage-bush-class)
(or	(up-point-terrain temp6-x == terrain-water-deep-ocean)
(or	(up-point-terrain temp6-x == terrain-water-medium)
(or	(up-point-terrain temp6-x == terrain-water-deep)
(or	(up-point-terrain temp6-x == terrain-water-azure)
(or	(up-point-terrain temp6-x == terrain-water-bridge)
(or	(up-point-terrain temp6-x == terrain-water-old)
(or	(up-point-terrain temp6-x == terrain-water-yellow-shallow)
(or	(up-point-terrain temp6-x == terrain-water-yellow-deep);terrain-water-weeds
	(up-point-terrain temp6-x == terrain-water))))))))))))))
=>
;	(up-send-flare temp6-x)
	(up-reset-search 0 1 0 0)
	(up-jump-rule -3))
(defrule
	(up-set-target-object search-local c: 0)
	(up-set-target-by-id g: temporary-goal2)
