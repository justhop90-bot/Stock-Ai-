(or	(up-research-status c: ri-ballistas >= research-available)
(or	(up-research-status c: ri-cilician-fleet >= research-available)
(or	(civ-selected armenians)
(or	(civ-selected romans)
	(civ-selected saracen)))))
=>
	(up-modify-goal temporary-goal2 c:+ 100)); end mini jump
