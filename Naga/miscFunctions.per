(defrule
	(up-compare-goal ship-selection-function-id < 10000)
=>
	(up-jump-rule 41))
(defrule
	(true)
=>
	(up-get-rule-id ship-selection-function-id)
	(up-jump-rule 40)
	(disable-self))
(defrule
	(true)
=>
	(set-goal primary-ship -1)
	(set-goal temporary-goal galley-line)
	(set-goal temporary-goal2 0)
	(set-goal temporary-goal3 -1))
(defrule ; end neg jump
	(goal temporary-goal galley-line)
(not	(unit-available galley-line))
=>
	(up-modify-goal temporary-goal2 c:- 5000)
	(up-jump-rule 6))
(defrule
	(goal temporary-goal galley-line)
(or	(up-research-status c: imperial-age <= research-available)
	(up-compare-const GALLEON-AVAILABLE == YES))
=>
	(up-modify-goal temporary-goal2 c:+ 100))
(defrule
	(goal temporary-goal galley-line)
(or	(up-compare-goal target-distance >= 126)
(or	(and	(goal player-position pocket)
		(up-compare-goal target-distance >= 90))
	(up-compare-goal map-type >= type-islands)))
=>
	(up-modify-goal temporary-goal2 c:+ 20))
(defrule
	(goal temporary-goal galley-line)
	(up-research-status c: ri-fletching >= research-pending)
=>
	(up-modify-goal temporary-goal2 c:+ 25))
(defrule
	(goal temporary-goal galley-line)
