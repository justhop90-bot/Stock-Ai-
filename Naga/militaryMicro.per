(defrule
;	(up-timer-status three-seconds != timer-running)
	(goal drush-waypoint 1)
;	(up-compare-goal temporary-goal11 g:<= temporary-goal12)
	(up-timer-status reset-now-timer != timer-running)
	(up-compare-goal temporary-goal >= 7); dist to waypoint
	(up-compare-goal temporary-goal3 >= 5); 7; dist to drush-target
=>
