	(up-remove-objects search-local object-data-action == actionid-enter)
	(up-remove-objects search-local object-data-attack-stance == stance-no-attack)
	(up-remove-objects search-local object-data-target == villager-class)
	(up-remove-objects search-local object-data-target == infantry-class)
	(up-remove-objects search-local object-data-target == scout-cavalry-class)
	(up-remove-objects search-local object-data-target == cavalry-class)
	(up-remove-objects search-local object-data-target == archery-class)
	(up-remove-objects search-local object-data-target == monastery-class)
	(up-remove-objects search-local object-data-target == siege-weapon-class)
	(up-remove-objects search-local object-data-target == dangerous-animal-class)
	(up-set-target-point drush-target-x)
	(up-remove-objects search-local object-data-distance <= 4); 6
	(up-target-point 0 action-attack-move formation-box -1)
	(up-jump-rule 1))
(defrule
	(up-compare-goal drush-waypoint != 1)
	(up-compare-goal temporary-goal3 >= 5); 7
	(up-timer-status reset-now-timer != timer-running)
=>
;	(chat-local-to-self text-move-drush-target); "Move directly to the drush-target."
