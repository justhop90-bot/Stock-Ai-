(defrule ; debug rule
(or	(strategic-number sn-focus-player-number >= 9)
(or	(strategic-number sn-focus-player-number <= 0)
	(stance-toward focus-player ally)))
	(strategic-number sn-target-player-number >= 1)
	(strategic-number sn-target-player-number <= 8)
(not	(stance-toward target-player ally))
	(player-in-game target-player)
=>
	(chat-to-player my-player-number "Debugging focus player. -77")
	(up-modify-goal temporary-goal s:= sn-target-player-number); to prevent further bugs
	(up-modify-sn sn-focus-player-number s:= sn-target-player-number)); should be an enemy

(defrule
	(up-group-size c: 8 >= 1)
(or	(and	(players-building-count target-player <= 0)
		(up-compare-goal drush-target != relic))
	(and	(up-compare-flag micro-flag != f-drush-micro)
		(up-compare-flag micro-flag != f-scrush-micro)))
=>
	(chat-local-to-self "Resetting group 8.")
	(up-modify-group-flag 0 c: 8)
	(up-reset-group c: 8)
	(up-jump-rule 5))
(defrule
(or	(and	(players-building-count target-player <= 0)
		(or	(and	(up-compare-goal drush-target != relic)
				(up-compare-goal military-choice != relic-war))
			(up-compare-goal sighted-relics <= 0)))
	(and	(up-compare-flag micro-flag != f-drush-micro)
		(up-compare-flag micro-flag != f-scrush-micro)))
=>
	(up-jump-rule 4))
(defrule
	(up-group-size c: 8 <= 0);
	(unit-type-count militiaman-line g:< essential-soldiercount)
	(unit-type-count champi-line g:< essential-soldiercount)
	(unit-type-count scout-cavalry-line g:< essential-soldiercount)
(or	(and	(and	(unit-type-count militiaman-line <= 2); 0
				(unit-type-count champi-line <= 2)); 0
		(unit-type-count scout-cavalry-line <= 1))
	(and	(players-military-population target-player >= 2)
		(and	(up-compare-goal attacking != yes)
			(up-compare-goal assistance != yes))))
=>
	(up-jump-rule 3))
(defrule
	(true);	(up-group-size c: 8 <= 0)
=>
	(up-full-reset-search)
	(up-filter-include cmdid-military -1 -1 -1)
	(up-filter-exclude -1 actionid-explore -1 -1)
	(up-modify-goal temporary-goal g:= my-mpop)
;;;	(up-modify-goal temporary-goal c:min 240)
	(up-find-local c: all-units-class g: temporary-goal)
;	(up-remove-objects search-local object-data-group-flag >= 0)
	(up-remove-objects search-local object-data-range >= 3)
	(up-remove-objects search-local object-data-speed <= 89); 101
	(up-remove-objects search-local object-data-base-attack <= 2)
	(up-remove-objects search-local object-data-status != status-ready)
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-index >= 40))
(defrule
	(up-set-target-by-id g: scouting-unit)
	(players-building-count target-player <= 0)
(or	(and	(up-compare-goal drush-target != relic)
		(up-compare-goal military-choice != relic-war))
	(up-compare-goal sighted-relics <= 0))
	(up-compare-goal scout-count >= 1)
	(up-compare-goal target-distance >= 90)
=>
	(up-remove-objects search-local object-data-id g:== scouting-unit))
(defrule
	(up-set-target-object search-local c: 0)
=>
;	(chat-local-to-self "Create group 8.")
	(up-modify-group-flag 0 c: 8)
	(up-reset-group c: 8)
	(up-create-group 0 0 c: 8)
	(up-modify-group-flag 1 c: 8)); end jump
(defrule
	(up-group-size c: 8 >= 1)
=>
	(up-full-reset-search)
	(up-set-group search-local c: 8)
	(up-remove-objects search-local object-data-status != status-ready)
	(up-target-point 0 action-none -1 stance-defensive)
	(up-modify-group-flag 0 c: 8)
	(up-reset-group c: 8)
	(up-create-group 0 0 c: 8)
	(up-modify-group-flag 1 c: 8)
	(up-get-search-state local-total)
	(up-modify-goal temporary-goal g:= local-total)
	(up-clean-search search-local object-data-hitpoints search-order-desc)
	(up-set-target-object search-local c: 0)
	(up-get-object-data object-data-hitpoints temporary-goal2)
	(up-remove-objects search-local object-data-order != orderid-explore))
(defrule
	(up-group-size c: 8 >= 1)
	(up-compare-goal temporary-goal2 <= 3)
=>
;	(chat-local-to-self "Disband low hp group.")
	(up-full-reset-search)
	(up-set-group search-local c: 8)
	(up-modify-group-flag 0 c: 8)
	(up-reset-group c: 8))
(defrule
(or	(up-group-size c: 3 >= 1)
	(up-group-size c: 8 >= 1))
(or	(up-set-target-object search-local c: 0)
	(up-compare-goal temporary-goal g:>= my-mpop))
	(up-compare-goal drush-target != 0)
=>
;	(up-chat-data-to-self "Explorer in ctrl-group detected: %d." g: scouting)
	(set-strategic-number sn-total-number-explorers 0)
	(set-strategic-number sn-number-explore-groups 0)
	(up-reset-scouts))

(defrule
	(up-compare-flag micro-flag == f-drush-micro)
	(up-group-size c: 8 <= 0)
(or	(unit-type-count militiaman-line g:>= essential-soldiercount)
(or	(unit-type-count champi-line g:>= essential-soldiercount)
	(military-population g:> essential-soldiercount)))
	(players-building-count target-player <= 0)
	(goal gather-inside no)
=>
	(chat-local-to-self "Drush: No enemy found.")
	(up-full-reset-search)
	(up-filter-exclude -1 actionid-explore -1 -1)
	(up-filter-include cmdid-military -1 -1 on-mainland)
	(up-find-local c: all-units-class c: 40)
	(up-get-point scouting-type temp-x)
	(up-set-target-point temp-x)
	(up-target-point 0 action-attack-move formation-stagger -1)
	(disable-self))


(defrule ; 126
(or	(game-time < 3)
(or	(up-group-size c: 8 <= 0)
	(and	(up-compare-flag micro-flag != f-drush-micro)
		(up-compare-flag micro-flag != f-scrush-micro))))
=>
;	(set-goal drush-waypoint 0)
	(up-jump-rule 68))
(defrule
	(true)
=>
	(up-full-reset-search)
	(up-set-group search-local c: 8)
	(up-remove-objects search-local object-data-action != actionid-move)
	(up-set-target-point drush-target-x)
	(up-target-point 0 action-stop -1 -1)
	(disable-self))
(defrule
	(true)
=>
	(set-goal temporary-goal 0)
	(set-goal temporary-goal2 0)
	(set-goal temporary-goal3 0)
	(up-full-reset-search)
	(up-find-remote c: mining-camp c: 8)
	(up-find-remote c: lumber-camp c: 8)
	(up-find-remote c: settlement c: 8)
	(up-find-remote c: mill c: 8)
	(up-find-remote c: mule-cart c: 8)
	(up-remove-objects search-remote object-data-map-zone-id g:!= main-zone))
(defrule
	(up-set-target-object search-remote c: 0)
	(players-building-type-count target-player town-center >= 1)
=>
	(disable-self))
(defrule
	(up-compare-goal sighted-relics >= 1)
(or	(and	(building-type-count-total monastery >= 1)
		(or	(unit-type-count-total monk >= 1)
			(unit-type-count-total warrior-priest >= 1)))
	(up-research-status c: castle-age >= research-pending))
(or	(goal military-choice relic-war)
(or	(and	(or	(goal military-choice kecil)
				(goal military-choice besar))
		(building-type-count-total monastery >= 1))
	(not	(up-set-target-object search-remote c: 0))))
=>
	(up-full-reset-search)
	(up-set-target-point self-x)
	(up-modify-goal temporary-goal4 s:= sn-focus-player-number)
	(set-strategic-number sn-focus-player-number 0)
	(up-find-remote c: relic c: 40)
	(up-modify-sn sn-focus-player-number g:= temporary-goal4)
	(up-remove-objects search-remote object-data-map-zone-id g:!= main-zone)
;	(up-remove-objects search-remote object-data-distance g:> target-distance)
	(up-set-target-point target-x)
	(up-clean-search search-remote object-data-distance search-order-asc))
(defrule
	(up-set-target-object search-remote c: 0)
=>
	(up-get-object-data object-data-type drush-target)
	(up-jump-rule 1))
(defrule
	(true)
=>
	(set-goal drush-target 0)
	(set-goal drush-waypoint 0))
(defrule
	(up-compare-goal drush-target == 0)
;	(players-building-count target-player >= 1)
	(strategic-number sn-number-attack-groups != 998)
=>
;	(chat-local-to-self "Attacking with groups.")
	(set-strategic-number sn-number-attack-groups 998)
	(set-strategic-number sn-percent-attack-soldiers 100)
	(set-strategic-number sn-minimum-attack-group-size 1)
	(set-strategic-number sn-maximum-attack-group-size 8)
	(up-jump-rule 1))
(defrule
	(up-compare-goal drush-target != 0)
;	(players-building-count target-player >= 1)
	(strategic-number sn-number-attack-groups == 998)
=>
;	(chat-local-to-self "Disabling groups.")
	(up-reset-unit c: -1)
	(up-set-attack-stance -1 c: stance-aggressive)
	(set-strategic-number sn-number-attack-groups 0)
	(set-strategic-number sn-percent-attack-soldiers 0)
	(set-strategic-number sn-minimum-attack-group-size 1)
	(set-strategic-number sn-maximum-attack-group-size 1)); end mini-jump

(defrule
	(up-compare-goal drush-target == relic)
=>
	(set-strategic-number sn-gather-defense-units 0)
	(up-jump-rule 2))
(defrule
	(up-compare-goal drush-target != 0)
=>
	(up-full-reset-search)
	(up-set-target-point drush-target-x)
	(up-filter-distance c: -1 c: 2); lerp
	(up-find-remote g: drush-target c: 1))
(defrule
(not	(up-set-target-object search-remote c: 0))
	(up-compare-goal drush-target != 0)
=>
;	(up-chat-data-to-self "Updating drush-target: %d" g: drush-target)
	(up-copy-point drush-target-x self-x)
	(set-goal drush-waypoint 0)
	(up-full-reset-search)
	(up-set-group search-local c: 8)
	(up-set-target-object search-local c: 0)
	(up-get-point position-object temp5-x)
	(up-set-target-point temp5-x)
	(up-find-remote g: drush-target c: 16)
	(up-clean-search search-local object-data-distance search-order-asc)); end jump
(defrule
	(up-compare-goal drush-target != 0)
	(up-set-target-object search-remote c: 0)
=>
	(up-get-point position-object drush-target-x)
;	(up-lerp-tiles drush-target-x temp5-x c: 1)
	(up-bound-precise-point drush-target-x 0 c: 1))
(defrule
	(up-compare-goal drush-target != 0)
	(up-set-target-object search-remote c: 0)
=>
	(up-full-reset-search)
	(up-set-target-point drush-target-x)
	(up-set-group search-local c: 8)
	(up-clean-search search-local object-data-distance search-order-desc); asc
	(up-set-target-object search-local c: 0)
	(up-get-point position-object temp5-x)
	(up-get-point-distance temp5-x drush-target-x temporary-goal3))

(defrule
	(up-compare-goal drush-target != 0)
	(up-compare-goal drush-waypoint <= 0)
	(players-building-type-count target-player town-center >= 1)
=>
	(up-full-reset-search)
	(up-get-point-distance self-x drush-target-x temporary-goal11)
	(up-modify-goal temporary-goal11 c:- 3); test
	(up-set-target-point self-x)
	(up-find-remote c: town-center c: 1);
	(up-set-target-object search-remote c: 0)
	(up-get-point position-object temp-x)
	(up-get-point-distance self-x temp-x temporary-goal12))
(defrule
	(up-compare-goal temporary-goal11 g:> temporary-goal12)
	(up-compare-goal drush-target != 0)
	(up-compare-goal drush-waypoint <= 0)
	(players-building-type-count target-player town-center >= 1)
=>
;	(chat-local-to-self "Need a waypoint to the drush-target.")
	(set-goal drush-waypoint 1))

(defrule
	(up-compare-goal drush-target == relic)
	(up-compare-goal drush-waypoint != 1)
	(up-compare-goal temporary-goal3 >= 5); 7
	(up-timer-status reset-now-timer != timer-running)
=>
