(defrule
	(up-group-size c: 3 >= 1)
(or	(up-timer-status orb-cd == timer-running)
	(up-timer-status group3 == timer-triggered))
=>
;	(chat-local-to-self "Resetting group 3.1")
	(disable-timer group3)
