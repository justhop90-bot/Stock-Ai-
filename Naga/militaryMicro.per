); end jump

(defrule
	(goal drush-waypoint 1)
=>
	(up-full-reset-search)
	(up-set-target-point self-x)
	(up-find-remote c: town-center c: 1)
	(up-find-remote c: castle c: 1)
	(up-find-remote c: bombard-tower c: 1)
	(up-find-remote c: watch-tower c: 1)
	(up-find-remote c: farm-class c: 1)
	(up-find-remote c: building-class c: 1)
	(up-set-target-object search-remote c: 0)
	(up-get-point position-object drush-waypoint-x)
	(up-get-point position-object drush-waypoint2-x)
	(up-cross-tiles drush-waypoint-x self-x c: -20)
	(up-cross-tiles drush-waypoint2-x self-x c: 20)
	(up-bound-precise-point drush-waypoint-x 0 c: 1)
	(up-bound-precise-point drush-waypoint2-x 0 c: 1)
;	(up-get-point position-center temp5-x)
)

(defrule
	(goal drush-waypoint 1)
=>
	(up-full-reset-search)
	(up-get-point-distance drush-target-x drush-waypoint-x temporary-goal11); right?
	(up-get-point-distance drush-target-x drush-waypoint2-x temporary-goal12)); left?
(defrule
	(goal drush-waypoint 1)
	(up-compare-goal temporary-goal11 g:> temporary-goal12)
;	(up-compare-goal duc-dfu != -1)
=>
	(up-copy-point drush-waypoint-x drush-waypoint2-x)
	(up-set-target-point drush-waypoint-x))
(defrule
	(goal drush-waypoint 1)
	(false);	(up-point-contains drush-waypoint-x c: tree-class)
	(up-point-distance drush-waypoint-x self-x >= 4); temp5-x
=>
	(up-lerp-tiles drush-waypoint-x self-x c: 1); temp5-x
	(up-jump-rule -1))

(defrule
	(goal drush-waypoint 1)
=>
	(up-full-reset-search)
	(up-set-group search-local c: 8)
	(up-set-target-point self-x);
	(up-clean-search search-local object-data-distance search-order-desc)
	(up-set-target-object search-local c: 0)
	(up-get-point position-object temp6-x)
	(up-set-target-point temp6-x);
	(up-get-point-distance self-x temp6-x temporary-goal2); dist to units
	(up-get-point-distance self-x drush-waypoint-x temporary-goal)); dist to waypoint
(defrule
	(goal drush-waypoint 1)
	(up-compare-goal temporary-goal2 g:> temporary-goal); waypoint closer than units
=>
	(up-copy-point drush-retreat-x drush-waypoint-x))
(defrule
	(goal drush-waypoint 1)
(or	(up-compare-goal temporary-goal2 g:<= temporary-goal); units closer than waypoint
	(and	(strategic-number sn-minimum-attack-group-size == 8)
		(strategic-number sn-maximum-attack-group-size == 8)))
=>
	(up-set-target-point self-x)
	(up-copy-point drush-retreat-x self-x))

(defrule
	(up-compare-goal drush-target != 0)
=>
	(up-full-reset-search)
	(up-set-group search-local c: 8)
	(up-set-target-object search-local c: 0)
	(up-get-point position-object temp6-x)
	(up-get-point-distance temp6-x drush-waypoint-x temporary-goal)); distance to waypoint

(defrule
	(goal drush-waypoint 1)
	(up-timer-status reset-now-timer != timer-running)
=>
	(up-full-reset-search)
;	(up-set-target-point self-x)
