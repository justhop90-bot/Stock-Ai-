(defrule
(or	(unit-type-count-total villager <= 0)
(or	(and	(up-compare-goal excess-gold < 1200)
		(and	(goal attacking no)
			(or	(goal strategy fast-imp)
				(goal strategy stonewall))))
(or	(up-research-status c: ri-guilds == research-queued)
	(up-research-status c: ri-guilds == research-pending))))
=>
	(up-jump-rule 10))
(defrule
	(goal military-choice monk-treb)
	(strategic-number sn-current-age == castlea)
	(building-available castle)
	(building-type-count-total castle <= 0)
(not	(up-pending-placement c: castle))
