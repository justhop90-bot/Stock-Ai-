(defrule
	(goal escrowing no)
(or	(up-compare-goal escrow-cost-wood >= 1)
(or	(up-compare-goal escrow-cost-food >= 1)
(or	(up-compare-goal escrow-cost-gold >= 1)
	(up-compare-goal escrow-cost-stone >= 1))))
=>
;	;(chat-to-player my-player-number "Debugging escrow.t")
	(set-goal escrow-cost-wood 0)
	(set-goal escrow-cost-food 0)
	(set-goal escrow-cost-gold 0)
	(set-goal escrow-cost-stone 0)
	(up-reset-cost-data escrow-cost-food)
	(set-escrow-percentage wood 0)
	(set-escrow-percentage food 0)
	(set-escrow-percentage gold 0)
	(set-escrow-percentage stone 0)
	(up-release-escrow)
	(set-goal escrow-flag 0)
	(set-goal escrow-flag2 0)
	(set-goal escrow-flag3 0))
;================================================================
(defrule
	(true)
=>
	(up-get-fact commodity-buying-price wood temporary-goal)
	(up-get-fact commodity-buying-price food temporary-goal2)
	(up-get-fact commodity-buying-price gold temporary-goal3)
	(up-get-fact commodity-buying-price stone temporary-goal4)
	(up-get-fact commodity-selling-price wood temporary-goal5)
	(up-get-fact commodity-selling-price food temporary-goal6)
	(up-get-fact commodity-selling-price gold temporary-goal7)
	(up-get-fact commodity-selling-price stone temporary-goal8)
	(set-goal temporary-goal11 0)
	(set-goal temporary-goal12 0)
	(set-goal temporary-goal13 0)
	(set-goal temporary-goal14 0)
	(set-goal temporary-goal15 0)
	(set-goal temporary-goal16 0))
;================================================================
(defrule
	(true)
=>
	(up-modify-goal temporary-goal18 g:= max-farms)
	(up-modify-goal temporary-goal g:= temporary-goal18)
	(up-modify-goal temporary-goal c:%* 10)
	(up-modify-goal temporary-goal c:max 0)
	(up-modify-goal temporary-goal c:min 6)
	(up-modify-goal temporary-goal18 c:- temporary-goal))
;================================================================
; Stone excess
;================================================================
(defrule
	(building-type-count-total castle >= 3)
(or	(up-compare-flag power-unit-flag != f-unique)
	(building-type-count-total castle >= 5))
	(building-type-count-total town-center >= 3)
	(strategic-number sn-military-superiority <= -2)
	(population g:< max-civ-pop)
	(military-population < 22)
	(goal under-attack yes)
	(gold-amount < 100)
	(commodity-selling-price stone >= 250)
	(can-sell-commodity stone)
=>
	(up-modify-goal temporary-goal16 c:max 100))
;================================================================
(defrule
	(up-compare-goal excess-stone >= 2600)
(or	(up-compare-flag power-unit-flag != f-unique)
	(up-compare-goal excess-stone >= 3900))
	(gold-amount < 1000)
	(commodity-selling-price stone >= 200)
	(can-sell-commodity stone)
=>
	(up-modify-goal temporary-goal16 c:max 100))
;================================================================
(defrule
	(building-type-count feitoria >= 1)
	(up-compare-goal excess-stone >= 225)
	(building-type-count-total castle >= 3)
(or	(up-compare-flag power-unit-flag != f-unique)
(or	(building-type-count-total castle >= 7)
	(up-compare-goal excess-stone >= 750)))
	(up-compare-goal excess-gold < 225)
(or	(strategic-number sn-military-superiority <= -2)
(or	(goal under-attack yes)
	(and	(population g:< max-civ-pop)
		(up-compare-goal custom-civ-pop-total g:< desired-civ-pop))))	
	(commodity-selling-price stone >= 150)
	(can-sell-commodity stone)
=>
	(up-modify-goal temporary-goal16 c:max 100))
;================================================================
