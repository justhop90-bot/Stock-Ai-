	(up-modify-goal temporary-goal9 g:= temporary-goal2)
	(up-modify-goal temporary-goal9 c:+ imperial-gold)
(or	(up-compare-goal excess-gold g:>= temporary-goal9)
(or	(unit-type-count villager-food <= 0)
(or	(up-compare-goal relic-count >= 3)
	(commodity-buying-price food < 100))))
	(can-buy-commodity food)
=>
	(up-modify-goal temporary-goal12 c:max 100))
