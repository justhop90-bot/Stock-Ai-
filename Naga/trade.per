	(goal military-choice monk-treb)
	(research-available imperial-age)
	(building-type-count-total castle >= 1)
	(up-compare-goal excess-stone >= 100)
	(commodity-selling-price stone >= 75)
	(up-compare-goal excess-gold < imperial-gold)
	(can-sell-commodity stone)
=>
	(up-modify-goal temporary-goal16 c:max 100))
