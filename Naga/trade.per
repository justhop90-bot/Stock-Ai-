	(up-compare-goal dead-villagers <= 1)
(or	(up-compare-goal relic-count >= 4)
	(commodity-buying-price food < 150))
	(commodity-buying-price food < 200)
	(can-buy-commodity food)
=>
	(up-modify-goal temporary-goal12 c:max 100))
