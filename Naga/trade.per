	(up-jump-rule 1))
(defrule
	(up-compare-flag power-unit-flag == f-unique)
(nor	(civ-selected gothic)
(or	(civ-selected bulgarians)
(or	(civ-selected hun)
	(civ-selected sicilians))))
	(goal under-attack no)
	(goal escrowing no)
	(building-type-count-total castle < 4)
(not	(up-pending-placement c: castle))
	(up-compare-goal total-stone-amount < castle-stone)
(or	(building-type-count-total castle < 3)
