(defrule
(or	(goal plan-completed yes); 180
(or	(up-compare-flag power-unit-flag == f-unique)
	(unit-type-count villager-stone <= 0))); (strategic-number sn-military-superiority >= 2); 1
;	(goal under-attack no)
