;=============================================================
(defrule
	(goal strategy castledrop)
	(building-type-count-total castle <= 0)
	(building-type-count-total town-center >= 1)
	(up-compare-goal total-stone-amount < castle-tc-stone)
	(up-compare-goal map-type < type-islands)
	(goal super-pocket no)
(or	(up-compare-goal target-distance < 50)
	(and	(goal player-position flank)
		(and	(wall-completed-percentage 2 < 100)
			(wall-completed-percentage 1 < 100))))
=>
	(up-jump-rule 6))
(defrule
	(up-compare-const wr-game == 1)
(or	(building-type-count-total wonder >= 1)
	(up-pending-placement c: wonder))
=>
	(up-jump-rule 1))
(defrule
	(up-compare-flag escrow-flag2 == 524288)
(not	(up-pending-placement c: town-center))
	(building-type-count-total town-center <= 0)
	(up-compare-goal map-type < type-islands)
	(up-compare-goal migration-state != 1)
	(player-in-game any-ally)
	(players-military-population any-ally g:>= twenty-pop)
	(can-build-with-escrow town-center)
=>
;	(chat-to-player my-player-number "TC.6")
	(set-strategic-number sn-placement-to-center 1);test
	(set-strategic-number sn-allow-adjacent-dropsites 1)
	(set-strategic-number sn-dropsite-separation-distance min-dropsite-separation-distance)
; init	(up-assign-builders c: town-center-foundation c: 20)
	(set-strategic-number sn-town-center-placement 0);	(set-strategic-number sn-town-center-placement lumber-camp)
	(set-strategic-number sn-placement-zone-size 20); 25
	(up-set-placement-data this-any-ally -1 c: -25)
	(up-build place-control 0 c: town-center)
	(set-goal relocating yes)
	(up-jump-rule 4)); end jump
(defrule
	(up-compare-flag escrow-flag2 == 524288)
(not	(up-pending-placement c: town-center))
	(goal migration-state 1)
	(can-build-with-escrow town-center)
=>
	(up-full-reset-search)
	(up-filter-exclude -1 actionid-attack orderid-explore -1)
	(up-find-local c: villager-class g: villager-count)
	(up-modify-goal temporary-goal s:= sn-focus-player-number)
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-find-remote c: town-center c: 16)
	(up-filter-status c: status-pending c: list-active)
	(up-find-status-remote c: town-center-foundation c: 16)
	(up-modify-sn sn-focus-player-number g:= temporary-goal)
	(up-remove-objects search-remote object-data-map-zone-id g:!= migration-zone)
	(up-remove-objects search-local object-data-map-zone-id g:== starting-zone))
(defrule
	(up-compare-flag escrow-flag2 == 524288)
	(up-compare-flag misc-flag != f-place-point-active)
(not	(up-pending-placement c: town-center))
	(goal migration-state 1)
	(can-build-with-escrow town-center)
	(up-set-target-object search-local c: 0)
(not	(up-set-target-object search-remote c: 0))
=>
	(up-get-point position-object temp-x)
;	(chat-to-player my-player-number "TC.4")
	(up-copy-point building-x temp-x)
	(up-set-target-point building-x)
;	(up-send-flare building-x)
	(set-strategic-number sn-placement-zone-size 20)
	(set-strategic-number sn-allow-adjacent-dropsites 1)
	(set-strategic-number sn-town-center-placement lumber-camp)
	(up-modify-goal temporary-goal g:= escrow-state)
	(set-goal escrow-state with-escrow)
	(up-build place-point escrow-state c: town-center)
	(up-modify-flag misc-flag c:+ f-place-point-active)
	(up-modify-goal escrow-state g:= temporary-goal)
	(up-jump-rule 2))
(defrule
	(up-compare-flag escrow-flag2 == 524288)
(not	(up-pending-placement c: town-center))
	(up-compare-goal migration-state != 1)
	(goal under-attack no)
	(up-compare-goal dead-villagers <= 1)
	(can-afford-building town-center-foundation)
	(can-build town-center)
=>
;	(chat-to-player my-player-number "TC.7")
	(set-strategic-number sn-dropsite-separation-distance 4); 2
	(set-strategic-number sn-allow-adjacent-dropsites 1)
	(set-goal temporary-goal town-center-foundation)
	(up-modify-goal temporary-goal2 s:= sn-town-center-placement)
	(up-get-rule-id temporary-goal16)
	(up-modify-goal temporary-goal16 c:+ 1)
	(up-jump-direct g: camp-function-id))
(defrule
	(up-compare-flag escrow-flag2 == 524288)
(not	(up-pending-placement c: town-center))
	(up-compare-goal migration-state != 1)
(or	(up-compare-goal under-attack != no)
	(up-compare-goal dead-villagers >= 2))
	(can-afford-building town-center-foundation)
	(can-build town-center)
=>
;	(chat-to-player my-player-number "TC.5")
	(up-modify-goal temporary-goal s:= sn-safe-town-size)
	(up-modify-goal temporary-goal c:+ 2)
	(up-modify-goal temporary-goal g:min target-distance)
	(up-modify-goal temporary-goal c:max 24); 20
	(up-modify-goal temporary-goal c:min 42); 40
	(up-modify-sn sn-maximum-town-size g:max temporary-goal); c: 24
	(up-modify-sn sn-lumber-camp-max-distance g:max temporary-goal)
	(up-modify-sn sn-mining-camp-max-distance g:max temporary-goal)
	(set-strategic-number sn-dropsite-separation-distance min-dropsite-separation-distance)
	(set-strategic-number sn-allow-adjacent-dropsites 1)
	(build town-center)); end jumps
;=============================================================
(defrule
	(up-compare-flag escrow-flag2 == 1048576)
(not	(up-pending-placement c: market))
	(can-build-with-escrow market)
=>
	(chat-local-to-self "Building market with escrow.")
	(set-strategic-number sn-placement-to-center 1)
	(set-goal temporary-goal 8); 6
	(up-modify-goal temporary-goal s:+ sn-current-age)
	(up-modify-goal temporary-goal c:max 8); 6
	(up-modify-goal temporary-goal c:min 14); 12
	(up-modify-goal temporary-goal c:* -1)
	(up-set-placement-data my-player-number -1 g: temporary-goal); -9
	(set-strategic-number sn-placement-zone-size 12); 10
	(up-build place-control 0 c: market)
	(set-goal temporary-goal 6)); 5
;=============================================================
(defrule
	(up-compare-flag escrow-flag2 == 2097152)
	(up-compare-flag misc-flag != f-place-point-active)
(not	(up-pending-placement c: siege-workshop))
(or	(and	(up-enemy-units-in-town < 5)
		(strategic-number sn-military-superiority >= -2))
	(goal attacking yes))
	(goal under-attack no)
(or	(up-compare-goal dead-villagers <= 1)
(or	(population g:>= max-civ-pop)
	(up-compare-goal custom-civ-pop g:>= desired-civ-pop)))
	(can-build-with-escrow siege-workshop)
=>
	(chat-local-to-self "Building siege-workshop with escrow.0")
	(set-strategic-number sn-placement-zone-size 8)
;	(up-set-placement-data my-player-number -1 c: 9)
;	(up-build place-control 0 c: siege-workshop)
	(up-copy-point building-x self-x)
	(up-lerp-tiles building-x target-x c: 9)
	(up-set-target-point building-x)
	(up-build place-point 0 c: siege-workshop)
	(up-modify-flag misc-flag c:+ f-place-point-active)
	(up-jump-rule 1))
(defrule
	(up-compare-flag escrow-flag2 == 2097152)
	(up-compare-flag misc-flag != f-place-point-active)
(not	(up-pending-placement c: siege-workshop))
	(can-build-with-escrow siege-workshop)
=>
	(chat-local-to-self "Building siege-workshop with escrow.1")
	(set-strategic-number sn-placement-zone-size 8)
;	(up-set-placement-data my-player-number -1 c: -7)
;	(up-build place-control 0 c: siege-workshop)
	(up-copy-point building-x self-x)
	(up-lerp-tiles building-x target-x c: -6)
	(up-set-target-point building-x)
	(up-build place-point 0 c: siege-workshop)
	(up-modify-flag misc-flag c:+ f-place-point-active)); end jump
;=============================================================
(defrule
	(up-compare-flag escrow-flag2 == 4194304)
	(can-build-with-escrow castle)
=>
	(set-goal temporary-goal castle)
	(up-get-rule-id temporary-goal16)
	(up-modify-goal temporary-goal16 c:+ 1)
	(up-jump-direct g: fortified-train-function-id))
;=============================================================
(defrule
	(up-compare-flag escrow-flag2 == 16777216)
(not	(up-pending-placement c: lumber-camp))
	(up-compare-goal migration-state != 1)
	(can-build-with-escrow lumber-camp)
=>
	(chat-local-to-self "Building lumber-camp with escrow.1")
