(defrule
(or	(not	(up-set-target-by-id g: current-boar))
(or	(and	(up-set-target-by-id g: current-boar)
		(up-object-data object-data-status != status-ready))
(or	(up-compare-goal temporary-goal15 >= 5)
(or	(cc-players-unit-type-count 0 dangerous-animal-class <= 0)
	(building-type-count town-center <= 0)))))
=>
	(up-jump-rule 3))
(defrule
	(true)
=>
	(up-full-reset-search)
	(up-filter-garrison c: 1 c: -1)
	(up-filter-exclude -1 actionid-attack -1 -1)
	(up-find-local c: town-center c: 1))
(defrule
	(up-set-target-object search-local c: 0)
=>
	(up-get-point position-object temp-x)
	(up-set-target-point temp-x)
	(up-reset-filters)
	(up-filter-distance c: -1 c: 4)
	(up-find-remote c: boar-class c: 2)
	(up-clean-search search-remote object-data-hitpoints search-order-asc))
(defrule
	(up-set-target-object search-local c: 0)
	(up-set-target-object search-remote c: 0)
=>
	(up-remove-objects search-remote object-data-index >= 1)
	(up-target-objects 0 action-default -1 stance-aggressive)); end jump


#load-if-not-defined DEATH-MATCH
(defrule
(or	(up-compare-goal deer-luring >= 2)
(or	(up-compare-const diff-fp != 1)
(or	(cc-players-unit-type-count 0 deer-class <= 0)
(or	(dropsite-min-distance deer-hunting >= 35);
(or	(building-type-count town-center <= 0)
(or	(goal under-attack yes)
(or	(not	(up-set-target-by-id g: scouting-unit))
(or	(up-timer-status livestock-scouting == timer-running)
	(and	(strategic-number sn-food-gatherer-percentage <= 0)
		(unit-type-count villager-food <= 0))))))))))
=>
	(up-jump-rule 28))
(defrule
	(map-type hamburger)
(nor	(up-compare-flag starting-dropsite-flag != f-lumber)
(or	(game-time >= 600)
	(and	(building-type-count lumber-camp >= 1)
		(and	(dropsite-min-distance wood <= 20)
			(dropsite-min-distance wood s:<= sn-maximum-wood-drop-distance)))))
=>
	(up-jump-rule 27))
(defrule
	(false)
	(up-compare-goal gl-game-time g:< c-scout-time)
	(game-time s:>= sn-home-exploration-time)
	(up-compare-goal scout-count >= 1)
=>
	(set-goal current-deer -1)
	(set-goal deer-distance -1)
	(disable-timer deer-reset-timer)
	(set-goal deer-luring 0)
	(up-jump-rule 26))
(defrule
	(up-set-target-by-id g: scouting-unit)
	(up-object-data object-data-class == controlled-animal-class)
=>
	(set-goal current-deer -1)
	(set-goal deer-distance -1)
	(disable-timer deer-reset-timer)
	(set-goal deer-luring 0)
	(up-jump-rule 25))
(defrule
	(game-time < home-exploration-time); 390 ; 420|480
	(game-time s:< sn-home-exploration-time)
	(up-compare-goal total-boars < expected-boars)
	(cc-players-unit-type-count 0 boar-class >= 1)
=>
	(set-goal current-deer -1)
	(set-goal deer-distance -1)
	(disable-timer deer-reset-timer)
	(set-goal deer-luring 0)
	(up-jump-rule 24))
(defrule; test
	(game-time s:< sn-home-exploration-time)
(or	(or	(not	(resource-found wood))
		(and	(cc-players-unit-type-count 0 gold-mine > 0)
			(not	(resource-found gold))))
	(and	(up-compare-goal total-livestock-food < expected-livestock-food); 8
		(cc-players-unit-type-count 0 livestock-class >= 1)))
=>
	(set-goal current-deer -1)
	(set-goal deer-distance -1)
	(disable-timer deer-reset-timer)
	(set-goal deer-luring 0)
	(up-jump-rule 23))
(defrule
(or	(unit-type-count villager <= 0)
(or	(and	(or	(up-compare-const dm-game == 1)
				(strategic-number sn-current-age >= cimperial))
		(players-building-count any-enemy <= 0))
	(and	(up-compare-goal strategy-type == dark-war)
		(and	(game-time >= 330)
			(and	(players-building-count any-enemy <= 0)
				(goal player-position flank))))))
=>
	(set-goal current-deer -1)
	(set-goal deer-distance -1)
	(disable-timer deer-reset-timer)
	(set-goal deer-luring 0)
	(up-jump-rule 22))
(defrule
	(and	(game-time >= 270)
		(and	(up-compare-goal map-type >= type-water)
			(and	(building-type-count-total dock <= 0)
				(and	(up-gaia-type-count c: ocean-fish-class <= 0)
					(up-gaia-type-count c: shore-fish-class <= 0)))))
=>
	(set-goal current-deer -1)
	(set-goal deer-distance -1)
	(disable-timer deer-reset-timer)
	(set-goal deer-luring 0)
	(up-jump-rule 21))
(defrule
	(up-compare-goal gl-game-time s:>= sn-home-exploration-time);	(game-time >= 540); finding the enemy etc
	(players-building-count any-enemy <= 0)
(or	(strategic-number sn-current-age >= dfeudal);
(or	(and	(up-compare-flag micro-flag == f-drush-micro)
		(goal drush-target 0))
	(up-compare-goal strategy-type <= dark-war)))
(or	(strategic-number sn-current-age >= fcastlea)
	(up-compare-goal wall-strength < 900))
(or	(up-compare-goal deer-luring != 1)
(or	(up-compare-goal dead-villagers >= 1)
(or	(up-compare-goal under-attack == yes)
	(up-compare-goal wall-strength < 125))))
(or	(game-time >= 660)
(or	(up-timer-status scout-timer != timer-disabled)
	(and	(goal player-position flank)
		(up-compare-goal strategy-type < castle-war))))
=>
	(set-goal current-deer -1)
	(set-goal deer-distance -1)
	(disable-timer deer-reset-timer)
	(set-goal deer-luring 0)
	(up-jump-rule 20))
(defrule
	(goal current-deer -1)
	(dropsite-min-distance deer-hunting <= 34)
=>
	(up-set-target-point self-x); intended
	(up-full-reset-search)
	(up-filter-distance c: -1 c: 34); s: hunt-max
	(up-filter-status c: status-ready c: list-active)
	(up-find-resource c: deer-class c: 40)
	(up-remove-objects search-remote object-data-speed <= 50)
	(up-remove-objects search-remote object-data-carry <= 80))
(defrule
	(dropsite-min-distance deer-hunting <= 34)
	(player-in-game any-computer-ally)
(or	(up-allied-goal any-computer-ally identity == Naga)
	(up-allied-goal any-computer-ally identity == Promi))
	(up-allied-goal any-computer-ally deer-luring == 1)
	(up-allied-goal any-computer-ally current-deer != -1)
=>
	(up-get-fact allied-goal current-deer temporary-goal)
	(up-remove-objects search-remote object-data-id g:== temporary-goal))
(defrule
	(dropsite-min-distance deer-hunting <= 34)
	(player-in-game any-computer-ally)
(or	(up-allied-goal any-computer-ally identity == Naga)
	(up-allied-goal any-computer-ally identity == Promi))
	(up-allied-goal any-computer-ally deer-luring == 1)
	(up-allied-goal any-computer-ally current-deer != -1)
	(up-compare-goal current-deer != -1);
	(up-compare-goal current-deer g:== temporary-goal)
=>
;	(chat-to-player my-player-number "Ally focusing on the same deer.")
	(set-goal current-deer -1)
	(set-goal deer-distance -1)
	(disable-timer deer-reset-timer)
	(set-goal deer-luring 0))
(defrule
	(dropsite-min-distance deer-hunting <= 34)
	(up-set-target-by-id g: current-deer)
(or	(up-object-data object-data-speed <= 50)
	(up-object-data object-data-carry <= 80))
=>
;	(chat-to-player my-player-number "DL: Skipping undesirable object.")
	(set-goal current-deer -1)
	(set-goal deer-distance -1)
	(disable-timer deer-reset-timer)
	(set-goal deer-luring 0))

(defrule
	(up-set-target-object search-remote c: 0)
	(goal current-deer -1)
	(dropsite-min-distance deer-hunting <= 34)
=>
;	(chat-local-to-self "Found suitable deer.")
	(up-clean-search search-remote object-data-precise-distance search-order-asc) 
	(up-set-target-object search-remote c: 0)
	(up-get-object-data object-data-id current-deer))
(defrule
	(up-set-target-by-id g: current-deer)
=>
	(up-copy-point temp4-x self-x)
	(up-modify-goal temp4-x c:* 100)
	(up-modify-goal temp4-y c:* 100)
	(up-get-object-data object-data-precise-x temp5-x)
	(up-get-object-data object-data-precise-y temp5-y)
	(up-get-point-distance temp4-x temp5-x deer-distance)
	(up-modify-goal temp4-x c:- 50)
	(up-modify-goal temp4-y c:+ 50)
	(set-goal deer-luring 1))
(defrule
	(goal deer-luring 1);	(up-compare-goal deer-luring != 3)
(or	(and	(not	(up-set-target-object search-remote c: 0))
		(goal current-deer -1))
	(and	(up-compare-goal wall-strength >= 1)
		(up-compare-goal deer-distance >= 2000))); live-deer
=>
;	(chat-local-to-self "Deer luring disabled.")
	(set-goal deer-luring 2)
	(enable-timer scout-timer 1)
	(up-jump-rule 11))
(defrule
	(up-compare-goal deer-luring != 2);	(goal deer-luring 1)
(or	(game-time >= 1200); 1800; 1500
(or	(and	(up-modify-goal temporary-goal s:= sn-maximum-hunt-drop-distance)
		(and	(up-modify-goal temporary-goal c:* 100)
			(and	(up-compare-goal deer-distance g:> temporary-goal)
				(game-time >= 1080)))); 1500; 1200
	(building-type-count-total mill >= 2)))
(or	(up-compare-goal gl-game-time s:>= sn-home-exploration-time)
	(up-timer-status scout-timer != timer-disabled))
=>
;	(chat-local-to-self "Deer luring disabled.2")
	(set-goal deer-luring 2)
	(enable-timer scout-timer 1)
	(up-jump-rule 10))
(defrule
	(goal deer-luring 1);	(up-compare-goal deer-luring != 3)
(or	(dropsite-min-distance deer-hunting > 34); live-deer
	(up-compare-goal deer-distance > 3400))
=>
;	(chat-local-to-self "Deer luring disabled.3")
	(set-goal deer-luring 2)
	(enable-timer scout-timer 1)
	(up-jump-rule 9))
(defrule
(or	(not	(up-set-target-by-id g: current-deer))
	(and	(up-set-target-by-id g: current-deer)
		(up-object-data object-data-status != status-ready)))
	(up-compare-goal current-deer != -1)
=>
;	(chat-to-player my-player-number "No valid deer in range.")
	(set-goal current-deer -1)
	(set-goal deer-distance -1)
	(set-goal deer-luring 0)
	(disable-timer deer-reset-timer)); end mini-jump
(defrule
	(goal deer-luring 1)
	(up-set-target-by-id g: current-deer)
=>
	(up-modify-goal temporary-goal3 s:= sn-focus-player-number)
	(set-strategic-number sn-focus-player-number my-player-number)
	(set-goal temporary-goal4 0)
	(up-full-reset-search)
	(up-set-target-by-id g: current-deer)
	(up-get-object-data object-data-precise-x temp5-x)
	(up-get-object-data object-data-precise-y temp5-y)
	(up-bound-precise-point temp5-x 1 c: 10)
	(up-set-precise-target-point temp5-x)
	(up-find-remote c: town-center c: 5)
	(up-find-remote c: mule-cart c: 5)
	(up-find-remote c: mill c: 5)
	(up-find-remote c: settlement c: 5)
	(up-remove-objects search-remote object-data-to-precise >= 3400)
	(up-remove-objects search-remote object-data-under-attack == 1)
	(up-clean-search search-remote object-data-to-precise search-order-asc)
	(up-modify-sn sn-focus-player-number g:= temporary-goal3))
(defrule ; end neg jumps
	(goal deer-luring 1)
	(up-set-target-by-id g: current-deer)
(not	(up-set-target-object search-local c: 0))
	(up-set-target-object search-remote g: temporary-goal4)
=>
	(up-get-point position-object temp6-x)
	(up-set-target-point temp6-x)
	(up-filter-distance c: -1 c: 7)
	(up-filter-exclude -1 actionid-attack orderid-build -1)
	(up-find-local c: villager-class g: villager-count)
	(up-remove-objects search-local object-data-gather-type != food)
	(up-remove-objects search-local object-data-tasks-count >= 1)
	(up-remove-objects search-local object-data-action == actionid-enter)
	(up-remove-objects search-local object-data-order == orderid-enter)
	(up-remove-objects search-local object-data-action == actionid-move)
	(up-remove-objects search-local object-data-order == orderid-move))
(defrule
	(goal deer-luring 1)
	(up-set-target-by-id g: current-deer)
	(up-set-target-object search-remote g: temporary-goal4)
(not	(up-set-target-object search-local c: 0))
=>
	(up-modify-goal temporary-goal4 c:+ 1)
	(up-reset-search 1 1 0 0)
	(up-jump-rule -2))
(defrule
	(goal deer-luring 1)
	(up-set-target-by-id g: current-deer)
	(up-set-target-object search-local c: 0)
	(up-set-target-object search-remote g: temporary-goal4)
=>
	(up-get-point position-object temp4-x)
	(up-modify-goal temp4-x c:* 100)
	(up-modify-goal temp4-y c:* 100)
	(up-modify-goal temp4-x c:- 50)
	(up-modify-goal temp4-y c:+ 50))
(defrule
	(goal deer-luring 1)
	(up-set-target-by-id g: current-deer)
=>
	(up-full-reset-search)
	(up-add-object-by-id search-local g: scouting-unit)
	(up-remove-objects search-local object-data-attack-stance == stance-no-attack)
	(up-remove-objects search-local object-data-action == actionid-attack)
	(up-remove-objects search-local object-data-action == actionid-enter)
	(up-remove-objects search-local object-data-under-attack == 1)
	(up-remove-objects search-local object-data-group-flag >= 0)
	(up-set-target-by-id g: current-deer)
	(up-get-point-distance temp4-x temp5-x deer-distance)
	(up-lerp-tiles temp5-x temp4-x c: -75)
	(up-set-target-object search-local c: 0)
	(up-get-object-data object-data-precise-x temporary-goal5)
	(up-get-object-data object-data-precise-y temporary-goal6))
(defrule
	(goal deer-luring 1)
	(up-set-target-by-id g: current-deer)
	(up-set-target-object search-local c: 0)
(or	(up-compare-goal temp5-x g:!= temporary-goal5)
	(up-compare-goal temp5-y g:!= temporary-goal6))
=>
;	(chat-local-to-self "Moving to deer.")
	(up-bound-precise-point temp5-x 1 c: 35); 10
	(up-set-precise-target-point temp5-x)
	(up-clean-search search-local object-data-to-precise search-order-asc)
	(up-remove-objects search-local object-data-index >= 1)
	(set-strategic-number sn-target-point-adjustment adjust-precise)
	(up-target-point 0 action-move -1 stance-defensive)
	(set-strategic-number sn-target-point-adjustment adjust-middle))
(defrule
	(goal deer-luring 1)
	(up-set-target-by-id g: current-deer)
	(up-object-data object-data-tasks-count < 2)
	(up-timer-status deer-reset-timer != timer-running)
	(up-compare-goal deer-distance <= 375)
=>
	(up-bound-precise-point temp4-x 1 c: 0)
	(up-set-precise-target-point temp4-x)
	(up-full-reset-search)
	(up-filter-exclude -1 actionid-attack orderid-build -1)
	(up-find-local c: villager-class g: villager-count)
	(up-remove-objects search-local object-data-gather-type != food)
	(up-remove-objects search-local object-data-tasks-count >= 1)
	(up-remove-objects search-local object-data-action == actionid-enter)
	(up-remove-objects search-local object-data-order == orderid-enter)
	(up-remove-objects search-local object-data-action == actionid-move)
	(up-remove-objects search-local object-data-order == orderid-move)
	(up-remove-objects search-local object-data-to-precise > 1500)
	(set-goal temporary-goal9 584265))
(defrule
	(goal temporary-goal9 584265)
	(up-set-target-object search-local c: 0)
	(up-set-target-by-id g: current-deer)
=>
;	(chat-local-to-self "Target deer.")
	(up-modify-sn sn-maximum-hunt-drop-distance c:max 8)
	(set-goal temporary-goal 2)
	(up-get-object-data object-data-tasks-count temporary-goal2)
	(up-modify-goal temporary-goal g:- temporary-goal2)
	(up-modify-goal temporary-goal c:max 0)
	(up-clean-search search-local object-data-to-precise search-order-asc)
	(up-remove-objects search-local object-data-index g:>= temporary-goal)
	(up-target-objects 1 action-default -1 -1)
;	(set-goal current-deer -1)
	(set-goal deer-distance -1)
	(enable-timer deer-reset-timer 9)); end jump
(defrule
	(up-compare-goal deer-luring >= 2)
(or	(up-compare-goal current-deer != -1)
(or	(up-compare-goal deer-distance != -1)
	(up-timer-status deer-reset-timer != timer-disabled)))
=>
	(set-goal current-deer -1)
	(set-goal deer-distance -1)
	(disable-timer deer-reset-timer)); end jump
#end-if

(defrule
(or	(up-compare-const diff-fp != 1)
(or	(strategic-number sn-current-age >= fcastlea)
(or	(up-timer-status three-seconds != timer-triggered)
(or	(game-time >= 1800)
(or	(up-compare-goal custom-civ-pop g:>= desired-civ-pop)
(or	(population g:>= max-civ-pop)
(or	(and	(or	(and	(up-set-target-by-id g: current-boar)
					(and	(up-object-data object-data-status == status-ready)
						(up-compare-goal current-boar g:!= last-boar)))
				(or	(cc-players-unit-type-count 0 boar-class <= 0)
					(up-compare-goal villager-count g:< boar-villagers)))
		(or	(and	(up-set-target-by-id g: current-deer)
				(up-object-data object-data-status == status-ready))
			(or	(cc-players-unit-type-count 0 deer-class <= 0)
				(up-compare-goal deer-luring >= 2))))
	(building-type-count-total town-center <= 0))))))))
=>
	(up-jump-rule 4))
(defrule
	(true)
=>
	(set-goal temporary-goal 0)
	(up-modify-goal temporary-goal2 g:= map-size)
	(up-modify-goal temporary-goal2 g:* map-size)
	(up-modify-goal temporary-goal2 c:%* 70)
	(up-set-target-point self-x))
(defrule ; end neg jump
	(up-compare-goal villager-count g:>= boar-villagers)
(not	(up-set-target-by-id g: current-boar))
	(up-set-target-by-id g: temporary-goal)
	(up-object-data object-data-class == boar-class)
	(up-object-data object-data-status == status-ready)
	(up-object-data object-data-hitpoints < 100)
	(up-object-data object-data-distance <= 34)
	(up-object-data object-data-carry >= 32)
	(up-get-object-data object-data-point-x temp-x)
	(up-get-object-data object-data-point-y temp-y)
	(up-point-explored temp-x != explored-no)
=>
	(up-modify-goal current-boar g:= temporary-goal)
;	(up-chat-data-to-self "Found boar through loop: %d" g: current-boar)
	(up-modify-goal found-boar c:max 1)
	(up-get-point-distance temp-x self-x boar-distance)
	(up-jump-rule 2))
(defrule
	(up-compare-goal deer-luring <= 1)
(not	(up-set-target-by-id g: current-deer))
	(up-set-target-by-id g: temporary-goal)
	(up-object-data object-data-class == deer-class)
	(up-object-data object-data-status == status-ready)
	(up-object-data object-data-hitpoints < 100)
	(up-object-data object-data-distance <= 34)
	(up-object-data object-data-carry >= 81)
	(up-object-data object-data-speed >= 51)
	(up-get-object-data object-data-point-x temp-x)
	(up-get-object-data object-data-point-y temp-y)
	(up-point-explored temp-x != explored-no)
=>
	(up-modify-goal current-deer g:= temporary-goal)
;	(up-chat-data-to-self "Found pushable deer through loop: %d" g: current-deer)
	(up-get-point-distance temp-x self-x deer-distance)
	(up-modify-goal deer-distance c:* 100)
	(up-jump-rule 1))
(defrule
	(up-compare-goal temporary-goal g:< temporary-goal2)
=>
	(up-modify-goal temporary-goal c:+ 1)
	(up-jump-rule -3)); end jump

(defrule
	(true)
=>
	(up-modify-sn sn-focus-player-number g:= temporary-goal16))


(defrule ; debug rule
(or	(strategic-number sn-focus-player-number >= 9)
(or	(strategic-number sn-focus-player-number <= 0)
	(stance-toward focus-player ally)))
	(strategic-number sn-target-player-number >= 1)
	(strategic-number sn-target-player-number <= 8)
(not	(stance-toward target-player ally))
	(player-in-game target-player)
=>
	(chat-to-player my-player-number "Debugging focus player. -6")
	(up-modify-goal temporary-goal s:= sn-target-player-number); to prevent further bugs
	(up-modify-sn sn-focus-player-number s:= sn-target-player-number)); should be an enemy