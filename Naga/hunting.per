(defrule
	(true)
=>
	(up-get-fact dropsite-min-distance live-boar temporary-goal15)
	(up-modify-goal temporary-goal16 s:= sn-focus-player-number)
	(set-strategic-number sn-focus-player-number 0))
(defrule
	(up-set-target-by-id g: current-boar)
	(up-compare-goal temporary-goal15 <= -1)
=>
	(up-modify-goal temporary-goal15 g:= boar-distance))


#load-if-not-defined DEATH-MATCH
(defrule
(or	(game-time >= 480)
(or	(strategic-number sn-home-exploration-time >= 480)
(or	(up-compare-const dm-game == 1)
(or	(and	(up-compare-const ew-game == 1)
		(players-building-count any-enemy <= 0))
	(and	(up-compare-flag micro-flag == f-drush-micro)
		(goal drush-target 0))))))
=>
	(up-jump-rule 2))
(defrule
	(up-compare-goal gl-game-time s:>= sn-home-exploration-time)
	(players-building-count every-enemy >= 1)
(or	(and	(up-compare-goal total-boars < expected-boars)
		(and	(cc-players-unit-type-count 0 boar-class >= 1)
			(or	(up-compare-goal temporary-goal15 >= 35)
				(up-compare-goal temporary-goal15 <= -1))))
	(and	(up-compare-goal total-livestock-food < expected-livestock-food)
		(cc-players-unit-type-count 0 livestock-class >= 1)))
	(up-compare-goal deer-luring != 1)
(or	(strategic-number sn-home-exploration-time < 300)
	(dropsite-min-distance deer-hunting s:> sn-maximum-hunt-drop-distance)); 30
	(players-current-age every-enemy <= dark-age)
=>
	(up-modify-sn sn-home-exploration-time c:+ 15)
	(up-modify-sn sn-home-exploration-time c:min 480))
(defrule
	(up-compare-goal gl-game-time s:>= sn-home-exploration-time)
	(up-compare-goal total-boars < expected-boars); new
	(cc-players-unit-type-count 0 boar-class >= 1)
(or	(up-compare-goal temporary-goal15 >= 35)
	(up-compare-goal temporary-goal15 <= -1))
	(dropsite-min-distance deer-hunting > 15); 30
(or	(unit-type-count-total villager >= 10)
	(players-building-count every-enemy >= 1))
=>
	(up-modify-sn sn-home-exploration-time c:+ 30); 40
	(up-modify-sn sn-home-exploration-time c:min 480)
	(disable-self)); end jump
(defrule
	(game-time s:< sn-home-exploration-time)
	(game-time >= home-exploration-time)
;(or	(up-compare-goal temporary-goal15 <= 34)
;(or	(dropsite-min-distance deer-hunting <= 15); 30
;	(up-compare-goal total-boars >= expected-boars)))
	(dropsite-min-distance deer-hunting <= 34)
(or	(up-compare-goal forage-count >= 1)
	(cc-players-unit-type-count 0 forage-bush-class <= 0))
	(up-compare-goal total-boars >= expected-boars)
	(up-compare-goal total-livestock-food >= expected-livestock-food)
	(players-building-count any-enemy <= 0)
=>
	(up-modify-sn sn-home-exploration-time c:min home-exploration-time)
	(disable-self))
(defrule
(or	(up-compare-flag micro-flag == f-drush-micro)
	(goal strategy drush))
(or	(unit-type-count-total militiaman-line g:>= essential-soldiercount)
	(and	(building-type-count-total barracks >= 1)
		(and	(up-compare-goal total-boars >= expected-boars)
			(up-compare-goal total-livestock-food >= expected-livestock-food))))
	(players-building-count every-enemy <= 0)
	(game-time s:< sn-home-exploration-time)
	(up-timer-status scout-timer == timer-disabled)
	(goal drush-target 0)
=>
	(up-modify-sn sn-home-exploration-time g:min gl-game-time)
	(disable-self))
#end-if


(defrule
(or	(up-compare-const dm-game == 1)
(or	(up-compare-const infinite-resources == 1)
(or	(and	(strategic-number sn-current-age >= dfeudal)
		(unit-type-count villager g:>= boar-villagers))
(or	(cc-players-unit-type-count 0 boar-class <= 0)
(or	(building-type-count town-center <= 0)
	(game-time < 5))))))
=>
	(up-jump-rule 4))
(defrule
(or	(up-compare-goal food-villagers > min-food-villagers)
	(and	(up-compare-goal custom-civ-pop-total >= 11); -total
		(unit-type-count villager-food >= min-food-villagers)))
=>
	(up-modify-goal temporary-goal c:= min-food-villagers)
	(up-modify-goal temporary-goal c:+ 1)
	(up-modify-goal boar-villagers g:min temporary-goal))
(defrule
	(up-compare-goal current-livestock-food <= 100)
(or	(and	(up-compare-goal food-villagers >= min-food-villagers)
		(unit-type-count villager-food < min-food-villagers))
(or	(and	(up-compare-goal current-livestock-food <= 0)
		(nand	(dropsite-min-distance deer-hunting s:<= sn-maximum-hunt-drop-distance)
			(or	(strategic-number sn-enable-boar-hunting != 2)
				(unit-type-count villager-hunter >= 2))))
(or	(and	(unit-type-count-total villager >= 10)
		(or	(up-compare-goal temporary-goal15 g:<= loom-distance)
			(up-research-status c: ri-loom >= research-pending)))
(or	(unit-type-count-total villager >= 11)
	(up-compare-goal wood-villagers >= 4)))))
=>
	(up-modify-goal boar-villagers c:min 7)
	(up-modify-goal temporary-goal g:= current-livestock-food)
	(up-modify-goal temporary-goal c:z/ 100)
	(up-modify-goal boar-villagers g:+ temporary-goal)
	(up-modify-goal boar-villagers c:min 11))
(defrule
(or	(up-compare-const decay-bonus == yes)
(or	(and	(up-compare-goal feudal-villagers <= -1)
		(dropsite-min-distance hunting >= 7))
(or	(up-compare-goal strategy-type <= dark-war)
(or	(goal strategy sling)
(or	(goal strategy trush)
	(and	(unit-type-count-total villager >= 5)
		(and	(up-compare-goal map-type < type-islands)
			(and	(up-compare-goal wall-strength < 125)
				(and	(up-compare-goal target-distance <= 34)
					(players-building-count any-enemy >= 1))))))))))
=>
	(up-modify-goal boar-villagers c:min 5)); min-food-villagers
(defrule
	(game-time >= 50)
;(or	(dropsite-min-distance food >= 10)
;	(dropsite-min-distance food <= -1))
(or	(unit-type-count villager-food <= 0)
(or	(sheep-and-forage-too-far)
	(and	(dropsite-min-distance deer-hunting s:> sn-maximum-hunt-drop-distance)
		(up-compare-goal current-livestock-food <= 0))))
=>
	(up-modify-goal boar-villagers c:min 5)); 4; end jump



(defrule
	(strategic-number sn-enable-boar-hunting <= 0)
	(up-compare-goal villager-count g:>= boar-villagers);		(unit-type-count villager >= 8); -total
=>
	(set-strategic-number sn-enable-boar-hunting 1))
(defrule
	(strategic-number sn-enable-boar-hunting != 1)
	(up-compare-goal temporary-goal15 >= 35)
	(game-time > 120);	(dropsite-min-distance boar-hunting s:> sn-maximum-hunt-drop-distance)
	(dropsite-min-distance deer-hunting s:<= sn-maximum-hunt-drop-distance)
(or	(sheep-and-forage-too-far)
(or	(dropsite-min-distance food >= 10)
	(dropsite-min-distance food <= -1)))
	(up-compare-goal current-livestock-food <= 0); 1
	(dropsite-min-distance deer-hunting <= 12)
	(unit-type-count villager >= 6); 4
	(unit-type-count villager-food < 1)
=>
	(set-strategic-number sn-enable-boar-hunting 1)); boar and deer
(defrule
	(strategic-number sn-enable-boar-hunting != 1)
;(or	(unit-type-count villager >= 12)
;	(game-time > 240))
(or	(unit-type-count villager >= 18)
	(game-time > 420)); 390
(or	(up-compare-goal temporary-goal15 >= 35)
	(unit-type-count villager-food < 6)); test
=>
;	(set-strategic-number sn-minimum-boar-hunt-group-size 2)
;	(set-strategic-number sn-minimum-boar-lure-group-size 0)
;	(set-strategic-number sn-minimum-number-hunters 2)
	(set-strategic-number sn-enable-boar-hunting 1)
;	(chat-local-to-self "Disabling hunting-restrictions.")
)
(defrule
	(strategic-number sn-enable-boar-hunting != 1)
(or	(up-compare-goal deer-luring >= 1)
(or	(up-compare-goal total-food-amount >= 400)
(or	(unit-type-count villager >= 9)
	(game-time >= 240))))
(or	(up-compare-goal deer-luring >= 1)
	(cc-players-unit-type-count 0 boar-class <= 0))
=>
;	(set-strategic-number sn-minimum-boar-hunt-group-size 2)
;	(set-strategic-number sn-minimum-boar-lure-group-size 0)
;	(set-strategic-number sn-minimum-number-hunters 2)
	(set-strategic-number sn-enable-boar-hunting 1)
;	(chat-local-to-self "Disabling hunting-restrictions. 1")
)
(defrule
	(strategic-number sn-enable-boar-hunting != 1)
	(up-compare-goal temporary-goal15 >= 35)
	(building-type-count-total food-placement-camp >= 1)
(or	(and	(or	(dropsite-min-distance food <= -1)
			(dropsite-min-distance food s:> sn-maximum-food-drop-distance))
		(dropsite-min-distance deer-hunting <= 16))
(or	(up-compare-goal forage-count <= 0)
	(cc-players-unit-type-count 0 forage-bush-class <= 0)))
=>
;	(set-strategic-number sn-minimum-boar-hunt-group-size 2)
;	(set-strategic-number sn-minimum-boar-lure-group-size 0)
;	(set-strategic-number sn-minimum-number-hunters 2)
	(set-strategic-number sn-enable-boar-hunting 1)
;	(chat-local-to-self "Disabling hunting-restrictions. 2")
)
(defrule
	(strategic-number sn-minimum-number-hunters != 0)
(or	(dropsite-min-distance hunting <= -1)
(or	(dropsite-min-distance hunting >= 12)
(or	(goal under-attack yes)
(or	(unit-type-count 217 >= 1)
(or	(unit-type-count 227 >= 1)
	(and	(unit-type-count villager g:< boar-villagers)
		(and	(dropsite-min-distance hunting >= 8)
			(and	(unit-type-count villager-food >= 2)
				(building-type-count-total food-placement-camp <= 0)))))))))
=>
	(set-strategic-number sn-minimum-number-hunters 0)
	(up-jump-rule 2))
(defrule
(or	(strategic-number sn-minimum-boar-hunt-group-size > 2)
	(strategic-number sn-minimum-number-hunters > 2))
	(strategic-number sn-enable-boar-hunting == 1)
(or	(up-compare-goal temporary-goal15 <= -1)
	(up-compare-goal temporary-goal15 >= 35))
	(dropsite-min-distance hunting >= 0)
(or	(dropsite-min-distance hunting <= 34)
	(dropsite-min-distance hunting s:<= sn-maximum-hunt-drop-distance))
=>
	(up-modify-sn sn-minimum-boar-hunt-group-size c:min 2)
	(up-modify-sn sn-minimum-number-hunters c:min 2)
	(up-jump-rule 1))
(defrule
	(strategic-number sn-minimum-number-hunters < 2)
	(up-compare-goal deer-luring != 1)
	(dropsite-min-distance deer-hunting >= 0)
	(dropsite-min-distance deer-hunting < 8)
	(dropsite-min-distance deer-hunting s:<= sn-maximum-hunt-drop-distance)
=>
	(up-modify-sn sn-minimum-number-hunters c:max 2)); end jumps


(defrule
	(up-compare-goal boar-distance >= 60)
	(timer-triggered ten-seconds); one-minute
=>
	(chat-to-player my-player-number "Trying to reach boar again.")
;	;(chat-to-player every-ally "Trying to reach boar again.")
	(set-goal current-boar -1)
	(set-goal found-boar -1)
;	(set-goal boar-lurer -1)
;	(set-goal found-lurer -1)
	(set-goal boar-distance -1)
	(disable-timer boar-reset-timer))

(defrule
(or	(building-type-count town-center <= 0)
(or	(and	(up-compare-goal temporary-goal15 >= 35)
		(not	(up-set-target-by-id g: current-boar)))
	(cc-players-unit-type-count 0 boar-class <= 0)))
=>
	(up-jump-rule 33))
(defrule
	(true)
=>
	(up-full-reset-search)
	(up-get-fact unit-type-count villager-hunter temporary-goal4)
	(up-modify-goal temporary-goal4 c:min 40)
	(up-find-local c: 122 g: temporary-goal4)
	(up-find-local c: 216 g: temporary-goal4)
	(up-remove-objects search-local object-data-target != dangerous-animal-class);(up-remove-objects search-local object-data-target-id g:!= current-boar)
	(up-get-search-state local-total)
	(up-modify-goal temporary-goal3 g:= local-total)
	(up-modify-goal temporary-goal3 c:- decay-bonus)
	(up-modify-goal temporary-goal3 c:min 8); 8
	(up-modify-goal temporary-goal3 c:max 1); 0
	(up-modify-goal temporary-goal3 c:* 4)
	(up-modify-goal temporary-goal3 c:* l-hunters1)
	(up-modify-goal temporary-goal3 c:/ l-hunters2))
(defrule
	(true)
=>
	(up-get-fact dropsite-min-distance live-boar temporary-goal2)
	(up-modify-goal temporary-goal2 c:* 25); (both)
	(up-modify-goal temporary-goal2 c:+ 40)
	(up-modify-goal temporary-goal2 g:%* temporary-goal3)
	(up-modify-goal temporary-goal2 c:min 200)
	(up-modify-goal temporary-goal2 c:max 1)
	(set-goal temporary-goal 0)
	(up-modify-goal temporary-goal4 g:= loom-distance)
	(up-full-reset-search))

(defrule
(or	(not	(up-set-target-by-id g: current-boar))
	(and	(up-compare-goal current-boar != -1); test
		(and	(dropsite-min-distance boar-hunting >= 35); live-boar
			(up-compare-goal temporary-goal15 >= 35))))
=>
;	(chat-to-player my-player-number "No valid boar in range.")
	(set-goal current-boar -1)
	(set-goal found-boar -1)
	(set-goal search-action -1)
	(set-goal found-boar -1)
	(set-goal boar-lurer -1)
	(set-goal found-lurer -1)
	(set-goal boar-distance -1)
	(disable-timer boar-reset-timer))
(defrule
	(up-set-target-by-id g: current-boar)
	(timer-triggered boar-reset-timer)
	(up-object-data object-data-status == status-ready)
;	(up-object-data object-data-target != villager-class)
	(up-object-data object-data-action != actionid-attack)
	(up-object-data object-data-tasks-count <= 0)
(or	(not	(up-set-target-by-id g: boar-lurer))
	(and	(up-set-target-by-id g: boar-lurer)
		(up-object-data object-data-target-id g:!= current-boar)))
=>
;	(chat-to-player my-player-number "Boar not being targeted.")
	(set-goal current-boar -1)
	(set-goal found-boar -1)
	(set-goal search-action -1)
	(set-goal found-boar -1)
	(set-goal boar-lurer -1)
	(set-goal found-lurer -1)
	(set-goal boar-distance -1)
	(disable-timer boar-reset-timer))
(defrule
	(up-set-target-by-id g: current-boar)
	(timer-triggered boar-reset-timer)
	(up-object-data object-data-status == status-ready)
;	(up-object-data object-data-target != villager-class)
	(up-object-data object-data-action != actionid-attack)
	(up-set-target-by-id g: boar-lurer)
	(up-object-data object-data-hitpoints < 25)
=>
;	(chat-to-player my-player-number "Discarding low hp lurer.")
	(up-full-reset-search)
	(up-add-object-by-id search-local g: boar-lurer)
	(up-set-target-by-id g: position-self-id)
	(up-remove-objects search-local object-data-order == orderid-enter)
	(up-target-objects 1 action-garrison -1 -1)
	(set-goal current-boar -1)
	(set-goal found-boar -1)
	(set-goal search-action -1)
	(set-goal found-boar -1)
	(set-goal boar-lurer -1)
	(set-goal found-lurer -1)
	(set-goal boar-distance -1)
	(disable-timer boar-reset-timer))
(defrule
	(up-set-target-by-id g: current-boar)
	(up-object-data object-data-status != status-ready)	
	(up-object-data object-data-carry g:< temporary-goal2)
=>
;	(chat-to-player my-player-number "Low food.")
	(set-goal current-boar -1)
	(set-goal found-boar -1)
	(set-goal search-action -1)
	(set-goal found-boar -1)
	(set-goal boar-lurer -1)
	(set-goal found-lurer -1)
	(set-goal boar-distance -1)
	(disable-timer boar-reset-timer))
(defrule
	(up-set-target-by-id g: current-boar)
	(up-object-data object-data-status != status-ready)	
	(up-object-data object-data-carry >= 2048)
	(unit-type-count villager-food >= 8)
=>
;	(chat-to-player my-player-number "Extreme amount of food.")
	(set-goal current-boar -1)
	(set-goal found-boar -1)
	(set-goal search-action -1)
	(set-goal found-boar -1)
	(set-goal boar-lurer -1)
	(set-goal found-lurer -1)
	(set-goal boar-distance -1)
	(disable-timer boar-reset-timer))

(defrule
(or	(up-set-target-by-id g: current-boar)
(or	(up-compare-goal villager-count g:< boar-villagers)
(or	(and	(building-type-count town-center <= 0)
		(and	(building-type-count mule-cart <= 0)
			(and	(building-type-count settlement <= 0)
				(building-type-count mill <= 0))))
	(strategic-number sn-enable-boar-hunting < 1))))
=>
	(up-jump-rule 4))
(defrule
(not	(up-set-target-by-id g: current-boar))
	(up-compare-goal my-boars >= 1)
=>
;	(chat-to-player my-player-number "Find boar.")
	(set-goal temporary-goal 0)
	(set-goal temporary-goal2 0)
	(up-get-fact building-type-count town-center temporary-goal3)
	(up-find-local c: town-center g: temporary-goal3))
(defrule; end neg jump
(not	(up-set-target-by-id g: current-boar))
	(up-compare-goal my-boars >= 1)
	(up-set-target-object search-local g: temporary-goal)
=>
	(up-get-point position-object temp-x)
;	(up-modify-goal temp-x c:- 1)
	(up-set-target-point temp-x)
	(up-filter-distance c: -1 c: 34)
	(up-filter-status c: status-ready c: list-active)
	(up-find-resource c: boar-class c: 24)
	(up-remove-objects search-remote object-data-hitpoints >= 100)
	(up-remove-objects search-remote object-data-maxhp >= 350)
	(up-remove-objects search-remote object-data-carry < 20))
(defrule
(not	(up-set-target-by-id g: current-boar))
	(up-compare-goal my-boars >= 1)
	(up-set-target-object search-local g: temporary-goal)
(not	(up-set-target-object search-remote c: 0))
	(up-compare-goal temporary-goal g:< temporary-goal3)
=>
;	(up-send-flare temp-x)
	(up-modify-goal temporary-goal c:+ 1)
	(up-reset-filters)
	(up-reset-search 0 0 1 1)
	(up-jump-rule -2))
(defrule
(not	(up-set-target-by-id g: current-boar))
	(up-compare-goal my-boars >= 1)
	(up-set-target-object search-local g: temporary-goal)
	(up-set-target-object search-remote c: 0)
=>
	(up-clean-search search-remote object-data-precise-distance search-order-asc)
	(up-set-target-object search-remote c: 0)
	(up-get-object-data object-data-id current-boar)
	(up-get-point position-object temp5-x)
	(up-get-point-distance temp-x temp5-x boar-distance)
;	(chat-to-player my-player-number "Selected boar.1")
	(set-goal found-boar 1)); end jump


(defrule
	(goal found-boar 1)
	(up-set-target-by-id g: current-boar)
	(up-compare-goal boar-distance < 60)
	(up-object-data object-data-status == status-ready)
	(up-object-data object-data-action != actionid-attack)
=>
	(up-full-reset-search)
;	(chat-to-player my-player-number "Selected boar.2")
	(set-goal found-lurer 0)
	(set-goal boar-lurer -1)
	(up-set-target-by-id g: current-boar)
	(up-get-point position-object temp4-x)
	(up-set-target-point temp4-x)
;	(up-send-flare temp4-x)
;	(up-send-flare temp-x)
	(set-goal search-action search-action-boar-hunting))
(defrule
	(goal search-action search-action-boar-hunting)
	(goal found-boar 1)
	(up-set-target-by-id g: current-boar)
	(up-object-data object-data-status == status-ready)
(or	(and	(up-point-distance temp-x temp4-x <= 34)
		(up-point-distance temp-x temp4-x g:> loom-distance))
	(and	(up-compare-goal temporary-goal15 <= 34)
		(up-compare-goal temporary-goal15 g:> loom-distance)))
	(up-compare-flag escrow-flag != 64)
	(up-compare-goal villager-count-total g:>= boar-villagers)
;	(can-afford-research ri-loom);	(gold-amount >= 50)
	(research-available ri-loom)
=>
	(up-add-research-cost c: ri-loom c: 1)
	(up-modify-flag escrow-flag c:+ 64))


(defrule
(or	(up-compare-goal search-action != search-action-boar-hunting)
(or	(up-compare-goal villager-count g:< boar-villagers)
	(and	(up-research-status c: ri-loom < research-complete)
		(and	(up-point-distance temp-x temp4-x g:> loom-distance)
			(up-compare-goal temporary-goal15 g:> loom-distance)))))
=>
;	(set-goal found-lurer 0)
;	(set-goal current-boar -1); test
;	(set-goal search-action -1)
;	(set-goal found-boar -1)
;	(set-goal boar-lurer -1)
	(up-jump-rule 5))
(defrule
	(goal search-action search-action-boar-hunting)
=>
	(up-full-reset-search)
	(up-set-target-by-id g: current-boar)
	(up-get-point position-object temp4-x)
	(up-set-target-point temp4-x)
	(up-filter-distance c: -1 c: 32)
	(up-filter-exclude -1 actionid-attack orderid-build -1)
	(up-find-local c: villager-class g: villager-count)
	(up-remove-objects search-local object-data-gather-type != food))
(defrule
	(goal search-action search-action-boar-hunting)
(not	(up-set-target-object search-local c: 0))
=>
	(up-reset-search 1 1 0 0)
	(up-find-local c: villager-class g: villager-count)
	(up-remove-objects search-local object-data-carry >= 1))
(defrule
	(goal search-action search-action-boar-hunting)
	(up-set-target-object search-local c: 0)
	(up-point-distance temp-x temp4-x g:> loom-distance)
	(up-compare-goal temporary-goal15 g:> loom-distance)
=>
	(up-remove-objects search-local object-data-hitpoints < 40))
(defrule
	(goal search-action search-action-boar-hunting)
	(up-set-target-object search-local c: 0)
=>
	(up-remove-objects search-local object-data-hitpoints < 25)
	(up-clean-search search-local object-data-precise-distance search-order-asc))
(defrule
	(goal search-action search-action-boar-hunting)
	(up-set-target-object search-local c: 0)
=>
	(up-get-object-data object-data-id boar-lurer)
	(up-get-path-distance temp4-x 0 boar-distance)
	(set-goal found-lurer 2)); end jump

(defrule
(not	(up-set-target-by-id g: last-boar))
=>
	(set-goal last-boar -1))
(defrule
	(up-set-target-by-id g: current-boar)
(not	(up-set-target-by-id g: last-boar))
=>
	(up-modify-goal last-boar g:= current-boar))

(defrule
	(up-compare-goal found-boar >= 2)
	(goal search-action search-action-hunt-support)
	(up-set-target-by-id g: current-boar)
=>
	(up-get-point position-object temp4-x)
	(up-set-target-point temp4-x)
	(up-full-reset-search)
	(up-filter-distance c: -1 c: 34)
	(up-find-local c: villager-class g: villager-count)
	(up-remove-objects search-local object-data-target-id g:!= current-boar)
	(up-get-search-state local-total)
	(up-modify-goal temporary-goal4 g:= local-total)
	(up-full-reset-search))
(defrule
	(up-compare-goal found-boar >= 2)
	(goal search-action search-action-hunt-support)
	(up-compare-goal temporary-goal15 <= 10)
	(up-compare-goal temporary-goal4 <= 7)
(or	(up-compare-goal temporary-goal15 <= 4)
	(and	(up-set-target-by-id g: boar-lurer)
		(or	(up-object-data object-data-garrisoned == 1)
			(up-object-data object-data-hitpoints < 15)))); 8
	(up-set-target-by-id g: current-boar);	(up-compare-goal current-boar != -1)
=>
	(up-full-reset-search)
	(up-filter-distance c: -1 c: 20)
	(up-filter-exclude -1 actionid-attack orderid-build -1)
	(up-find-local c: villager-class g: villager-count)
	(up-remove-objects search-local object-data-gather-type != food)
;	(up-remove-objects search-local object-data-target == tree-class)
;	(up-remove-objects search-local object-data-target == gold-mine-class)
;	(up-remove-objects search-local object-data-target == stone-mine-class)
	(up-remove-objects search-local object-data-target-id g:== current-boar))
(defrule
(not	(up-set-target-object search-local c: 0))
	(up-compare-goal found-boar >= 2)
	(goal search-action search-action-hunt-support)
	(up-compare-goal temporary-goal15 <= 10)
	(up-compare-goal temporary-goal4 <= 7)
(or	(up-compare-goal temporary-goal15 <= 4)
	(and	(up-set-target-by-id g: boar-lurer)
		(or	(up-object-data object-data-garrisoned == 1)
			(up-object-data object-data-hitpoints < 15)))); 8
	(up-set-target-by-id g: current-boar);	(up-compare-goal current-boar != -1)
=>
	(up-reset-search 1 1 0 0)
	(up-find-local c: villager-class g: villager-count)
	(up-remove-objects search-local object-data-carry >= 1)
	(up-remove-objects search-local object-data-target-id g:== current-boar))
(defrule
	(up-set-target-object search-local c: 0)
	(goal found-boar 2)
	(goal search-action search-action-hunt-support)
	(up-compare-goal temporary-goal15 <= 10)
	(up-compare-goal temporary-goal4 <= 1)
	(up-set-target-by-id g: boar-lurer)
(or	(and	(up-object-data object-data-garrisoned == 1)
		(up-compare-goal temporary-goal4 <= 0))
	(up-object-data object-data-hitpoints < 15)); 8
	(up-set-target-by-id g: current-boar);	(up-compare-goal current-boar != -1)
=>
;	(chat-local-to-self "Send support hunter.")
	(up-remove-objects search-local object-data-hitpoints < 15)
	(up-clean-search search-local object-data-precise-distance search-order-asc)
	(up-set-target-object search-local c: 0)
	(up-set-target-by-id g: current-boar)
	(up-gather-inside c: town-center c: -1)
	(up-remove-objects search-local object-data-index >= 1)
	(up-target-objects 1 action-default -1 -1) 
	(enable-timer boar-reset-timer 10)
	(up-jump-rule 1))
(defrule
	(up-set-target-object search-local c: 0)
	(goal found-boar 2)
	(goal search-action search-action-hunt-support)
	(up-compare-goal temporary-goal15 <= 4)
	(up-compare-goal temporary-goal4 <= 7)
	(up-set-target-by-id g: current-boar);	(up-compare-goal current-boar != -1)
=>
;	(chat-local-to-self "Capture boar.")
	(up-clean-search search-local object-data-precise-distance search-order-asc)
	(up-set-target-object search-local c: 0)
	(up-set-target-by-id g: current-boar)
	(up-gather-inside c: town-center c: -1)
	(up-modify-goal temporary-goal4 c:- 8)
	(up-modify-goal temporary-goal4 c:* -1)
	(up-remove-objects search-local object-data-index g:>= temporary-goal4)
	(up-target-objects 1 action-default -1 -1)
	(up-modify-goal boar-captured c:+ 1)
	(set-goal search-action -1)
	(set-goal found-boar -1)
	(set-goal boar-lurer -1)
	(enable-timer boar-reset-timer 10)); 45

(defrule
	(goal search-action search-action-boar-hunting)
	(goal found-lurer 2)
	(up-compare-goal boar-distance < 60)
	(up-set-target-by-id g: boar-lurer);	(up-compare-goal boar-lurer != -1)
	(up-set-target-by-id g: current-boar);	(up-compare-goal current-boar != -1)
=>
;	(chat-local-to-self "Starting lure.")
	(up-gather-inside c: town-center c: -1);
	(up-full-reset-search)
	(up-add-object-by-id search-local g: boar-lurer)
	(up-add-object-by-id search-remote g: current-boar)
	(up-target-objects 0 action-default -1 -1)
	(set-goal temporary-goal 10); 30
	(up-modify-goal temporary-goal2 g:= boar-distance)
	(up-modify-goal temporary-goal2 c:%* 125)
	(up-modify-goal temporary-goal2 c:+ 5)
	(up-modify-goal temporary-goal g:max temporary-goal2)
	(up-set-timer c: boar-reset-timer g: temporary-goal);	(enable-timer boar-reset-timer 30); 15
	(set-goal search-action search-action-hunt-support)
	(set-goal found-boar 2))

(defrule
(or	(cc-players-unit-type-count 0 dangerous-animal-class <= 0)
(or	(up-compare-goal boar-lurer == -1)
	(up-compare-goal current-boar == -1)))
=>
	(up-jump-rule 4))
(defrule
	(true)
=>
	(up-full-reset-search)
	(up-add-object-by-id search-remote g: current-boar)
	(up-set-target-object search-remote c: 0)
	(up-get-object-data object-data-target-id temporary-goal)
	(up-full-reset-search)
	(up-set-target-by-id g: boar-lurer)
	(up-get-point position-object temp-x)
	(up-set-target-point temp-x)
	(up-full-reset-search)
	(up-filter-distance c: 2 c: 16)
	(up-filter-include -1 actionid-attack -1 -1)
	(up-filter-status c: status-ready c: list-active)
	(up-find-resource c: dangerous-animal-class c: 5)
	(up-remove-objects search-remote object-data-carry >= 1))
(defrule
(or	(not	(up-set-target-by-id g: boar-lurer))
(or	(and	(up-set-target-by-id g: boar-lurer)
		(up-object-data object-data-target-id g:!= current-boar))
(or	(not	(up-set-target-object search-remote c: 0))
	(and	(up-set-target-object search-remote c: 0)
		(up-path-distance temp-x 1 >= 10)))))
=>
	(up-jump-rule 2))
(defrule
	(up-set-target-object search-remote c: 0)
	(up-object-data object-data-target-id g:== boar-lurer)
	(up-compare-goal temporary-goal g:!= boar-lurer)
=>
;	(chat-local-to-self "Villager saved.")
	(up-full-reset-search)
;	(set-goal boar-lurer -1)
	(set-goal found-lurer -1)
	(set-goal found-boar 1);
	(up-add-object-by-id search-local g: boar-lurer)
	(up-remove-objects search-local object-data-order == orderid-enter)
	(up-target-point 0 action-stop -1 -1)
	(up-get-timer c: boar-reset-timer temporary-goal)
	(up-modify-goal temporary-goal c:max 0)
	(up-modify-goal temporary-goal c:/ 1000)
	(up-get-fact game-time 0 temporary-goal2)
	(up-modify-goal temporary-goal g:- temporary-goal2)
	(up-modify-goal temporary-goal c:max 8)
	(up-set-timer c: boar-reset-timer g: temporary-goal)
	(up-jump-rule 1))
(defrule
	(up-set-target-object search-remote c: 0)
	(up-object-data object-data-target-id g:== boar-lurer)
	(up-compare-goal temporary-goal g:== boar-lurer)
=>
;	(chat-local-to-self "Running.")
	(up-gather-inside c: town-center c: -1);
	(up-full-reset-search)
;	(set-goal boar-lurer -1)
	(set-goal found-lurer -1)
	(set-goal found-boar 1);
	(up-add-object-by-id search-local g: boar-lurer)
	(up-remove-objects search-local object-data-order == orderid-enter)
	(up-set-target-by-id g: position-self-id)
	(up-target-objects 1 action-garrison -1 -1); todo ; check TC hp
	(up-get-timer c: boar-reset-timer temporary-goal)
	(up-modify-goal temporary-goal c:max 0)
	(up-modify-goal temporary-goal c:/ 1000)
	(up-get-fact game-time 0 temporary-goal2)
	(up-modify-goal temporary-goal g:- temporary-goal2)
	(up-modify-goal temporary-goal c:max 8)
	(up-set-timer c: boar-reset-timer g: temporary-goal)); end mini jumps; End big jump

(defrule
	(false)
(or	(up-compare-goal temporary-goal15 >= 35)
(or	(not	(up-set-target-by-id g: current-boar))
	(and	(up-set-target-by-id g: current-boar)
		(or	(up-object-data object-data-status != status-ready)
			(up-object-data object-data-action != actionid-attack)))))
=>
	(up-gather-inside c: town-center c: 0)); end jump


