(defrule
	(timer-triggered scout-timer)
	(up-compare-goal scout-count >= 1)
(or	(military-population >= 1)
	(up-set-target-by-id g: scouting-unit))
	(up-compare-flag micro-flag == f-drush-micro)
	(up-compare-goal strategy != maa-opener)
	(players-current-age target-player <= dark-age);
	(up-compare-goal drush-target != lumber-camp);(up-compare-goal drush-target == 0)
	(up-compare-goal drush-target != mining-camp)
	(up-compare-goal drush-target != mule-cart);
	(up-compare-goal drush-target != mill);
	(up-compare-goal map-type < type-islands)
	(up-compare-goal wall-strength < 150)
	(players-building-count target-player >= 1)
(or	(up-compare-goal target-distance < 60)
	(players-building-count every-enemy >= 1))
; nn	(goal attacking no)
=>
	(chat-local-to-self "Drush: Rescouting the target-player.")
	(up-send-scout group-type-land-explore scout-enemy)
	(disable-timer scout-timer)
	(enable-timer scout-timer 105))

(defrule
;	(strategic-number sn-current-age <= feudal)
(or	(up-compare-goal scout-count <= 0)
(or	(and	(game-time < 600)
		(or	(players-current-age every-enemy <= dark-age)
			(and	(up-compare-goal target-distance >= 60)
				(players-building-count any-enemy <= 0))))
(or	(and	(military-population <= 0)
		(not	(up-set-target-by-id g: scouting-unit)))
(or	(up-compare-goal map-type >= type-islands)
(or	(wall-completed-percentage 2 >= 100)
	(wall-completed-percentage 1 >= 100))))))
=>
	(up-jump-rule 5))
