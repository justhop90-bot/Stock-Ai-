	(up-set-target-object search-remote c: 0)
	(up-object-data object-data-player == 0)
(not	(up-set-target-object search-remote c: 1))
=>
	(up-get-object-data object-data-id temporary-goal2)
	(up-full-reset-search)
	(up-find-local c: mule-cart c: 100)
	(up-remove-objects search-local object-data-tasks-count >= 1)
	(up-get-search-state local-total)
	(up-modify-goal local-total c:- 1))
(defrule; end neg jump
	(up-compare-goal temporary-goal2 >= 0)
	(up-set-target-object search-local g: local-total)
=>
	(up-get-point position-object temp-x)
	(up-set-target-point temp-x)
	(up-reset-search 0 0 1 1)
	(up-reset-filters)
	(up-filter-distance c: -1 c: 8)
	(up-modify-goal temporary-goal s:= sn-focus-player-number)
	(up-modify-sn sn-focus-player-number c:= my-player-number)
	(up-find-remote c: villager-class c: 10)
;	(up-remove-objects search-remote object-data-action == actionid-build)
	(up-remove-objects search-remote object-data-action == actionid-enter)
	(up-remove-objects search-remote object-data-action == actionid-move)
	(up-remove-objects search-remote object-data-action == actionid-explore)
	(up-remove-objects search-remote object-data-under-attack == 1)
	(up-filter-include -1 actionid-hunt -1 -1)
	(up-find-remote c: villager-class c: 1)
	(up-filter-include -1 actionid-gather -1 -1)
	(up-find-remote c: villager-class c: 1)
	(up-modify-sn sn-focus-player-number g:= temporary-goal))
(defrule
	(up-compare-goal temporary-goal2 >= 0)
	(up-set-target-object search-local g: local-total)
	(up-set-target-object search-remote c: 0)
=>
	(up-modify-goal local-total c:- 1)
	(up-jump-rule -2))
(defrule
	(up-compare-goal temporary-goal2 >= 0)
	(up-set-target-object search-local g: local-total)
(not	(up-set-target-object search-remote c: 0))
=>
;	(chat-local-to-self "Sending idle mule cart to desired resource.")
	(up-remove-objects search-local object-data-index g:!= local-total)
	(up-add-object-by-id search-remote g: temporary-goal2)
	(up-set-target-by-id g: temporary-goal2)
	(up-target-objects 1 action-default -1 -1)); end jump
