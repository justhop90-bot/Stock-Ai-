(defrule
(or	(strategic-number sn-focus-player-number >= 9)
(or	(strategic-number sn-focus-player-number <= 0)
	(stance-toward focus-player ally)))
	(strategic-number sn-target-player-number >= 1)
	(strategic-number sn-target-player-number <= 8)
(not	(stance-toward target-player ally))
	(player-in-game target-player)
=>
	(up-modify-goal temporary-goal s:= sn-target-player-number); to prevent further bugs
	(up-modify-sn sn-focus-player-number s:= sn-target-player-number); should be an enemy
	(chat-to-player my-player-number "Debugging focus player. 3"))


(defrule
(or	(game-time >= 60)
(or	(up-compare-goal nomad-start <= 0)
	(unit-type-count-total villager <= 1)))
=>
	(up-jump-rule 10))
(defrule
	(building-type-count-total wood-placement-camp <= 0)
	(building-type-count-total town-center <= 0)
=>
	(set-goal temporary-goal 0)
	(set-goal temp3-x 0)
	(set-goal temp3-y 0)
	(up-full-reset-search)
	(up-set-target-point center-x)
	(up-filter-exclude -1 actionid-build orderid-explore -1)
	(up-find-local c: villager-class c: 20)
	(up-remove-objects search-local object-data-idling != 1)
	(up-clean-search search-local object-data-distance search-order-desc)
	(up-set-target-object search-local c: 0)
	(up-get-point position-object temp-x)
	(up-set-target-point temp-x)
	(up-clean-search search-local object-data-distance search-order-desc)
	(up-set-target-object search-local c: 0)
	(up-get-point position-object temp2-x)
	(up-lerp-percent temp-x temp2-x c: 50)
	(up-copy-point temp2-x temp-x)
	(up-bound-precise-point temp2-x 0 c: 4)
	(up-get-point-distance temp-x center-x temporary-goal2)
	(up-modify-goal temporary-goal3 g:= map-size)
	(up-modify-goal temporary-goal3 c:%* 25)
	(up-modify-goal temporary-goal2 g:- temporary-goal3)
	(up-modify-goal temporary-goal2 c:min 1)
	(up-modify-goal temporary-goal2 c:max -16)
	(up-lerp-tiles temp-x center-x g: temporary-goal2)
	(up-bound-precise-point temp-x 0 c: 4))
(defrule
	(building-type-count-total wood-placement-camp <= 0)
	(building-type-count-total town-center <= 0)
	(up-set-target-object search-local c: 0)
	(up-point-explored temp-x != explored-no)
	(up-point-explored temp2-x != explored-no)
=>
	(up-reset-search 1 1 0 0)
	(up-set-target-point temp-x)
	(up-find-local c: villager-class c: 10)
	(up-set-target-point temp2-x)
	(up-find-local c: villager-class c: 10)
	(up-remove-objects search-local object-data-action == actionid-enter)
	(up-remove-objects search-local object-data-action == actionid-attack)
	(up-remove-objects search-local object-data-action == actionid-repair)
	(up-jump-rule 2))
(defrule
	(building-type-count-total wood-placement-camp <= 0)
	(building-type-count-total town-center <= 0)
	(up-set-target-object search-local c: 0)
	(up-point-explored temp-x == explored-no)
	(up-path-distance temp-x 0 != 65535)
=>
	(up-set-target-point temp-x)
	(up-remove-objects search-local object-data-distance <= 4)
	(up-target-point 0 action-move -1 -1)
	(up-jump-rule 6))
(defrule
	(building-type-count-total wood-placement-camp <= 0)
	(building-type-count-total town-center <= 0)
	(up-set-target-object search-local c: 0)
	(up-point-explored temp2-x == explored-no)
=>
	(up-set-target-point temp2-x)
	(up-remove-objects search-local object-data-distance <= 4)
	(up-target-point 0 action-move -1 -1)
	(up-jump-rule 5)); end mini jump
(defrule ; end neg jump
	(building-type-count-total wood-placement-camp <= 0)
	(building-type-count-total town-center <= 0)
	(up-set-target-object search-local g: temporary-goal)
=>
	(up-get-point position-object temp4-x)
	(up-add-point temp3-x temp4-x c: 1)
	(up-modify-goal temporary-goal c:+ 1)
	(up-jump-rule -1))
(defrule
	(building-type-count-total wood-placement-camp <= 0)
	(building-type-count-total town-center <= 0)
	(up-set-target-object search-local c: 0)
(or	(up-compare-goal temp3-x >= 1)
	(up-compare-goal temp3-y >= 1))
=>
	(up-modify-goal temp3-x g:/ temporary-goal)
	(up-modify-goal temp3-y g:/ temporary-goal)
	(up-bound-precise-point temp3-x 0 c: 4)
	(up-modify-goal temporary-goal5 g:= gl-game-time)
	(up-modify-goal temporary-goal5 c:mod 2)
	(up-cross-tiles temp3-x center-x g: temporary-goal5);
	(set-goal temporary-goal 0))
(defrule ; end neg jump
	(building-type-count-total wood-placement-camp <= 0)
	(building-type-count-total town-center <= 0)
	(up-set-target-object search-local g: temporary-goal)
=>
	(up-get-point position-object temp4-x)
	(up-lerp-tiles temp4-x temp3-x c: -16)
	(up-bound-precise-point temp4-x 0 c: 4))
(defrule
	(building-type-count-total wood-placement-camp <= 0)
	(building-type-count-total town-center <= 0)
	(up-set-target-object search-local g: temporary-goal)
	(up-point-distance temp4-x temp3-x >= 5)
	(up-get-object-data object-data-move-x temp5-x)
	(up-get-object-data object-data-move-y temp5-y)
	(up-point-distance temp4-x temp5-x >= 5)
=>
	(up-remove-objects search-local object-data-index g:!= temporary-goal)
	(up-set-target-point temp4-x)
	(up-target-point 0 action-move -1 -1)
	(up-jump-rule 1))
(defrule
	(building-type-count-total wood-placement-camp <= 0)
	(building-type-count-total town-center <= 0)
	(up-set-target-object search-local g: temporary-goal)
=>
	(up-modify-goal temporary-goal c:+ 1)
	(up-jump-rule -3)); end mini jumps
(defrule
(or	(up-compare-goal gl-game-time g:>= map-size)
(or	(up-resource-amount amount-exploration >= 100)
(or	(game-time >= 50)
(or	(building-type-count-total wood-placement-camp >= 1)
	(building-type-count-total town-center >= 1)))))
=>
	(up-full-reset-search)
	(up-filter-include -1 actionid-move -1 -1)
	(up-find-local c: villager-class c: 40)
	(up-target-point 0 action-stop -1 -1)
	(disable-self)); end jumps


