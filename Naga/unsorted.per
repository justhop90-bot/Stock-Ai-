(or	(up-compare-goal temporary-goal < 32)
	(up-compare-goal temporary-goal >= 210))
=>
	(set-goal c-scout-time -1))
(defrule
(or	(up-compare-goal scout-count <= 0)
(or	(and	(military-population <= 0)
		(not	(up-set-target-by-id g: scouting-unit)))
(or	(up-compare-goal map-type >= type-islands)
(or	(up-compare-goal deer-luring == 1)
(or	(game-time >= 1020)
	;(and	(up-compare-goal scout-count >= 1)
		(up-compare-goal temporary-goal < 32))))));)
=>
