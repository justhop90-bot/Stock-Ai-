(defrule
	(up-compare-goal gl-game-time g:< c-scout-time)
(or	(goal player-position pocket); test
(or	(map-type arena)
(or	(map-type fortress)
(or	(up-compare-goal wall-strength >= 1)
(or	(players-building-count every-enemy >= 1)
	(and	(goal player-position flank)
		(and	(players-building-count any-enemy >= 1)
			(up-compare-goal target-distance < 60))))))))
=>
	(set-goal c-scout-time -1))
(defrule
	(up-compare-goal gl-game-time g:< c-scout-time)
(or	(up-compare-const dm-game == 1)
(or	(up-compare-goal nomad-start >= 1)
(or	(up-compare-goal map-type >= type-water)
(or	(players-building-type-count any-enemy stone-wall-line >= 4)
(or	(players-building-type-count any-enemy palisade-wall >= 20)
	(players-building-type-count any-enemy gate-class >= 2))))))
=>
	(set-goal c-scout-time -1))
(defrule
	(goal deer-luring 1)
	(up-compare-goal c-scout-time >= 0)
	(up-compare-goal c-scout-time < 900)
=>
	(up-modify-goal c-scout-time c:max 900))
(defrule
(or	(game-time >= 900)
	(up-compare-goal map-type >= type-islands))
(or	(wall-completed-percentage 2 >= 100)
	(wall-completed-percentage 1 >= 100))
(or	(up-compare-goal map-type >= type-islands)
(or	(building-type-count stone-wall-line >= 4)
(or	(building-type-count palisade-wall >= 20)
	(building-type-count gate-class >= 2))))
	(players-building-type-count any-enemy stone-wall-line >= 4)
	(players-building-type-count any-enemy palisade-wall >= 20)
	(players-building-type-count any-enemy gate-class >= 2)
=>
	(up-jump-rule 26))
(defrule
(or	(up-compare-goal gl-game-time g:>= c-scout-time)
(or	(game-time s:< sn-home-exploration-time)
(or	(up-compare-goal deer-luring == 1)
(or	(up-compare-goal scout-count <= 0)
	(not	(up-set-target-by-id g: scouting-unit))))))
=>
;	(up-chat-data-to-player my-player-number "c-scout-time: %d" g: c-scout-time)
;	(up-chat-data-to-player my-player-number "scouting: %d" g: scouting)
;	(up-chat-data-to-player my-player-number "deer-luring: %d" g: deer-luring)
;	(up-chat-data-to-player my-player-number "sn-home-exploration-time: %d" s: sn-home-exploration-time)
	(up-jump-rule 10))
(defrule
	(up-compare-goal c-scout-time >= 900)
=>
	(up-get-fact game-time 0 c-scout-time)
	(up-modify-goal temporary-goal g:= map-size)
	(up-modify-goal temporary-goal c:%* 142)
	(up-modify-goal c-scout-time g:+ temporary-goal)
	(up-modify-goal temporary-goal2 g:= temporary-goal)
	(up-modify-goal temporary-goal2 c:%* 25)
	(up-modify-goal c-scout-time g:- temporary-goal2)
	(up-modify-goal temporary-goal2 g:* player-position)
	(up-modify-goal c-scout-time g:+ temporary-goal2)
;	(up-chat-data-to-player my-player-number "c-scout-time: %d" g: c-scout-time)
	(up-modify-goal c-scout-time c:min 899))
(defrule
	(true)
=>
	(up-full-reset-search)
	(set-goal temporary-goal3 16)
	(up-modify-goal temporary-goal6 g:= target-distance)
	(up-modify-goal temporary-goal6 c:%* 142)
	(up-modify-goal temporary-goal7 g:= scout-los)
;	(up-modify-goal temporary-goal7 c:+ 1)
	(up-get-point scouting-type temp6-x)
	(up-bound-precise-point temp6-x 0 g: temporary-goal7)
	(up-add-object-by-id search-local g: scouting-unit))
(defrule
	(up-timer-status scout-timer != timer-triggered)
=>
;	(chat-to-all "WAIT")
	(up-remove-objects search-local object-data-idling != 1))
(defrule
	(up-set-target-object search-local c: 0)
(or	(up-compare-goal number-allies >= 1)
	(up-compare-goal number-enemies >= 2))
=>
	(up-get-point position-object temp2-x)
	(up-copy-point temp4-x self-x)
	(up-cross-tiles temp4-x center-x c: -16)
	(up-copy-point temp5-x self-x)
	(up-cross-tiles temp5-x center-x c: 16)
	(up-get-point-distance temp4-x temp6-x temporary-goal)
	(up-get-point-distance temp5-x temp6-x temporary-goal2)
	(up-jump-rule 1))
(defrule
	(up-set-target-object search-local c: 0)
=>
;	(chat-to-all "GO")
	(up-get-point position-object temp2-x)
	(up-copy-point temp4-x self-x)
	(up-cross-tiles temp4-x temp6-x c: -16)
	(up-copy-point temp5-x self-x)
	(up-cross-tiles temp5-x temp6-x c: 16)
	(up-get-point-distance temp2-x temp4-x temporary-goal)
	(up-get-point-distance temp2-x temp5-x temporary-goal2)); end jump
(defrule
	(up-set-target-object search-local c: 0)
	(up-compare-goal temporary-goal g:<= temporary-goal2)
=>
;	(chat-to-all "TURN")
	(up-modify-goal temporary-goal3 c:* -1))
#load-if-defined REVEAL-NORMAL
(defrule
	(up-set-target-object search-local c: 0)
	(up-point-explored temp6-x != explored-no)
=>
;	(chat-to-all "TURN2")
	(up-modify-goal temporary-goal3 c:* -1))
#else
(defrule
	(up-set-target-object search-local c: 0)
	(up-point-distance temp2-x temp6-x g:<= temporary-goal7)
=>
;	(chat-local-to-self "Disabling c-scouting.")
	(set-goal c-scout-time -1))
#end-if
(defrule
	(up-set-target-object search-local c: 0)
=>
	(up-copy-point temp-x center-x)
	(up-get-point-distance temp-x temp6-x temporary-goal5)
	(up-get-point-distance temp-x self-x temporary-goal4)
