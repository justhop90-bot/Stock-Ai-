(defrule
	(up-pending-placement c: wood-placement-camp)
	(timer-triggered ten-seconds)
	(building-type-count-total wood-placement-camp <= 0)
	(building-type-count-total town-center <= 0)
	(game-time >= 45)
	(up-compare-goal nomad-start >= 2)
=>
	(chat-local-to-self "Resetting lc-placement.")
	(up-release-escrow)
	(up-reset-placement c: wood-placement-camp))


(defrule
	(goal migration-state 1)
	(building-type-count-total wood-placement-camp <= 0)
	(wood-amount < campdock-cost)
(or	(wood-amount < 125)
	(building-type-count-total dock <= 0))
(or	(up-compare-const instant-dock >= 1)
	(building-type-count-total town-center <= 0))
	(unit-type-count-total transport-ship <= 0)
=>
	(up-jump-rule 1))
(defrule
(nand	(resource-found wood)
(and	(up-gaia-type-count-total c: wood s:>= sn-required-forest-tiles)
(and	(unit-type-count villager >= 1)
(and	(up-compare-goal nomad-start >= 2)
(and	(up-gaia-type-count-total c: wood >= 12)
(and	(building-type-count-total town-center <= 0)
(and	(building-type-count-total wood-placement-camp <= 0)
(and	(up-pending-objects c: wood-placement-camp <= 0)
	(up-compare-flag escrow-flag2 != 16777216)))))))))
=>
	(up-jump-rule 8))
