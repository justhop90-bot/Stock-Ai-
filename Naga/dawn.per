(defrule
	(goal sum-villagers 0)
=>
	(set-goal wood-villagers 0)
	(set-goal food-villagers 0)
	(set-goal gold-villagers 0)
	(set-goal stone-villagers 0))

(defrule
(or	(and	(strategic-number sn-current-age > dark)
		(or	(population g:>= max-civ-pop)
			(or	(up-compare-goal custom-civ-pop g:>= desired-civ-pop)
				(or	(civilian-population g:>= desired-civ-pop)
					(civilian-population >= 16)))))
	(building-type-count town-center <= 0))
=>
	(up-jump-rule 2))
(defrule
;	(strategic-number sn-current-age == dark)
	(unit-type-count villager <= 10)
	(up-pending-objects c: house <= 0)
	(up-pending-objects c: town-center <= 0)
	(housing-headroom < 4); 5
	(population-headroom > 0)
	(up-compare-goal total-wood-amount < house-cost)
	(up-compare-goal wood-villagers <= 0)
	(up-compare-goal food-villagers >= 1)
=>
	(up-modify-goal wood-villagers c:+ 1)
	(up-modify-goal food-villagers c:- 1)
	(up-modify-goal temporary-goal g:= wood-villagers)
	(up-modify-goal temporary-goal2 g:= food-villagers)
	(up-modify-goal temporary-goal3 g:= gold-villagers)
	(up-modify-goal temporary-goal4 g:= stone-villagers)
	(up-modify-goal temporary-goal5 g:= temporary-goal)
	(up-modify-goal temporary-goal5 g:+ temporary-goal2)
	(up-modify-goal temporary-goal5 g:+ temporary-goal3)
	(up-modify-goal temporary-goal5 g:+ temporary-goal4)
	(up-modify-goal temporary-goal g:%/ temporary-goal5)
	(up-modify-goal temporary-goal2 g:%/ temporary-goal5)
	(up-modify-goal temporary-goal3 g:%/ temporary-goal5)
	(up-modify-goal temporary-goal4 g:%/ temporary-goal5)
	(up-modify-sn sn-wood-gatherer-percentage g:= temporary-goal)
	(up-modify-sn sn-food-gatherer-percentage g:= temporary-goal2)
	(up-modify-sn sn-gold-gatherer-percentage g:= temporary-goal3)
	(up-modify-sn sn-stone-gatherer-percentage g:= temporary-goal4))
(defrule
;	(strategic-number sn-current-age == dark)
	(unit-type-count villager <= 8)
(or	(up-pending-objects c: house >= 1)
(or	(up-pending-objects c: town-center >= 1)
(or	(housing-headroom >= 4); 5
(or	(population-headroom <= 0)
	(up-compare-goal total-wood-amount >= house-cost)))))
	(up-compare-goal wood-villagers >= 1)
	(up-compare-goal food-villagers < 6)
=>
	(up-modify-goal wood-villagers c:- 1)
	(up-modify-goal food-villagers c:+ 1)
	(up-modify-goal temporary-goal g:= wood-villagers)
	(up-modify-goal temporary-goal2 g:= food-villagers)
	(up-modify-goal temporary-goal3 g:= gold-villagers)
	(up-modify-goal temporary-goal4 g:= stone-villagers)
	(up-modify-goal temporary-goal5 g:= temporary-goal)
	(up-modify-goal temporary-goal5 g:+ temporary-goal2)
	(up-modify-goal temporary-goal5 g:+ temporary-goal3)
	(up-modify-goal temporary-goal5 g:+ temporary-goal4)
	(up-modify-goal temporary-goal g:%/ temporary-goal5)
	(up-modify-goal temporary-goal2 g:%/ temporary-goal5)
	(up-modify-goal temporary-goal3 g:%/ temporary-goal5)
	(up-modify-goal temporary-goal4 g:%/ temporary-goal5)
	(up-modify-sn sn-wood-gatherer-percentage g:= temporary-goal)
	(up-modify-sn sn-food-gatherer-percentage g:= temporary-goal2)
	(up-modify-sn sn-gold-gatherer-percentage g:= temporary-goal3)
	(up-modify-sn sn-stone-gatherer-percentage g:= temporary-goal4)); end jump

(defrule
	(current-age == dark-age)
	(up-research-status c: feudal-age <= research-unavailable)
	(strategic-number sn-current-age >= cimperial)
	(building-type-count-total gold-placement-camp >= 1)
(or	(population g:>= max-civ-pop)
(or	(up-compare-goal custom-civ-pop g:>= desired-civ-pop)
(or	(civilian-population g:>= desired-civ-pop)
	(civilian-population >= 16))))
=>
	(set-goal sum-villagers 0); test
	(up-jump-rule 34))
(defrule
	(strategic-number sn-current-age > dark)
(or	(population g:>= max-civ-pop)
(or	(civilian-population g:>= desired-civ-pop)
	(civilian-population >= 16)))
=>
	(set-goal sum-villagers 0); test
	(up-jump-rule 33))
(defrule
	(building-type-count town-center <= 0)
=>
	(set-goal sum-villagers 0); test
	(set-strategic-number sn-food-gatherer-percentage 100)
	(up-jump-rule 32))
(defrule
	(up-compare-const civilian-percent != 100)
	(unit-type-count-total villager < 12)
	(strategic-number sn-current-age <= dark)
=>
	(set-strategic-number sn-wood-gatherer-percentage 25)
	(set-strategic-number sn-food-gatherer-percentage 75)
	(up-jump-rule 31))

(defrule ; end neg jump
	(up-compare-goal sum-villagers g:< villager-count)
=>
	(set-goal villager-addition 1))

(defrule
	(goal villager-addition 1)
	(housing-headroom < 5); 3
	(population-headroom > 0)
	(up-compare-goal excess-wood < house-cost)
	(up-pending-objects c: house <= 0)
	(up-compare-goal wood-villagers < 2)
	(game-time >= 48)
=>
	(up-modify-goal wood-villagers c:+ 1)
	(up-modify-goal sum-villagers c:+ 1)
	(set-goal villager-addition 0))
(defrule
	(goal villager-addition 1)
(or	(up-compare-goal food-villagers < min-food-villagers)
(or	(building-type-count-total town-center >= 2)
(or	(and	(up-pending-objects c: villager-class <= 0)
		(up-compare-goal total-food-amount < vill-cost))
	(and	(up-compare-goal food-villagers < 7)
		(unit-type-count villager-forager >= 2))))); mill >= 1
	(up-compare-goal food-villagers < 7); 8
=>
	(up-modify-goal food-villagers c:+ 1)
	(up-modify-goal sum-villagers c:+ 1)
	(set-goal villager-addition 0))
(defrule
	(goal villager-addition 1)
	(up-compare-goal wood-villagers >= 2)
	(up-compare-goal food-villagers < 16)
(or	(and	(goal military-choice monk-treb)
		(up-compare-goal wood-villagers >= 8))
(or	(goal strategy sling)
(or	(goal strategy trush)
(or	(and	(goal strategy s-flush)
		(up-compare-goal food-villagers < 7)); 14
(or	(and	(research-available ri-double-bit-axe)
		(up-compare-goal food-villagers < 7)); 8
	(and	(goal feudal-villagers -1)
		(building-type-count-total dock <= 0)))))))
=>
	(up-modify-goal food-villagers c:+ 1)
	(up-modify-goal sum-villagers c:+ 1)
	(set-goal villager-addition 0))
(defrule
	(goal villager-addition 1)
	(up-compare-goal wood-villagers < 4)
(or	(up-compare-goal wood-villagers < 3)
(or	(up-compare-goal food-villagers >= 14)
(or	(and	(building-type-count-total mill >= 2)
		(up-compare-const camp-cost >= 80))
(or	(and	(up-compare-goal strategy-type >= castle-war); dfarms
		(or	(up-compare-goal strategy != besar)
			(game-time >= 67)))
(or	(and	(up-compare-goal strategy == maa-opener)
		(up-compare-goal farm-count-total >= 1))
	(up-compare-goal strategy == drush))))))
=>
	(up-modify-goal wood-villagers c:+ 1)
	(up-modify-goal sum-villagers c:+ 1)
	(set-goal villager-addition 0))


(defrule
(or	(and	(up-compare-goal strategy != drush)
		(up-compare-flag micro-flag != f-drush-micro))
	(up-compare-goal essential-soldiercount < 3))
=>
	(up-jump-rule 3))
(defrule
	(building-type-count-total barracks >= 1)
	(up-compare-goal gold-villagers <= 0)
	(up-compare-goal dead-villagers <= 0)
(or	(unit-type-count-total militiaman-line g:< train-champ); essential-soldiercount
	(unit-type-count-total champi-line g:< train-champi))
(or	(and	(unit-available militiaman-line)
		(or	(gold-amount < 60)
			(and	(up-research-status c: ri-loom < research-pending)
				(gold-amount < 110))))
	(and	(unit-available champi-line)
		(or	(gold-amount < 75)
			(and	(up-research-status c: ri-loom < research-pending)
				(gold-amount < 125)))))
=>
	(up-modify-sn sn-maximum-gold-drop-distance c:max 16)
	(up-modify-goal gold-villagers c:+ 1)
	(up-modify-goal food-villagers c:- 1)
	(up-jump-rule 2)
	(disable-self))
(defrule
	(up-compare-goal gold-villagers >= 1)
(or	(and	(unit-type-count-total militiaman-line g:>= train-champ)
		(unit-type-count-total champi-line g:>= train-champi))
(or	(and	(unit-available militiaman-line)
		(gold-amount >= 110))
(or	(and	(unit-type-count-total militiaman-line >= 1)
		(gold-amount >= 90))
(or	(and	(unit-type-count-total militiaman-line >= 2)
		(gold-amount >= 70))
(or	(and	(unit-available champi-line)
		(gold-amount >= 125))
(or	(and	(unit-type-count-total champi-line >= 1)
		(gold-amount >= 100))
	(and	(unit-type-count-total champi-line >= 2)
		(gold-amount >= 75))))))))
=>
	(up-modify-sn sn-maximum-gold-drop-distance c:min 8); 6
	(up-modify-goal gold-villagers c:- 1)
	(up-modify-goal sum-villagers c:- 1)
	(set-goal villager-addition 1))
(defrule
	(up-compare-goal gold-villagers >= 1)
	(up-research-status c: ri-loom >= research-pending)
(or	(and	(unit-available militiaman-line)
		(gold-amount >= 60))
(or	(and	(unit-type-count-total militiaman-line >= 1)
		(gold-amount >= 40))
(or	(and	(unit-type-count-total militiaman-line >= 2)
		(gold-amount >= 20))
(or	(and	(unit-available champi-line)
		(gold-amount >= 75))
(or	(and	(unit-type-count-total champi-line >= 1)
		(gold-amount >= 50))
	(and	(unit-type-count-total champi-line >= 2)
		(gold-amount >= 25)))))))
=>
	(up-modify-sn sn-maximum-gold-drop-distance c:min 8); 6
	(up-modify-goal gold-villagers c:- 1)
	(up-modify-goal sum-villagers c:- 1)
	(set-goal villager-addition 1)); end jump

