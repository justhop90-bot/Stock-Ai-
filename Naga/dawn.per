	(up-compare-goal food-villagers >= 12))
	(up-compare-goal wood-villagers < 8)
(or	(up-compare-goal wood-villagers < 7)
	(up-compare-goal food-villagers >= 14))
(or	(up-compare-goal wood-villagers < 5)
	(up-compare-goal feudal-villagers >= 0))
=>
