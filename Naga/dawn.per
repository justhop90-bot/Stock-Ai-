)
(defrule
	(goal villager-addition 1)
	(up-compare-goal strategy-type >= castle-war)
	(up-compare-goal food-villagers >= 14)
(or	(up-compare-goal food-villagers >= 14); 15
	(goal strategy fast-imp))
	(up-compare-goal wood-villagers g:< temporary-goal10)
(or	(and	(and	(up-compare-goal military-choice != kecil)
				(and	(up-compare-goal military-choice != monk-treb)
					(and	(up-compare-goal military-choice != klew)
						(and	(up-compare-goal military-choice != syl-rush)
							(up-compare-goal military-choice != castledrop)))))
		(not	(civ-selected khmer)))
	(up-compare-goal wood-villagers g:< temporary-goal9))
=>
	(up-modify-goal wood-villagers c:+ 1)
	(up-modify-goal sum-villagers c:+ 1)
