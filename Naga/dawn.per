(defrule
	(goal villager-addition 1)
(or	(goal strategy castledrop)
	(goal military-choice monk-treb))
	(up-compare-goal strategy-type >= castle-war)
	(up-compare-goal stone-villagers < 2); 3
	(up-compare-goal food-villagers >= 14)
(or	(up-compare-goal food-villagers >= 14); 15
	(goal military-choice monk-treb))
(or	(dropsite-min-distance stone <= 5)
(or	(up-compare-goal wood-villagers g:>= temporary-goal10); 9
(or	(building-type-count-total mining-camp >= 2)
