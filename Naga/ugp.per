(defrule; dyng 2
(or	(and	(population g:< max-civ-pop)
		(and	(up-compare-goal custom-civ-pop g:< desired-civ-pop)
			(and	(civilian-population g:< desired-civ-pop)
				(civilian-population < 16))))
(or	(up-timer-status retask-timer != timer-triggered)
	(building-type-count-total town-center <= 0)))
=>
	(up-jump-rule 243))
(defrule
	(true)
=>
	(up-get-rule-id temporary-goal16)
	(up-modify-goal temporary-goal16 c:+ 1)
	(up-jump-rule 2))
(defrule
(or	(up-compare-goal temporary-goal17 == -1)
(or	(up-compare-goal temporary-goal18 <= 0)
	(up-compare-goal temporary-goal6 <= -1)))
=>
	(up-chat-data-to-self "Skipping unit: %d" g: temporary-goal17)
	(up-chat-data-to-self "Skipping: %d" g: temporary-goal18)
	(up-chat-data-to-self "Skipping: %d" g: temporary-goal6)
	(up-jump-direct g: temporary-goal20))
(defrule
	(true)
=>
	(up-setup-cost-data 1 temp-cost-food)
	(up-add-object-cost g: temporary-goal17 c: 1)
;	(up-chat-data-to-all "temp-cost-wood: %d" g: temp-cost-wood)
;	(up-chat-data-to-all "temp-cost-food: %d" g: temp-cost-food)
;	(up-chat-data-to-all "temp-cost-gold: %d" g: temp-cost-gold)
	(up-modify-goal temp-cost-wood g:* temporary-goal18)
	(up-modify-goal temp-cost-food g:* temporary-goal18)
	(up-modify-goal temp-cost-gold g:* temporary-goal18)
	(up-modify-goal temp-cost-wood c:/ 100)
	(up-modify-goal temp-cost-food c:/ 100)
	(up-modify-goal temp-cost-gold c:/ 100)
;	(up-chat-data-to-all "temp-cost-wood: %d" g: temp-cost-wood)
;	(up-chat-data-to-all "temp-cost-food: %d" g: temp-cost-food)
;	(up-chat-data-to-all "temp-cost-gold: %d" g: temp-cost-gold)
	(up-modify-goal temp-cost-food g:%/ temporary-goal6)
	(up-modify-goal temp-cost-wood g:%/ temporary-goal6)
	(up-modify-goal temp-cost-gold g:%/ temporary-goal6)
	(up-modify-goal temporary-goal2 g:+ temp-cost-wood)
	(up-modify-goal temporary-goal3 g:+ temp-cost-food)
	(up-modify-goal temporary-goal4 g:+ temp-cost-gold)
	(up-jump-direct g: temporary-goal20)); end mini jump
(defrule
	(true)
=>
	(set-goal temporary-goal 0)
	(set-goal temporary-goal2 0)
	(set-goal temporary-goal3 0)
	(set-goal temporary-goal4 0)
	(set-goal temporary-goal5 20)
	(set-goal temporary-goal10 0)
	(up-modify-goal temporary-goal11 g:= custom-civ-pop-total)
	(up-modify-goal temporary-goal11 c:%* 9)
	(up-modify-goal temporary-goal11 c:max 1))
(defrule
	(unit-type-count-total villager g:< train-villager)
	(unit-available villager)
	(building-type-count town-center >= 1)
=>
	(set-goal temporary-goal17 villager)
	(up-modify-goal temporary-goal18 g:= temporary-goal7)
	(up-modify-goal temporary-goal18 c:/ VILLAGER-TIME)
	(up-get-fact building-type-count-total town-center temporary-goal20)
	(up-modify-goal temporary-goal18 g:* temporary-goal20)
	(up-modify-goal temporary-goal19 g:= train-villager)
	(up-modify-goal temporary-goal19 g:- villager-count-total)
	(up-modify-goal temporary-goal19 c:* 100)
	(up-modify-goal temporary-goal18 g:min temporary-goal19)
	(up-get-rule-id temporary-goal20)
	(up-modify-goal temporary-goal20 c:+ 1)
;	(up-chat-data-to-all "goal18: %d" g: temporary-goal18)
;	(up-chat-data-to-all "goal19: %d" g: temporary-goal19)
	(up-jump-direct g: temporary-goal16))
