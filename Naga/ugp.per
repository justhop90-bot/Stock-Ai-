;	(up-chat-data-to-all "temp-cost-wood: %d" g: temp-cost-wood)
;	(up-chat-data-to-all "temp-cost-food: %d" g: temp-cost-food)
;	(up-chat-data-to-all "temp-cost-gold: %d" g: temp-cost-gold)
	(up-modify-goal temp-cost-wood g:* temporary-goal6)
	(up-modify-goal temp-cost-food g:* temporary-goal6)
	(up-modify-goal temp-cost-gold g:* temporary-goal6)
	(up-modify-goal temp-cost-wood c:/ 50)
	(up-modify-goal temp-cost-food c:/ 50)
	(up-modify-goal temp-cost-gold c:/ 50)
	(up-modify-goal temporary-goal2 g:+ temp-cost-wood)
	(up-modify-goal temporary-goal3 g:+ temp-cost-food)
	(up-modify-goal temporary-goal4 g:+ temp-cost-gold)
	(up-jump-direct g: temporary-goal20)); end mini jump
