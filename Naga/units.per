(or	(population g:< del-civ-pop)
(or	(and	(players-building-count every-enemy <= 0)
		(and	(goal under-attack no)
			(up-compare-goal e-biggest-navy <= 0)))
(or	(up-research-status c: imperial-age == research-pending)
	(unit-type-count-total fishing-ship-class g:< train-fish)))))))
=>
	(up-jump-rule 4))
(defrule
(or	(unit-type-count-total fishing-ship-class >= 2)
	(building-type-count-total fish-trap <= 0))
	(up-compare-flag delete-flag == 1)
=>
	(up-modify-flag delete-flag c:- 1)
	(up-modify-flag delete-flag c:+ 128)
