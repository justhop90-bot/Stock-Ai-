	(up-modify-goal temporary-goal3 g:+ temporary-goal4);
	(up-modify-goal temporary-goal4 c:= -20)
	(up-modify-goal temporary-goal4 s:* sn-military-superiority)
	(up-modify-goal temporary-goal4 c:+ 100)
	(up-modify-goal temporary-goal4 c:max 50)
	(up-modify-goal temporary-goal4 c:min 150)
	(up-modify-goal temporary-goal g:%* temporary-goal4)
	(up-modify-goal temporary-goal2 g:%* temporary-goal4)
	(up-modify-goal temporary-goal3 g:%* temporary-goal4)
	(up-modify-goal temporary-goal g:min allowed-num-military)
	(up-modify-goal temporary-goal2 g:min allowed-num-military)
	(up-modify-goal temporary-goal3 g:min allowed-num-military))
