;	(goal military-choice besar)
;(nor	(strategic-number sn-archers >= 15)
;(or	(strategic-number sn-cavalry >= 25)
;(or	(strategic-number sn-monks >= 10)
;(or	(strategic-number sn-gunpowder >= 15)
;	(players-unit-type-count focus-player teutonic-knight-line > 5)))))
;	(goal enemy-strategy det-flush)
