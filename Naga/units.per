(defrule
	(unit-type-count-total fishing-ship-class g:>= train-fish)
	(up-compare-goal pond-fishing <= 1)
(or	(and	(up-compare-flag starting-dropsite-flag != f-dock)
		(up-compare-goal map-type <= type-land))
(or	(and	(up-compare-goal custom-civ-pop-total g:>= min-number-vills)
		(building-type-count-total dock <= 0))
(or	(up-compare-goal under-attack != no)
(or	(up-compare-goal dead-villagers >= 1)
(or	(and	(up-compare-goal enemy-boats != no)
		(or	(up-compare-goal enemy-age >= dfeudal)
			(players-current-age any-enemy >= feudal-age)))
(or	(up-compare-goal custom-civ-pop-total g:>= desired-civ-pop)
	(population g:>= max-civ-pop)))))))
=>
	(up-jump-rule 7))
(defrule
	(unit-type-count-total fishing-ship-class g:>= train-fish)
(or	(building-type-count dock <= 0)
(or	(and	(cc-players-unit-type-count 0 shore-fish-class <= 0)
		(cc-players-unit-type-count 0 ocean-fish-class <= 0))
(or	(not	(can-afford-unit fishing-ship))
(or	(not	(unit-available fishing-ship))
(or	(up-idle-unit-count idle-type-fishing-ship >= 1)
(or	(building-type-count-total town-center <= 0)
	(and	(building-type-count-total lumber-camp <= 0)
		(and	(building-type-count-total mule-cart <= 0)
			(and	(building-type-count-total settlement <= 0)
				(or	(up-compare-flag starting-dropsite-flag == f-lumber)
					(dropsite-min-distance wood >= 6)))))))))))
=>
	(up-jump-rule 6))
(defrule
	(unit-type-count-total fishing-ship-class g:>= train-fish)
(or	(population g:>= max-civ-pop)
(or	(up-compare-goal custom-civ-pop-total g:>= desired-civ-pop)
	(and	(up-compare-goal pond-fishing >= 2)
		(and	(building-available fish-trap)
			(up-compare-goal excess-wood < 175)))))
=>
	(up-jump-rule 5))
(defrule
	(true)
=>
	(up-modify-goal temporary-goal2 s:= sn-focus-player-number)
	(set-strategic-number sn-focus-player-number my-player-number)
	(set-goal temporary-goal3 36)
	(up-modify-goal temporary-goal3 s:max sn-maximum-town-size)
	(up-modify-goal temporary-goal3 s:max sn-lumber-camp-max-distance)
	(up-modify-goal temporary-goal3 s:max sn-mining-camp-max-distance)
	(up-full-reset-search)
	(up-filter-distance c: -1 g: temporary-goal3)
	(up-find-local c: dock c: 20)
	(up-remove-objects search-local object-data-under-attack >= 1)
	(up-remove-objects search-local object-data-progress-value >= 1)
	(set-goal temporary-goal 0)
	(set-goal temporary-goal3 0))
(defrule ; end neg jump
	(up-set-target-object search-local g: temporary-goal)
=>
	(up-get-point position-object temp-x)
	(up-set-target-point temp-x)
	(up-reset-filters)
	(up-filter-distance c: -1 c: 16)
	(up-find-remote c: fishing-ship c: 20)
	(up-find-remote c: oystering-ship c: 20)
	(up-find-remote c: whaling-ship c: 20)
	(up-get-search-state local-total)
	(up-modify-goal temporary-goal3 g:= remote-total)
	(up-reset-search 0 0 1 1)
	(up-filter-status c: status-gather c: list-active)
	(up-find-resource c: shore-fish-class c: 10)
	(up-find-resource c: ocean-fish-class c: 10)
	(up-get-search-state local-total))
(defrule
	(up-set-target-object search-local g: temporary-goal)
	(up-compare-goal remote-total >= 1)
	(up-compare-goal temporary-goal3 g:< remote-total)
;	(up-can-train 0 c: fishing-ship)
=>
	(up-modify-goal temporary-goal4 s:= sn-dock-training-filter)
	(set-strategic-number sn-dock-training-filter 0)
	(up-remove-objects search-local object-data-index g:!= temporary-goal)
	(up-target-point 0 action-train c: fishing-ship)
	(up-modify-sn sn-dock-training-filter g:= temporary-goal4)
	(up-jump-rule 1))
(defrule
	(up-set-target-object search-local g: temporary-goal)
=>
	(up-modify-goal temporary-goal c:+ 1)
	(up-jump-rule -3))
(defrule
	(true)
=>
	(up-modify-sn sn-focus-player-number g:= temporary-goal2)); end jump
