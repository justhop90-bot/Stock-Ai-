	(up-compare-goal e-biggest-navy < 4)
	(players-building-type-count any-enemy dock >= 1)
	(unit-type-count-total demolition-ship-line < 3)
(or	(up-compare-const extra-water-focus == 1)
	(and	(up-set-target-object search-local c: 0)
		(or	(up-point-terrain temp-x == terrain-walkable-shallows-mangrove)
			(up-point-terrain temp-x == terrain-forest-mangrove))))
=>
	(up-modify-goal train-demo c:max 3))
(defrule
	(true)
=>
