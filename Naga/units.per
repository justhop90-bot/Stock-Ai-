#end-if
#load-if-defined FEUDAL-AGE-END
(defrule
	(goal military-choice besar)
(or	(up-compare-goal custom-civ-pop g:>= desired-civ-pop)
(or	(population g:>= max-civ-pop)
	(food-amount >= maa-buffer-f)))
	(strategic-number sn-archers < 32)
	(strategic-number sn-cavalry < 48)
	(strategic-number sn-monks < 12)
	(strategic-number sn-gunpowder < 32)
	(players-unit-type-count focus-player teutonic-knight-line < 12)
	(strategic-number sn-current-age >= imperial)
	(up-compare-goal excess-gold >= 100)
=>
	(up-modify-goal train-champ g:max allowed-num-military))
(defrule
	(goal military-choice besar)
