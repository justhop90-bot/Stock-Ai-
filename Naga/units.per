;	(unit-type-count-total champi-line < 18)
;=>
;	(up-modify-goal train-champi g:max allowed-num-military))

(defrule
(or	(strategic-number sn-husks < 6)
(or	(up-compare-goal military-choice != besar)
(or	(strategic-number sn-monks >= 7)
(or	(strategic-number sn-ranged >= 6)
(or	(strategic-number sn-cavalry >= 6)
(or	(and	(building-type-count monastery >= 1)
		(unit-type-count-total monastery-class g:< train-monk))
	(strategic-number sn-current-age >= imperial)))))))
=>
	(up-jump-rule 2))
(defrule
(or	(and	(building-type-count castle >= 1)
		(and	(unit-type-count-total my-unique-unit-line g:< train-unique)
			(or	(up-compare-const uu-type == infantry-uu)
				(up-compare-const uu-type == cavalry-uu))))
	(and	(building-type-count stable >= 1)
		(or	(unit-type-count-total knight-unit g:< train-knight)
			(or	(unit-type-count-total steppe-lancer-line g:< train-steppe)
				(unit-type-count-total battle-elephant-line g:< train-battle)))))
=>
	(up-jump-rule 1))
(defrule
	(strategic-number sn-current-age >= fcastlea)
	(goal player-position flank)
(or (up-compare-const syl-rush-affinity >= 200)
(or	(up-compare-const dm-unit == champi-line)
	(up-compare-const ELITE-CHAMPI-WARRIOR-AVAILABLE == YES)))
	(strategic-number sn-military-superiority <= -1)
=>
;	(chat-local-to-self "Anti-Husks.")
	(up-modify-goal train-champi g:max allowed-num-military)); end jump

(defrule
(or	(and	(up-compare-goal enemy-strategy2 != klew)
		(strategic-number sn-shock-infantry < 12))
(or	(strategic-number sn-shock-infantry < 3)
(or	(strategic-number sn-monks >= 7)
(or	(strategic-number sn-ranged >= 6)
(or	(strategic-number sn-cavalry >= 2); :'D
(or	(strategic-number sn-husks >= 2); hmm 11
	(strategic-number sn-current-age >= cimperial)))))))
=>
	(up-jump-rule 2))
(defrule
(or	(and	(building-type-count castle >= 1); 2
		(and	(or	(goal military-choice castledrop)
					(unit-type-count-total my-unique-unit-line g:< train-unique))
			(or	(up-compare-const uu-type == infantry-uu)
				(and	(players-unit-type-count focus-player fire-lancer-line < 9)
					(up-compare-const uu-type == cavalry-uu)))))
;(or	(up-compare-goal military-choice != besar)
	(and	(players-unit-type-count focus-player fire-lancer-line < 9)
		(or	(goal strategy chonkers)
			(or	(goal strategy steppe-rush)
				(goal strategy krush)))));)
=>
	(up-jump-rule 1))
(defrule
	(strategic-number sn-military-superiority <= 0)
(or	(goal under-attack yes)
	(food-amount >= champi-buffer-f))
(or	(unit-type-count-total champi-line < 12)
(or	(goal under-attack yes)
	(strategic-number sn-military-superiority <= -1)))
(or	(strategic-number sn-current-age >= fcastlea)
(or	(strategic-number sn-military-superiority <= -2)
	(up-compare-goal total-food-amount < castle-f2)))
=>
;	(chat-local-to-self "Anti-Eagles.")
	(up-modify-goal train-champi g:max allowed-num-military)); end jump

(defrule
(or	(strategic-number sn-shock-infantry < 10)
(or	(unit-type-count-total archery-cannon-class >= 7)
(or	(unit-type-count-total slinger >= 7)
(or	(unit-type-count-total cavalry-cannon-class >= 7)
(or	(and	(players-unit-type-count focus-player fire-lancer-line < 9)
		(or	(up-compare-flag power-unit-flag == f-paladin)
			(or	(up-compare-flag power-unit-flag == f-battle-elephant)
				(up-compare-flag power-unit-flag == f-steppe-lancer))))
(or	(up-compare-flag power-unit-flag == f-hand-cannoneer)
	(and	(up-compare-flag power-unit-flag == f-unique)
		(and	(up-compare-const uu-type != archer-uu)
			(or	(players-unit-type-count focus-player fire-lancer-line < 9)
				(up-compare-const uu-type != cavalry-uu))))))))))
=>
	(up-jump-rule 1))
(defrule ; eagle counters for the ones who may need it
	(goal military-choice besar)
	(strategic-number sn-current-age >= cimperial)
	(up-compare-goal enemy-age >= imperial)
	(up-research-status c: ri-elite-champi-warrior >= research-available)
	(strategic-number sn-military-superiority <= 0)
	(unit-type-count-total champi-line s:< sn-shock-infantry)
	(strategic-number sn-archers < 48)
	(players-unit-type-count focus-player jaguar-warrior-line < 6)
=>
	(up-modify-goal train-champi g:max allowed-num-military))

(defrule
	(up-research-status c: imperial-age >= research-pending)
	(up-compare-flag power-unit-flag != 65536)
	(up-compare-const syl-rush-affinity <= 300); 2
=>
	(up-jump-rule 3))
(defrule
(or	(population g:>= max-civ-pop)
(or	(and	(up-research-status c: imperial-age >= research-pending)
		(and	(building-type-count castle >= 1)
			(up-compare-flag power-unit-flag == f-unique)))
(or	(strategic-number sn-team-superiority >= 2)
	(and	(strategic-number sn-military-superiority >= 0)
		(military-population >= 30)))))
=>
	(up-jump-rule 2))
(defrule
(or	(up-compare-const syl-rush-affinity <= 100)
(or	(strategic-number sn-military-superiority >= 0); 1
(or	(current-age >= imperial-age)
(or	(building-type-count barracks < 1)
(or	(up-compare-goal military-choice != besar)
(or	(strategic-number sn-archers >= 48)
(or	(strategic-number sn-siege >= 12)
	(strategic-number sn-monks >= 10))))))))
=>
	(up-jump-rule 1))
(defrule
	(up-research-status c: ri-champi-warrior >= research-pending)
(or	(strategic-number sn-military-superiority <= -2)
(or	(up-pending-objects c: villager >= 2)
	(up-compare-goal excess-food >= champi-buffer-f)))
(or	(unit-type-count-total champi-line < 30)
	(up-compare-flag power-unit-flag == 65536))
=>
	(up-modify-goal train-champi g:max allowed-num-military)); end jump
;=========================================================
(defrule
(or	(up-compare-goal military-choice != besar)
(or	(not	(unit-available champi-line))
(or	(strategic-number sn-skirms < 12)
(or	(strategic-number sn-cavalry >= 8)
(or	(strategic-number sn-infantry >= 8)
(or	(strategic-number sn-spears >= 8)
(or	(strategic-number sn-archers >= 8)
(or	(strategic-number sn-husks >= 8)
	(strategic-number sn-shock-infantry >= 8)))))))))
=>
	(up-jump-rule 2))
(defrule
(or	(and	(up-compare-goal excess-gold < 250)
		(strategic-number sn-military-superiority >= 0))
(or	(strategic-number sn-cavalry s:>= sn-skirms)
(or	(strategic-number sn-infantry s:>= sn-skirms)
(or	(unit-type-count-total mangonel-unit s:>= sn-skirms)
(or	(unit-type-count-total scorpion-unit s:>= sn-skirms)
(or	(unit-type-count-total bombard-cannon-line s:>= sn-skirms)
(or	(unit-type-count-total cavalry-class s:>= sn-skirms)
(or	(unit-type-count-total scout-cavalry-class s:>= sn-skirms)
	(unit-type-count-total infantry-class s:>= sn-skirms)))))))))
=>
	(up-jump-rule 1))
(defrule
	(up-train-site-ready c: champi-scout)
(or	(goal player-position flank)
	(up-compare-goal target-distance < 45))
=>
	(up-modify-goal train-champi s:max sn-skirms)); end jumps
;=========================================================
(defrule
	(false)
	(goal under-attack no)
	(up-compare-goal dead-villagers <= 1)
;	(up-compare-goal nomad-start >= 1)
	(up-compare-goal map-type < type-islands)
;	(up-compare-goal scout-count >= 1)
(or	(players-building-count every-enemy <= 0)
	(and	(up-resource-amount amount-exploration < 25); 20
		(and	(strategic-number sn-current-age <= feudal)
			(and	(goal under-attack no)
				(up-compare-goal dead-villagers <= 0)))))
	(unit-type-count 2 <= 0);
	(military-population <= 0)
(not	(up-set-target-by-id g: scouting-unit))
(or	(game-time < 600)
	(strategic-number sn-current-age <= dfeudal))
	(goal under-attack no)
(or	(food-amount >= 550)
	(strategic-number sn-current-age >= dfeudal))
	(unit-type-count-total spearman-line <= 0)
	(unit-type-count-total champi-line <= 0)
	(unit-type-count-total militiaman-line <= 0)
=>
	(up-modify-goal train-champi c:max 1)
	(disable-self))
;=========================================================
; Early DM
;=========================================================
(defrule
	(up-compare-const dm-game == 1)
	(strategic-number sn-current-age < castlea)
(or	(strategic-number sn-military-superiority <= 0)
	(strategic-number sn-team-superiority <= 0))
	(up-compare-goal excess-food >= 2250)
	(up-compare-goal excess-gold >= 1000)
	(unit-type-count-total spearman-line g:>= train-pike)
	(unit-type-count-total eagle-scout-line g:>= train-eagle)
=>
	(up-modify-goal train-champ g:max allowed-num-military))
(defrule
	(up-compare-const dm-game == 1)
	(strategic-number sn-current-age < castlea)
(or	(strategic-number sn-military-superiority <= 0)
	(strategic-number sn-team-superiority <= 0))
;(or	(goal enemy-boats yes)
	(up-compare-goal navy-count-total < min-navy);)
	(up-compare-goal excess-food >= 4500)
	(up-compare-goal excess-gold >= 1500)
	(unit-type-count-total fire-galley-line g:>= train-fire-galley)
	(unit-type-count-total demolition-ship-line g:>= train-demo)
=>
	(up-modify-goal train-galley g:max allowed-num-military))
;=========================================================
; Trash
;=========================================================
(defrule
	(goal military-choice besar)
	(civ-selected persian)
	(up-research-status c: ri-boiling-oil == research-complete)
	(up-compare-goal excess-wood >= 275)
(or	(up-compare-goal excess-gold < 325)
(or	(and	(up-compare-goal trade-units < 24)
		(up-compare-goal relic-count < 6))
(or	(commodity-selling-price wood < 32)
	(strategic-number sn-spears >= 15))))
(or	(strategic-number sn-infantry >= 10)
	(and	(population g:< max-civ-pop)
		(or	(and	(up-train-site-ready c: archer)
				(strategic-number sn-military-superiority <= -2))
			(or	(strategic-number sn-skirms < 36)
				(or	(unit-type-count-total mangonel-unit >= 4)
					(or	(up-compare-goal scorpion-unit-count-total >= 6)
						(or	(unit-type-count-total bombard-cannon-line >= 8)
							(unit-type-count cavalry-class >= 12))))))))
=>
	(up-modify-goal train-archer g:max allowed-num-military))
;=========================================================
(defrule
(or	(up-compare-goal military-choice != besar)
(or	(and	(up-gaia-type-count c: gold >= 9)
		(cc-players-unit-type-count 0 gold-mine >= 9))
(or	(players-unit-type-count focus-player cataphract-line >= 10)
(or	(players-unit-type-count focus-player teutonic-knight-line >= 10)
(or	(players-unit-type-count focus-player jaguar-warrior-line >= 10)
	(strategic-number sn-monks >= 18))))))
=>
	(up-jump-rule 1))
(defrule
	(up-research-status c: ri-forced-levy == research-complete)
	(up-research-status c: ri-long-swordsman >= research-pending)
(or	(up-research-status c: ri-two-handed-swordsman >= research-pending)
	(up-compare-goal excess-food >= 270))
(or	(strategic-number sn-archers < 40)
(or	(unit-type-count-total mangonel-unit >= 5)
(or	(up-compare-goal scorpion-unit-count-total >= 7)
(or	(unit-type-count-total bombard-cannon-line >= 9)
	(unit-type-count-total skirmisher-line >= 30)))))
=>
	(up-modify-goal train-champ g:max allowed-num-military)); end jump
;=========================================================
(defrule
	(goal military-choice besar)
	(up-compare-goal excess-gold < 325)
(or	(and	(up-compare-goal trade-units < 24)
		(up-compare-goal relic-count < 8))
	(cc-players-unit-type-count 0 tree-class < 150))
(or	(and	(up-gaia-type-count c: gold <= 6)
		(game-time >= 120))
(or	(cc-players-unit-type-count 0 gold-mine <= 6)
