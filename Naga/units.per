(or	(civ-selected mapuche)
(or	(civ-selected muisca)
	(civ-selected tupi))))
=>
	(up-jump-rule 7))
(defrule
(or	(up-compare-flag power-unit-flag == 65536)
(or	(players-unit-type-count focus-player teutonic-knight-line >= 15); 13
(or	(and	(strategic-number sn-archers >= 60); 48
		(not	(civ-selected incan)))
(or	(strategic-number sn-gunpowder >= 42)
(or	(strategic-number sn-monks >= 15); 13
(or	(up-compare-goal strategy == stonewall)
(or	(not	(unit-available champi-line))
	(strategic-number sn-current-age < cimperial))))))))
=>
	(up-jump-rule 6))
(defrule
	(goal strategy fast-imp)
	(up-compare-goal custom-civ-pop < 64)
=>
	(up-jump-rule 5))
(defrule
	(civ-selected incan)
	(up-compare-flag power-unit-flag != f-condottiero)
(or	(up-compare-flag power-unit-flag != f-unique)
(or	(up-compare-goal trade-units >= 32)
	(up-compare-goal relic-count >= 8)))
=>
	(up-modify-flag power-unit-flag c:+ 65536)
	(up-jump-rule 4))
(defrule
	(civ-selected mapuche)
	(up-compare-flag power-unit-flag != f-condottiero)
(or	(and	(up-compare-flag power-unit-flag != f-unique)
		(up-compare-flag power-unit-flag != f-cavalry-archer))
(or	(up-compare-goal trade-units >= 32)
	(up-compare-goal relic-count >= 8)))
=>
	(up-modify-flag power-unit-flag c:+ 65536)
	(up-jump-rule 3))
(defrule
	(civ-selected muisca)
	(up-compare-flag power-unit-flag != f-condottiero)
(or	(and	(up-compare-flag power-unit-flag != f-unique)
		(and	(up-compare-flag power-unit-flag != f-arbalester)
			(up-compare-flag power-unit-flag != 262144)))
(or	(up-compare-goal trade-units >= 32)
(or	(up-compare-goal relic-count >= 8)
	(and	(up-compare-flag power-unit-flag != 262144)
		(or	(strategic-number sn-shock-infantry >= 20)
			(strategic-number sn-husks >= 16))))))
=>
	(up-modify-flag power-unit-flag c:+ 65536)
	(up-jump-rule 2))
(defrule
	(civ-selected tupi)
	(up-compare-flag power-unit-flag != f-condottiero)
(or	(and	(up-compare-flag power-unit-flag != f-unique)
		(and	(up-compare-flag power-unit-flag != f-arbalester)
			(up-compare-flag power-unit-flag != 131072)))
(or	(up-compare-goal trade-units >= 32)
(or	(up-compare-goal relic-count >= 8)
	(and	(up-compare-flag power-unit-flag != 131072)
		(or	(strategic-number sn-shock-infantry >= 24)
			(strategic-number sn-husks >= 16))))))
=>
	(up-modify-flag power-unit-flag c:+ 65536)
	(up-jump-rule 1))
(defrule
	(goal power-unit-flag 0)
	(strategic-number sn-current-age >= cimperial)
(or	(up-research-status c: ri-champi-warrior >= research-pending)
(or	(unit-type-count-total champi-line >= 6)
	(and	(current-age >= imperial-age)
		(current-age-time >= 5))))
=>
	(up-modify-flag power-unit-flag c:+ 65536)); end jumps

(defrule
;	(civ-selected incan)
	(up-compare-flag power-unit-flag == 65536)
	(up-compare-flag power-unit-flag == f-unique)
	(current-age <= castle-age)
	(strategic-number sn-current-age <= castlea)
	(up-research-status c: ri-champi-warrior <= research-available)
;(or
;(or	(building-type-count-total castle >= 1)
;	(stone-amount >= castle-stone)))
=>
	(up-modify-flag power-unit-flag c:- 65536))
(defrule
	(goal strategy stonewall)
	(up-compare-flag power-unit-flag == 65536)
	(current-age <= castle-age)
(or	(strategic-number sn-current-age <= castlea)
	(up-research-status c: imperial-age <= research-available))
	(up-research-status c: ri-champi-warrior <= research-available)
=>
	(up-modify-flag power-unit-flag c:- 65536))

(defrule
(or	(up-compare-flag power-unit-flag != 65536)
(or	(up-compare-goal military-choice != besar)
(or	(strategic-number sn-current-age < cimperial)
(or	(strategic-number sn-monks >= 15)
(or	(players-unit-type-count focus-player teutonic-knight-line >= 12)
	(players-unit-type-count focus-player jaguar-warrior-line >= 12))))))
=>
	(up-jump-rule 2))
(defrule
(nor	(up-research-status c: ri-elite-champi-warrior >= research-pending)
	(and	(up-compare-goal excess-food >= 700)
		(up-compare-goal excess-gold >= 475)))
=>
	(up-jump-rule 1))
(defrule
;	(up-compare-goal excess-gold >= 245)
(or	(strategic-number sn-archers < 50)
(or	(and	(strategic-number sn-gunpowder < 50)
		(civ-selected malian))
(or	(unit-type-count-total mangonel-unit >= 6)
(or	(up-compare-goal scorpion-unit-count-total >= 8)
(or	(unit-type-count-total bombard-cannon-line >= 10)
	(unit-type-count-total skirmisher-line >= 30))))))
=>
	(up-modify-goal train-champi g:max allowed-num-military)); end jump
;=========================================================
