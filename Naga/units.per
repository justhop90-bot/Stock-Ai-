#load-if-not-defined DIFFICULTY-EASIEST
#load-if-not-defined DIFFICULTY-EASY
#load-if-not-defined DIFFICULTY-MODERATE
#load-if-defined POST-IMPERIAL-AGE-START
(defrule
(or	(game-time >= 600)
(or	(up-compare-const dm-game != 1)
(or	(up-compare-const migration-style == 1)
(or	(population g:>= max-civ-pop)
(or	(up-compare-goal custom-civ-pop-total g:>= desired-civ-pop)
(or	(up-compare-goal excess-wood < 1600)
(or	(up-compare-goal excess-food < 1600)
	(up-compare-goal excess-gold < 1600))))))))
=>
	(up-jump-rule 3))
(defrule
	(goal enough-siege yes)
(or	(up-compare-const infinite-resources == yes)
(or	(and	(game-time < 90)
		(strategic-number sn-military-superiority < 4))
(or	(and	(game-time < 180)
		(strategic-number sn-military-superiority < 3))
(or	(and	(game-time < 270)
		(strategic-number sn-military-superiority < 2))
	(and	(game-time < 360)
		(strategic-number sn-military-superiority < 1))))))
	(up-can-train 0 c: dm-unit)
=>
	(train dm-unit)
	(up-jump-rule 1))
(defrule
	(up-compare-const dm-unit == temple-guard-line)
	(goal enough-siege yes)
(or	(up-compare-const infinite-resources == yes)
(or	(and	(game-time < 90)
		(strategic-number sn-military-superiority < 4))
(or	(and	(game-time < 180)
		(strategic-number sn-military-superiority < 3))
(or	(and	(game-time < 270)
		(strategic-number sn-military-superiority < 2))
	(and	(game-time < 360)
		(strategic-number sn-military-superiority < 1))))))
	(unit-available dm-unit)
	(can-afford-unit dm-unit)
=>
	(up-full-reset-search)
	(up-find-local c: monastery c: 240)
	(up-remove-objects search-local object-data-progress-value >= 1)
	(up-remove-objects search-local object-data-under-attack >= 1)
	(up-clean-search search-local object-data-distance search-order-asc)
	(up-remove-objects search-local object-data-index >= 1)
	(up-target-point 0 action-train c: dm-unit)); end mini jump
(defrule
	(goal allow-navy yes)
	(up-compare-goal navy-count-total g:< max-navy)
(or	(goal enough-siege yes)
	(unit-type-count-total siege-ship >= 4))
(or	(up-compare-const infinite-resources == yes)
(or	(and	(game-time < 90)
		(strategic-number sn-military-superiority < 4))
(or	(and	(game-time < 180)
		(strategic-number sn-military-superiority < 3))
(or	(and	(game-time < 270)
		(strategic-number sn-military-superiority < 2))
	(and	(game-time < 360)
		(strategic-number sn-military-superiority < 1))))))
	(up-can-train 0 c: dmw-unit)
=>
	(train dmw-unit)); end jump
#end-if
#end-if
#end-if
#end-if
(defrule
	(up-compare-goal temporary-goal8 != 1473960292)
	(up-compare-goal temporary-goal8 != 1473960293)
	(goal enough-siege yes)
(or	(up-can-train 0 c: 1259)
	(up-can-train 0 c: mercenary-kipchak))
=>
	(train 1259)
	(train mercenary-kipchak))
(defrule
	(up-can-train 0 c: xolotl-warrior)
=>
	(chat-to-all-using-id 12004); "Friendly"
	(train xolotl-warrior)
	(disable-self))
(defrule
	(up-compare-const infinite-resources == 1)
	(up-can-train 0 c: xolotl-warrior)
=>
	(train xolotl-warrior))