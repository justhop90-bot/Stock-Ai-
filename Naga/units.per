(defrule
	(up-compare-const michi-style == yes)
	(strategic-number sn-current-age <= castlea)
	(goal under-attack no)
	(goal attacking no)
=>
	(up-modify-goal train-monk c:min 1))
;=========================================================
; Warrior Priests
;=========================================================
(defrule
	(building-type-count monastery >= 1)
	(up-research-status c: ri-fereters != research-available)
	(up-research-status c: ri-squires != research-available)
	(up-research-status c: ri-fervor != research-available)
	(up-research-status c: ri-sanctity != research-available)
	(unit-type-count-total warrior-priest < 1)
=>
	(up-modify-goal train-warrior-priest c:max 1))
;=========================================================
; Knights
;=========================================================
(defrule
(nor	(civ-selected burgundians)
(or	(civ-selected cumans)
(or	(civ-selected frankish)
(or	(civ-selected hun)
(or	(civ-selected lithuanians)
(or	(civ-selected magyar)
(or	(civ-selected persian)
(or	(civ-selected poles)
(or	(civ-selected spanish)
(or	(civ-selected teutonic)
(or	(civ-selected wei)
	(civ-selected wu))))))))))))
=>
	(up-jump-rule 7))
(defrule
(not	(civ-selected magyar))
	(up-compare-flag power-unit-flag == f-paladin)
	(up-compare-flag power-unit-flag == f-unique)
(or	(strategic-number sn-current-age < cimperial)
	(unit-type-count-total my-unique-unit-line g:< train-unique))
	(up-research-status c: ri-paladin <= research-available)
	(up-research-status c: ri-heavy-hei-guang-cavalry <= research-available)
(or	(up-compare-goal excess-food < 1300)
	(up-compare-goal excess-gold < 750))
	(unit-type-count-total knight-unit < 6)
	(up-compare-goal trade-units < 30)
	(up-compare-goal relic-count < 10)
=>
	(up-modify-flag power-unit-flag c:- f-paladin)
	(up-jump-rule 6))
(defrule
(or	(up-compare-flag power-unit-flag == f-paladin)
(or	(and	(up-compare-flag power-unit-flag == f-unique)
		(or	(civ-selected lithuanians)
			(or	(civ-selected burgundians)
				(or	(civ-selected hun)
					(or	(civ-selected persian)
						(civ-selected wei))))))
(or	(strategic-number sn-monks >= 10);
	(goal strategy fast-imp))))
=>
	(up-jump-rule 5))
(defrule
(or	(and	(civ-selected poles)
		(or	(up-research-status c: ri-szlachta-privileges <= research-available)
			(up-compare-flag power-unit-flag == f-unique)))
	(and	(civ-selected wu)
		(or	(and	(up-research-status c: ri-chain-barding <= research-available)
				(up-compare-goal target-distance < 90))
			(or	(up-compare-flag power-unit-flag == f-unique)
				(or	(up-compare-flag power-unit-flag == f-jian-swordsman)
					(up-compare-flag power-unit-flag == f-champion))))))
=>
	(up-jump-rule 4))
(defrule
	(civ-selected magyar)
;	(goal player-position flank) - Shouldn't be on f-unique early then.
(or	(up-compare-flag power-unit-flag == f-unique)
	(up-compare-flag power-unit-flag == f-cavalry-archer))
	(up-research-status c: ri-paladin <= research-available)
(or	(up-research-status c: imperial-age <= research-pending)
(or	(and	(up-compare-flag power-unit-flag == f-unique)
		(up-research-status c: my-unique-unit-upgrade == research-available))
(or	(and	(up-compare-flag power-unit-flag == f-cavalry-archer)
		(and	(up-compare-goal excess-gold < 2400); 825
			(and	(up-compare-goal relic-count < 6)
				(up-compare-goal trade-units < 24))))
(or	(up-compare-goal excess-food < 1300)
(or	(up-compare-goal excess-gold < 750)
	(current-age-time < 2))))))
=>
	(up-jump-rule 3))
(defrule
;(or	(and	(goal strategy krush)
;		(building-type-count-total stable >= 1))
(or	(up-research-status c: ri-szlachta-privileges >= research-pending)
(or	(up-research-status c: ri-cavalier >= research-pending)
(or	(up-research-status c: ri-heavy-hei-guang-cavalry >= research-pending)
;(or	(up-research-status c: ri-plate-barding >= research-pending); chain
	(unit-type-count-total knight-unit >= 6)))););)
=>
	(up-modify-flag power-unit-flag c:+ f-paladin))
(defrule
	(strategic-number sn-current-age >= cimperial)
(or	(and	(up-compare-goal excess-food >= 2500); 2000
		(up-compare-goal excess-gold >= 1000))
(or	(up-compare-goal excess-gold >= 2000); 2000
(or	(and	(or	(up-compare-goal relic-count >= 6)
				(up-compare-goal trade-units >= 36))
		(or	(or	(up-compare-goal custom-civ-pop g:>= desired-civ-pop)
				(civilian-population g:>= desired-civ-pop))
			(population g:>= max-civ-pop)))
	(and	(up-compare-flag power-unit-flag != f-champion)
		(and	(up-compare-flag power-unit-flag != f-unique)
			(and	(up-compare-flag power-unit-flag != f-steppe-lancer)
				(up-compare-flag power-unit-flag != f-battle-elephant)))))))
=>
	(up-modify-flag power-unit-flag c:+ f-paladin))
(defrule
	(strategic-number sn-current-age >= cimperial)
	(up-compare-flag power-unit-flag != f-unique)
	(up-compare-goal strategy != castledrop)
	(current-age >= castle-age)
(or	(unit-type-count-total my-unique-unit-line < 4)
	(building-type-count-total castle <= 0))
=>
	(up-modify-flag power-unit-flag c:+ f-paladin)); end jumps

(defrule
(or	(up-compare-flag power-unit-flag != f-paladin)
