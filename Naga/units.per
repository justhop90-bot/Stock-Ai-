	(up-compare-const CARVEL-HULL-AVAILABLE == YES)
(or	(up-compare-const DRY-DOCK-AVAILABLE == YES)
	(and	(players-unit-type-count every-enemy galley-line < 2)
		(and	(players-unit-type-count every-enemy longboat-line < 2)
			(and	(players-unit-type-count every-enemy caravel-line < 2)
				(and	(players-unit-type-count every-enemy turtle-ship-line < 1)
					(players-unit-type-count every-enemy thirisadai < 1))))))
(or	(and	(up-research-status c: ri-heavy-demolition-ship >= research-pending)
		(unit-type-count-total demolition-ship-line <= 0))
(or	(players-unit-type-count any-enemy fire-galley-line >= 6)
	(players-unit-type-count any-enemy hulk-line >= 4)))
	(unit-type-count-total demolition-ship-line < min-navy)
	(up-modify-goal temporary-goal10 c:= min-navy)
	(up-modify-goal temporary-goal10 g:min allowed-num-military)
	(up-modify-goal temporary-goal10 g:min max-navy)
=>
