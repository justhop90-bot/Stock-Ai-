(or	(players-unit-type-count any-enemy fire-galley-line >= 6)
	(players-unit-type-count any-enemy hulk-line >= 4)))
	(unit-type-count-total demolition-ship-line < min-navy)
	(up-modify-goal temporary-goal10 c:= min-navy)
