(or	(and	(up-compare-goal excess-wood >= 1200)
		(up-compare-goal excess-food >= 1200))
(or	(up-compare-goal excess-wood >= 1800)
(or	(up-compare-goal excess-food >= 1800)
	(up-compare-goal excess-gold >= 1800))))
	(up-modify-goal temporary-goal g:= desired-civ-pop)
	(up-modify-goal temporary-goal g:- custom-civ-pop)
	(up-modify-goal temporary-goal g:+ my-pop)
