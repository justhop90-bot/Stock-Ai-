	(up-modify-goal temporary-goal10 g:min max-navy)
=>
	(up-modify-goal train-demo g:max temporary-goal10))
(defrule
	(population g:< del-civ-pop)
	(unit-available demolition-ship-line)
	(building-type-count dock >= 1)
	(up-train-site-ready c: fishing-ship)
