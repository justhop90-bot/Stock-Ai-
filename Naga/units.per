(defrule
(or	(up-compare-goal navy-count-total g:>= max-navy)
(or	(up-compare-goal allow-navy != yes)
(or	(and	(up-compare-goal map-type < type-islands)
		(and	(up-compare-goal strategy-type2 != type-water)
			(up-compare-goal enemy-boats != yes)))
	(and	(dropsite-min-distance wood >= 4); 5
		(up-compare-goal excess-wood < farmcamp-cost)))))
=>
	(up-jump-rule 25))
(defrule
	(up-compare-goal map-type < type-islands)
	(up-compare-const extra-water-focus == 0)
	(up-compare-goal strategy-type2 != type-water)
