	(building-type-count town-center >= 1)
(or	(up-compare-const dm-game != 1)
	(unit-type-count-total villager >= 16)); 24
=>
	(up-assign-builders c: town-center-foundation c: 4)
;	(disable-self)
)
#load-if-defined SICILIANS-CIV
(defrule
	(building-type-count town-center >= 1)
(or	(up-compare-const dm-game != 1)
	(unit-type-count-total villager >= 15)); 20
(or	(up-research-status c: ri-bow-saw == research-available)
(or	(up-research-status c: farm-tech2 == research-available)
(or	(up-compare-goal excess-food < 300)
	(up-compare-goal excess-wood < 200))))
=>
	(up-assign-builders c: town-center-foundation c: 3); 2
;	(disable-self)
)
#end-if
(defrule
	(current-age == feudal-age)
	(current-age-time < 90)
	(building-type-count town-center == 1)
	(building-type-count-total town-center <= 2)
	(unit-type-count-total villager >= 12)
=>
	(up-assign-builders c: town-center-foundation c: 6)
;	(disable-self)
)
(defrule
; test	(building-type-count-total town-center >= 1)
	(building-type-count town-center <= 0)
=>
	(up-assign-builders c: town-center-foundation c: 20)
;	(disable-self)
)
(defrule
	(building-type-count town-center <= 0);	(building-type-count-total town-center <= 0)
	(game-time < 600)
	(up-compare-goal nomad-start >= 1)
(or	(up-compare-goal nomad-start >= 2);	(up-compare-goal nomad-start >= 2)
	(wood-amount < house-cost))
	(housing-headroom < 5)
	(population-headroom > 0)
	(up-pending-objects c: house <= 0)
	(building-available house)
;(or	(wood-amount < 30)
;	(and	(wood-amount < 305)
;		(building-type-count-total town-center <= 0)))
=>
	(up-modify-goal temporary-goal g:= villager-count)
	(up-modify-goal temporary-goal c:- 1)
	(up-modify-goal temporary-goal s:- sn-minimum-civilian-explorers)
	(up-modify-goal temporary-goal c:max 1)
	(up-assign-builders c: town-center-foundation g: temporary-goal)
;	(disable-self)
)
(defrule
(or	(population g:>= max-civ-pop)
(or	(civilian-population g:>= desired-civ-pop)
(or	(up-compare-goal custom-civ-pop-total g:>= desired-civ-pop)
	(and	(up-compare-const dm-game == 1)
		(unit-type-count-total villager < 16))))); 24
	(building-type-count town-center >= 1)
=>
	(up-assign-builders c: town-center-foundation c: 1)
;	(disable-self)
)
(defrule
	(true)
=>
	(set-strategic-number sn-enable-research-queue 1)
	(disable-self))
#load-if-not-defined DIFFICULTY-MODERATE
(defrule
	(building-type-count town-center >= 1)
(or	(and	(up-compare-const dm-game != 1)
		(up-compare-const dtw-game != 1))
	(unit-type-count-total villager >= 16)); 24
=>
	(up-assign-builders c: feitoria c: 4)
	(set-goal castle-builders 5); 4
	(up-assign-builders c: wonder c: 40)
	(up-assign-builders c: watch-tower-building c: 3); hm
	(up-assign-builders c: bombard-tower c: 3); hm
	(up-assign-builders c: krepost c: 3)
	(up-assign-builders c: donjon c: 2);
	(up-assign-builders c: wall-class c: 2)
	(up-assign-builders c: gate-class c: 2)
;	(disable-self)
)
(defrule
	(up-compare-flag power-unit-flag == f-unique)
	(building-type-count castle <= 0)
(or	(up-research-status c: imperial-age >= research-pending)
	(strategic-number sn-current-age >= cimperial))
	(unit-type-count villager >= 42)
=>
	(set-goal castle-builders 6))
(defrule
	(up-compare-goal gl-treaty-time >= 120)
=>
	(set-goal castle-builders 1)
	(up-assign-builders c: watch-tower-building c: 1)
	(up-assign-builders c: bombard-tower c: 1)
	(up-assign-builders c: krepost c: 1)
	(up-assign-builders c: donjon c: 1)
	(up-assign-builders c: wall-class c: 1)
	(up-assign-builders c: gate-class c: 1))
(defrule
(or	(goal strategy fast-imp)
	(goal military-choice kecil))
;	(goal military-choice monk-treb)
	(up-research-status c: imperial-age <= research-available)
	(strategic-number sn-current-age <= castlea)
	(unit-type-count villager < 42)
=>
