(defrule
	(up-compare-const nomad-style == yes)
	(building-type-count-total town-center <= 0)
=>
	(set-goal nomad-start 1)
	(disable-self))
(defrule
	(up-compare-const nomad-style == yes)
	(building-type-count-total town-center <= 0)
	(wood-amount < 275)
=>
	(set-goal nomad-start 2)
	(disable-self))
(defrule
	(up-compare-goal nomad-start >= 1)
	(building-type-count town-center <= 0)
(or	(building-type-count-total town-center >= 1)
	(and	(unit-type-count-total villager >= 1)
		(or	(building-available town-center)
			(up-can-build escrow-state c: town-center))))
=>
	(up-get-fact game-time 0 map-treatment-switch-time)
	(up-modify-goal map-treatment-switch-time c:+ 5))

(defrule
	(building-type-count-total town-center <= 0)
	(unit-type-count villager >= 1)
=>
	(up-full-reset-search)
	(up-find-local c: villager-class c: 1)
	(up-set-target-object search-local c: 0)
	(up-get-point position-object self-x)
	(up-get-point-zone self-x main-zone))
(defrule
	(building-type-count town-center <= 0)
	(building-type-count-total town-center >= 1)
	(unit-type-count villager >= 1)
=>
	(up-full-reset-search)
	(up-filter-status c: status-pending c: list-active)
	(up-find-status-local c: town-center-foundation c: 1)
	(up-set-target-object search-local c: 0)
	(up-get-point position-object self-x)
	(up-get-point-zone self-x main-zone)
	(up-get-object-data object-data-id position-self-id))
(defrule
	(building-type-count town-center >= 1)
=>
	(up-full-reset-search)
	(up-find-local c: town-center c: 1)
	(up-set-target-object search-local c: 0)
	(up-get-point position-object self-x)
	(up-get-point-zone self-x main-zone)
	(up-get-object-data object-data-id position-self-id)
	(up-modify-sn sn-safe-town-size s:= sn-maximum-town-size)
	(up-modify-sn sn-safe-town-size c:max 16); 14
	(set-goal temporary-goal 42)
	(up-modify-goal temporary-goal s:+ sn-current-age)
	(up-modify-goal temporary-goal2 g:= gl-game-time)
	(up-modify-goal temporary-goal2 c:z/ 1000)
	(up-modify-goal temporary-goal g:+ temporary-goal2)
	(up-modify-sn sn-safe-town-size g:min temporary-goal)); 48 + [16:40]
(defrule
	(up-compare-goal starting-zone <= -1)
	(up-compare-goal self-x >= 0)
	(up-compare-goal self-y >= 0)
	(up-compare-goal self-x g:< map-size)
	(up-compare-goal self-y g:< map-size)
=>
	(up-get-point-zone self-x starting-zone)
;	(up-chat-data-to-self "starting-zone: %d" g: starting-zone)
;	(disable-self)
)
(defrule
	(up-compare-goal self-x != -1)
=>
	(up-set-target-point self-x)
	(up-copy-point micro-x self-x)
	(up-copy-point micro2-x self-x)
	(up-copy-point micro3-x self-x)
	(disable-self))
(defrule
	(up-players-in-game enemy == 1)
(or	(strategic-number sn-target-player-number <= 0)
	(strategic-number sn-focus-player-number <= 0))
	(player-in-game any-enemy)
=>
	(up-get-player-fact this-any-enemy player-number 0 temporary-goal)
	(up-modify-sn sn-target-player-number g:= temporary-goal)
	(up-modify-sn sn-focus-player-number g:= temporary-goal)
	(disable-self)); score
(defrule
	(goal target-system yes)
(or	(players-building-count any-enemy >= 1)
(or	(players-building-type-count any-enemy stone-wall-line >= 1)
	(players-building-type-count any-enemy palisade-wall >= 1)))
=>
	(up-find-player enemy find-closest temporary-goal)
	(up-modify-sn sn-target-player-number g:= temporary-goal)
	(up-modify-sn sn-focus-player-number g:= temporary-goal))
(defrule
(or	(players-building-count target-player >= 1); any-enemy
(or	(players-building-type-count target-player stone-wall-line >= 1)
	(players-building-type-count target-player palisade-wall >= 1)))
=>
	(up-get-point position-target target-x)
	(up-get-target-fact player-distance 0 temporary-goal)
	(up-modify-goal target-distance g:min temporary-goal)
	(up-get-point-distance self-x target-x temporary-goal)
	(up-modify-goal target-distance g:min temporary-goal)
	(up-get-target-fact population 0 target-pop)
	(up-get-target-fact civilian-population 0 target-cpop)
	(up-get-target-fact military-population 0 target-mpop)
	(up-modify-sn sn-target-civilian-superiority g:= my-cpop)
	(up-modify-sn sn-target-civilian-superiority g:- target-cpop)
	(up-modify-sn sn-target-military-superiority g:= my-mpop)
	(up-modify-sn sn-target-military-superiority g:- target-mpop))
(defrule
(or	(players-building-count target-player >= 1); any-enemy
(or	(players-building-type-count target-player stone-wall-line >= 1)
	(players-building-type-count target-player palisade-wall >= 1)))
	(up-compare-goal temporary-goal g:<= map-size)
(or	(game-time >= 1800)
(or	(strategic-number sn-current-age >= cimperial)
(or	(not	(player-in-game every-enemy))
	(players-building-count every-enemy >= 1))))
=>
	(up-modify-goal target-distance g:= temporary-goal))

(defrule
	(players-building-count target-player <= 0); every-enemy
	(players-building-type-count target-player stone-wall-line <= 0); every-enemy
	(players-building-type-count target-player palisade-wall <= 0); every-enemy
	(up-compare-goal target-distance <= 0)
=>
	(up-modify-goal target-distance c:= preftradedist)
	(up-get-point position-flank temp-x)
	(up-get-point-distance self-x temp-x temporary-goal)
	(up-modify-goal target-distance g:min temporary-goal)
	(up-get-point position-opposite temp6-x)
	(up-get-point-distance self-x temp6-x temporary-goal)
	(up-modify-goal target-distance g:min temporary-goal)
	(up-get-point position-mirror temp4-x)
	(up-get-point-distance self-x temp4-x temporary-goal)
	(up-modify-goal target-distance g:min temporary-goal)
	(up-get-point scouting-type temp5-x)
	(up-get-point-distance self-x temp5-x temporary-goal)
	(up-modify-goal target-distance g:min temporary-goal)
	(up-modify-goal target-distance c:- 10)
	(up-modify-goal target-distance c:max 1)
	(disable-self))
(defrule
	(players-building-count target-player <= 0); every-enemy
	(players-building-type-count target-player stone-wall-line <= 0); every-enemy
	(players-building-type-count target-player palisade-wall <= 0); every-enemy
	(strategic-number team-balance != 0)
(or	(up-allied-goal any-computer-ally super-pocket == yes)
	(nand	(goal player-position pocket)
		(goal super-pocket yes)))
=>
	(up-get-point position-center temp2-x)
	(up-get-point-distance self-x temp2-x temporary-goal2)
	(up-modify-goal target-distance g:+ temporary-goal2)
	(up-modify-goal target-distance c:/ 2)
	(disable-self))
(defrule
	(players-building-count target-player <= 0); every-enemy
	(players-building-type-count target-player stone-wall-line <= 0); every-enemy
	(players-building-type-count target-player palisade-wall <= 0); every-enemy
	(up-compare-goal target-x <= 0)
=>
	(up-add-point temp-x temp6-x c: 1)
	(up-add-point temp-x temp4-x c: 1)
	(up-add-point temp-x temp5-x c: 1)
	(up-modify-goal temp-x c:/ 4)
	(up-modify-goal temp-y c:/ 4)
	(up-copy-point target-x temp-x)
	(up-set-target-point target-x)
	(disable-self))
(defrule
(or	(and	(players-building-count target-player <= 0)
		(and	(players-building-type-count target-player stone-wall-line <= 0)
			(players-building-type-count target-player palisade-wall <= 0)))
	(up-compare-goal target-distance <= -1))
	(up-compare-goal nomad-start >= 1)
=>
	(up-modify-goal target-distance c:max 42)
	(disable-self))
(defrule
(or	(and	(players-building-count target-player <= 0)
		(and	(players-building-type-count target-player stone-wall-line <= 0)
			(players-building-type-count target-player palisade-wall <= 0)))
	(up-compare-goal target-distance <= -1))
	(up-compare-goal nomad-start >= 1)
;(or	(building-type-count wood-placement-camp >= 1)
	(building-type-count town-center >= 1);)
=>
	(up-get-point-distance self-x center-x temporary-goal)
	(up-modify-goal temporary-goal c:+ 10)
	(up-modify-goal target-distance g:min temporary-goal)
	(disable-self))
(defrule
(or	(and	(players-building-count target-player <= 0)
		(and	(players-building-type-count target-player stone-wall-line <= 0)
			(players-building-type-count target-player palisade-wall <= 0)))
	(up-compare-goal target-distance <= -1))
	(player-in-game target-player)
	(up-compare-goal target-cpop >= 1)
	(building-type-count town-center >= 1); -total
=>
	(up-full-reset-search)
	(up-find-remote c: villager-class c: 40))
(defrule
(or	(and	(players-building-count target-player <= 0)
		(and	(players-building-type-count target-player stone-wall-line <= 0)
			(players-building-type-count target-player palisade-wall <= 0)))
	(up-compare-goal target-distance <= -1))
	(player-in-game target-player)
	(up-compare-goal target-cpop >= 1)
	(building-type-count town-center >= 1); -total
	(up-set-target-object search-remote c: 0)
=>
	(up-set-target-point self-x)
	(up-clean-search search-remote object-data-distance search-order-asc)
	(up-set-target-object search-remote c: 0)
	(up-get-point position-object temp-x)
	(up-get-point-distance self-x temp-x temporary-goal)
	(up-modify-goal target-distance g:min temporary-goal))
(defrule
(or	(and	(players-building-count target-player <= 0)
		(and	(players-building-type-count target-player stone-wall-line <= 0)
			(players-building-type-count target-player palisade-wall <= 0)))
	(up-compare-goal target-distance <= -1))
(or	(up-compare-goal target-distance <= 0)
	(up-compare-goal target-distance g:> map-size))
=>
;	(up-chat-data-to-player my-player-number "TD: %d" g: target-distance)
	(up-modify-goal target-distance c:max 40)
	(up-modify-goal target-distance g:min map-size)
;	(up-chat-data-to-player my-player-number "TD2: %d" g: target-distance)
)
#load-if-defined UP-POCKET-POSITION
(defrule
	(up-compare-goal player-position != pocket)
=>
	(set-goal player-position pocket))
#else
(defrule
	(up-compare-goal player-position != flank)
=>
	(set-goal player-position flank))
#end-if
(defrule
	(up-compare-goal player-position != flank)
(or	(up-compare-goal nomad-start >= 1)
	(up-compare-goal target-distance < 45))
	(strategic-number sn-current-age <= cimperial)
	(up-compare-const michi-style != yes)
(or	(players-building-count any-enemy <= 0)
(or	(and	(up-compare-goal target-distance < 126); 144
		(and	(strategic-number sn-current-age <= feudal)
			(up-compare-goal enemy-age <= feudal)))
	(up-compare-goal target-distance < 90)))
=>
	(set-goal player-position flank))
(defrule
	(up-compare-goal player-position != pocket)
	(strategic-number sn-current-age <= cimperial); dfeudal
(or	(up-compare-const michi-style == yes)
	(and	(players-building-count every-enemy >= 1)
		(up-compare-goal target-distance >= 126))); 144
=>
	(set-goal player-position pocket))

(defrule
	(up-compare-goal number-allies != -1)
	(up-compare-goal number-enemies != -1)
(or	(up-timer-status ten-seconds == timer-running)
	(and	(strategic-number team-balance == 0)
		(and	(goal number-allies 0)
			(goal number-enemies 1))))
=>
	(up-jump-rule 5))
(defrule
	(true)
=>
	(up-modify-goal temporary-goal s:= sn-focus-player-number)
	(set-strategic-number sn-focus-player-number 1)
	(set-goal number-allies 0)
	(set-goal number-enemies 0))
(defrule ; end neg jump
(or	(players-stance focus-player ally)
	(stance-toward focus-player ally))
	(player-in-game focus-player)
	(strategic-number sn-focus-player-number != my-player-number)
=>
	(up-modify-goal number-allies c:+ 1)
	(up-jump-rule 1))
(defrule
	(player-in-game focus-player)
	(strategic-number sn-focus-player-number != my-player-number)
=>	
	(up-modify-goal number-enemies c:+ 1))
(defrule
	(strategic-number sn-focus-player-number < 8)
=>
	(up-modify-sn sn-focus-player-number c:+ 1)
	(up-jump-rule -3))
(defrule
	(true)
=>
	(up-modify-sn sn-focus-player-number g:= temporary-goal)
	(set-strategic-number team-balance 1)
	(up-modify-sn team-balance g:+ number-allies)
	(up-modify-sn team-balance g:- number-enemies)
	(up-modify-sn team-balance c:max -2)
	(up-modify-sn team-balance c:min 2)); end jump
(defrule
	(true)
=>
	(up-modify-goal temporary-goal g:= number-allies)
	(up-modify-goal temporary-goal2 s:= sn-required-forest-tiles)
	(up-modify-goal temporary-goal2 c:%* 67)
	(up-modify-goal temporary-goal2 g:* temporary-goal)
	(up-modify-goal temporary-goal2 c:min 50)
	(up-modify-goal temporary-goal2 c:max 0)
	(up-modify-sn sn-required-forest-tiles g:+ temporary-goal2)
	(up-get-fact cc-gaia-type-count tree-class temporary-goal)
	(up-get-fact players-in-game any temporary-goal2)
	(up-modify-goal temporary-goal g:/ temporary-goal2)
	(up-modify-sn sn-required-forest-tiles g:min temporary-goal)
;	(up-chat-data-to-all "sn-required-forest-tiles: %d" s: sn-required-forest-tiles)
	(disable-self))

(defrule
	(false)
	(strategic-number sn-enable-patrol-attack == 1)
=>
	(set-strategic-number sn-enable-patrol-attack 0);
	(up-jump-rule 1))
(defrule
	(true)
=>
	(set-strategic-number sn-enable-patrol-attack 1)); end jump
(defrule
(or	(unit-type-count karambit-warrior-line >= 2)
	(unit-type-count blackwood-archer-line >= 2))
=>
	(up-get-fact unit-type-count karambit-warrior-line temporary-goal)
	(up-modify-goal temporary-goal c:z/ 2)
	(up-modify-goal temporary-goal c:max 0)
;	(up-modify-goal temporary-goal c:min 500)
	(up-modify-goal my-mpop g:- temporary-goal)
	(up-get-fact unit-type-count blackwood-archer-line temporary-goal)
	(up-modify-goal temporary-goal c:z/ 2)
	(up-modify-goal temporary-goal c:max 0)
;	(up-modify-goal temporary-goal c:min 500)
	(up-modify-goal my-mpop g:- temporary-goal))
(defrule
	(research-completed ri-mahayana)
	(unit-type-count villager >= 10)
=>
	(up-modify-goal custom-civ-pop g:- villager-count)
	(up-modify-goal temporary-goal g:= villager-count)
	(up-modify-goal temporary-goal c:%* 90)
	(up-modify-goal custom-civ-pop g:+ temporary-goal))
(defrule
	(up-timer-status five-seconds != timer-running)
;(or	(civ-selected portuguese)
;	(building-available feitoria))
=>
	(up-modify-goal feitoria-cap g:= desired-civ-pop)
	(up-modify-goal feitoria-cap g:- min-number-vills)
	(up-modify-goal feitoria-cap g:- trade-units)
	(up-modify-goal feitoria-cap c:z/ 20)
	(up-modify-goal feitoria-cap c:max 0)
	(up-modify-goal feitoria-cap c:min feitoria-diff))

(defrule
(or	(up-compare-goal focus-pop <= -1)
(or	(up-compare-goal focus-cpop <= -1)
	(up-compare-goal focus-mpop <= -1)))
=>
	(up-modify-goal focus-pop g:= my-pop)
	(up-modify-goal focus-pop g:min del-civ-pop)
	(up-modify-goal focus-cpop g:= my-cpop)
	(up-modify-goal focus-cpop g:min desired-civ-pop)
	(up-modify-goal focus-mpop g:= my-mpop)
	(up-modify-goal focus-mpop g:= my-mpop)
	(up-modify-goal focus-mpop c:min 1)
	(disable-self))
(defrule
(or	(players-building-count any-enemy >= 1)
(or	(players-building-type-count any-enemy stone-wall-line >= 1)
	(players-building-type-count any-enemy palisade-wall >= 1)))
;	(player-in-game focus-player)
	(strategic-number sn-focus-player-number >= 1)
	(strategic-number sn-focus-player-number <= 8)
=>
	(up-get-focus-fact population 0 focus-pop)
	(up-get-focus-fact civilian-population 0 focus-cpop)
	(up-get-focus-fact military-population 0 focus-mpop)
	(up-get-focus-fact unit-type-count karambit-warrior-line temporary-goal)
	(up-modify-goal temporary-goal c:z/ 2)
	(up-modify-goal temporary-goal c:max 0)
;	(up-modify-goal temporary-goal c:min 500)
	(up-modify-goal focus-mpop g:- temporary-goal)
	(up-get-focus-fact unit-type-count blackwood-archer-line temporary-goal)
	(up-modify-goal temporary-goal c:z/ 2)
	(up-modify-goal temporary-goal c:max 0)
;	(up-modify-goal temporary-goal c:min 500)
	(up-modify-goal focus-mpop g:- temporary-goal))

(defrule
	(up-timer-status three-seconds != timer-running)
=>
	(up-get-fact unit-type-count-total 211 dead-villagers); Dead female villager
	(up-get-fact unit-type-count-total 213 temporary-goal); Dead female builder
	(up-modify-goal dead-villagers g:+ temporary-goal)
	(up-get-fact unit-type-count-total 215 temporary-goal); Dead female farmer
	(up-modify-goal dead-villagers g:+ temporary-goal)
	(up-get-fact unit-type-count-total 217 temporary-goal); Dead female hunter
	(up-modify-goal dead-villagers g:+ temporary-goal)
	(up-get-fact unit-type-count-total 219 temporary-goal); Dead female lumberjack
	(up-modify-goal dead-villagers g:+ temporary-goal)
	(up-get-fact unit-type-count-total 221 temporary-goal); Dead female miner
	(up-modify-goal dead-villagers g:+ temporary-goal)
	(up-get-fact unit-type-count-total 224 temporary-goal); Dead male villager
	(up-modify-goal dead-villagers g:+ temporary-goal)
	(up-get-fact unit-type-count-total 225 temporary-goal); Dead male builder
	(up-modify-goal dead-villagers g:+ temporary-goal)
	(up-get-fact unit-type-count-total 226 temporary-goal); Dead male farmer
	(up-modify-goal dead-villagers g:+ temporary-goal)
	(up-get-fact unit-type-count-total 227 temporary-goal); Dead male hunter
	(up-modify-goal dead-villagers g:+ temporary-goal)
	(up-get-fact unit-type-count-total 228 temporary-goal); Dead male lumberjack
	(up-modify-goal dead-villagers g:+ temporary-goal)
	(up-get-fact unit-type-count-total 229 temporary-goal); Dead male miner
	(up-modify-goal dead-villagers g:+ temporary-goal)
	(up-modify-goal dead-villagers c:max 0))

(defrule
	(true)
=>
	(up-full-reset-search)
	(up-set-target-point self-x)
	(up-modify-goal temporary-goal s:= sn-safe-town-size); max
	(up-modify-goal temporary-goal c:+ 6); 8
	(up-modify-goal temporary-goal c:max 26); 28
	(up-modify-goal temporary-goal c:min 40); patroldefense
	(up-modify-goal temporary-goal2 s:= sn-focus-player-number)
	(set-strategic-number sn-focus-player-number 1)
	(up-filter-distance c: -1 g: temporary-goal)
;	(up-filter-include -1 -1 -1 on-mainland)
	(up-filter-exclude -1 -1 -1 warship-class))
(defrule ; end neg jump
(not	(stance-toward focus-player ally))
	(player-in-game focus-player)
	(player-valid focus-player)
=>
	(up-find-remote c: all-units-class c: 40)
	(up-remove-objects search-remote object-data-class == building-class)
	(up-remove-objects search-remote object-data-class == farm-class)
	(up-remove-objects search-remote object-data-class == tower-class)
	(up-remove-objects search-remote object-data-class == wall-class)
	(up-remove-objects search-remote object-data-class == gate-class)
	(up-remove-objects search-remote object-data-speed <= 0))
(defrule
	(strategic-number sn-focus-player-number < 8)
=>
	(up-modify-sn sn-focus-player-number c:+ 1)
	(up-jump-rule -2))
(defrule
	(true)
=>
	(up-get-search-state local-total)
	(up-modify-sn sn-focus-player-number g:= temporary-goal2))
(defrule
	(up-compare-goal under-attack != yes)
	(up-compare-goal remote-total >= 5)
	(goal attacking no)
	(population g:< max-civ-pop)
(or	(up-unit-type-in-town c: monk >= 4)
(or	(up-unit-type-in-town c: missionary >= 4)
(or	(town-under-attack)
(or	(up-compare-flag micro-flag == f-patrol-defense)
	(and	(up-compare-goal gl-threat-time >= 0)
		(up-compare-goal gl-threat-time < 8000))))))
(or	(up-compare-goal remote-total g:>= my-mpop)
(or	(up-compare-goal remote-total g:>= ten-pop)
	(up-compare-goal dead-villagers >= 2)))
(or	(up-compare-goal remote-total g:> my-mpop)
(or	(up-compare-goal remote-total g:>= twenty-pop)
(or	(up-compare-goal dead-villagers >= 4)
	(strategic-number sn-military-superiority <= 0)))); -1
=>
;	(chat-local-to-self "We are under attack.")
	(set-goal under-attack yes)
	(up-jump-rule 2))
(defrule
	(up-compare-goal under-attack != yes)
	(up-enemy-units-in-town >= 5)
	(goal attacking no)
	(population g:< max-civ-pop)
(or	(up-unit-type-in-town c: monk >= 4)
(or	(up-unit-type-in-town c: missionary >= 4)
(or	(town-under-attack)
(or	(up-compare-flag micro-flag == f-patrol-defense)
	(and	(up-compare-goal gl-threat-time >= 0)
		(up-compare-goal gl-threat-time < 8000))))))
(or	(up-enemy-units-in-town g:>= my-mpop)
(or	(up-enemy-units-in-town g:>= ten-pop)
	(up-compare-goal dead-villagers >= 2)))
(or	(up-enemy-units-in-town g:> my-mpop)
(or	(up-enemy-units-in-town g:>= twenty-pop)
(or	(up-compare-goal dead-villagers >= 4)
	(strategic-number sn-military-superiority <= 0)))); -1
=>
;	(chat-local-to-self "We are under attack.")
	(set-goal under-attack yes)
	(up-jump-rule 1))
(defrule
	(up-compare-goal under-attack != no)
=>
;	(chat-local-to-self "The attack should be over now.")
	(set-goal under-attack no))

