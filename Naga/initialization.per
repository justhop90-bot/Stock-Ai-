	(up-compare-goal TC-up != yes)
	(building-type-count-total town-center >= towncenter-diff)
	(building-type-count-total town-center >= 1)
=>
	(set-goal TC-up yes))

(defrule
(or	(up-compare-const ew-game == 1)
	(up-compare-const dm-game == 1))
	(up-compare-goal nomad-start <= 0)
=>
	(up-modify-sn sn-home-exploration-time c:min 90)
	(up-modify-goal livestock-exploration-time c:min 30);
	(disable-self))
(defrule
	(game-time < 300)
	(up-compare-goal nomad-start >= 1)
	(building-type-count town-center >= 1)
=>
	(up-modify-sn sn-home-exploration-time g:+ gl-game-time)
	(up-modify-goal livestock-exploration-time g:+ gl-game-time)
	(disable-self))
#load-if-defined DARK-AGE-END
(defrule
	(current-age >= dark-age)
	(strategic-number sn-current-age < imperial)
=>
	(set-goal TC-up yes)
	(set-goal plan-completed yes)
	(set-strategic-number sn-current-age imperial)
	(up-modify-goal temporary-goal c:= besar)
	(up-modify-goal temporary-goal2 c:= besar)
	(set-goal temporary-goal3 2)
	(set-goal temporary-goal4 0)
	(set-goal temporary-goal5 0)
	(up-get-rule-id temporary-goal16)
	(up-modify-goal temporary-goal16 c:+ 1)
	(up-jump-direct g: affinity-function-id))
(defrule
	(up-compare-goal strategy-type >= feudal-war)
	(up-compare-goal strategy != besar)
=>
;	(chat-to-player my-player-number "Resetting strategy, age end.D")
	(up-modify-goal temporary-goal c:= besar)
	(up-modify-goal temporary-goal2 c:= besar)
	(set-goal temporary-goal3 2)
	(set-goal temporary-goal4 0)
	(set-goal temporary-goal5 -1000)
	(up-get-rule-id temporary-goal16)
	(up-modify-goal temporary-goal16 c:+ 1)
	(up-jump-direct g: affinity-function-id)
	(set-goal strategy-locked no))
#else
(defrule
	(strategic-number sn-current-age >= dfeudal)
	(up-research-status c: feudal-age <= research-available)
	(current-age == dark-age)
=>
