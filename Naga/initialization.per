	(building-type-count castle <= 0)
	(up-research-status c: imperial-age <= research-unavailable)
	(unit-type-count villager >= 24)
	(goal strategy fast-imp)
	(goal military-choice monk-treb)
=>
	(set-goal castle-builders 6))
