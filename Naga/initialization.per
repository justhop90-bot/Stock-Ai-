(defrule
	(false)
(not	(taunt-detected my-player-number 204))
=>
	(up-jump-rule 10000))
(defrule
	(taunt-detected my-player-number 124)
=>
	(acknowledge-taunt my-player-number 123)
	(acknowledge-taunt my-player-number 124))
(defrule
	(taunt-detected my-player-number 123)
