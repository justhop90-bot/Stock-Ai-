(defrule
	(true)
=>
	(set-goal temporary-goal 0)
	(up-modify-goal temporary-goal3 g:= villager-count)
	(up-modify-goal temporary-goal3 c:min 75)
	(up-full-reset-search)
	(up-find-local c: 123 g: temporary-goal3)
	(up-find-local c: 218 g: temporary-goal3)
	(up-get-search-state local-total))
(defrule ; end neg jump
	(up-set-target-object search-local g: temporary-goal)
	(up-object-data object-data-target == tree-class)
=>
	(up-get-object-data object-data-carry temporary-goal2)
	(up-modify-goal total-wood-amount g:+ temporary-goal2))
(defrule
	(up-set-target-object search-local g: temporary-goal)
	(up-compare-goal temporary-goal g:< local-total)
	(up-compare-goal temporary-goal g:< villager-count)
=>
	(up-modify-goal temporary-goal c:+ 1)
	(up-jump-rule -2)); end jump

#load-if-defined DRAVIDIANS-CIV
(defrule
(or	(up-research-status c: feudal-age == research-pending)
(or	(up-research-status c: castle-age == research-pending)
	(up-research-status c: imperial-age == research-pending)))
=>
	(up-modify-goal total-wood-amount c:+ 200))
#end-if
#load-if-defined ETHIOPIAN-CIV
(defrule
	(strategic-number sn-current-age == dark)
	(up-research-status c: feudal-age <= research-available)
	(up-compare-goal strategy != drush)
(or	(up-compare-goal total-gold-amount >= 50)
(or	(up-compare-goal wall-strength >= 900)
	(up-research-status c: ri-loom >= research-pending)))
=>
	(up-modify-goal total-gold-amount c:+ 100))
(defrule
(or	(up-research-status c: feudal-age == research-pending)
(or	(up-research-status c: castle-age == research-pending)
	(up-research-status c: imperial-age == research-pending)))
=>
	(up-modify-goal total-food-amount c:+ 100)
	(up-modify-goal total-gold-amount c:+ 100))
#end-if
(defrule
(nor	(goal strategy drush)
	(and	(goal strategy maa-opener)
		(or	(up-research-status c: ri-man-at-arms >= research-pending)
			(or	(up-research-status c: ri-champi-runner >= research-pending)
				(or	(civ-selected bulgarians)
					(or	(and	(up-compare-goal essential-soldiercount <= 2)
							(or	(unit-type-count-total militiaman-line g:>= essential-soldiercount)
								(unit-type-count-total champi-line g:>= essential-soldiercount)))
						(or	(unit-type-count-total serjeant-set g:>= essential-soldiercount)
							(unit-type-count-total flemish-militia g:>= essential-soldiercount))))))))
=>
	(up-jump-rule 1))
(defrule
(or	(and	(goal strategy drush)
		(or	(strategic-number sn-current-age >= cimperial)
			(current-age >= feudal-age)))
(or	(unit-type-count 2 g:>= essential-soldiercount)
(or	(unit-type-count 140 g:>= essential-soldiercount)
(or	(unit-type-count 152 g:>= essential-soldiercount)
(or	(unit-type-count 1664 g:>= essential-soldiercount)
(or	(unit-type-count 1662 g:>= essential-soldiercount)
(or	(unit-type-count-total militiaman-line g:>= essential-soldiercount)
(or	(unit-type-count-total champi-line g:>= essential-soldiercount)
(or	(unit-type-count-total serjeant-set g:>= essential-soldiercount)
	(unit-type-count-total flemish-militia g:>= essential-soldiercount))))))))))
=>
	(set-goal update-strategy yes)
	(up-modify-goal temporary-goal c:= besar)
	(up-modify-goal temporary-goal2 c:= besar)
	(set-goal temporary-goal3 2)
	(set-goal temporary-goal4 0)
	(set-goal temporary-goal5 -500)
	(up-get-rule-id temporary-goal16)
	(up-modify-goal temporary-goal16 c:+ 1)
	(up-jump-direct g: affinity-function-id)); end jump
(defrule
	(goal strategy besar)
	(goal military-choice besar)
	(strategic-number sn-current-age >= dfeudal)
	(strategic-number sn-current-age <= feudal)
=>
	(set-goal update-strategy yes)
	(disable-self))
(defrule
	(goal strategy besar)
	(goal military-choice besar)
	(strategic-number sn-current-age >= fcastlea)
	(strategic-number sn-current-age <= castlea)
=>
	(set-goal update-strategy yes)
	(disable-self))

(defrule
	(true); band-aid for now
=>
	(set-goal temporary-goal 0)
	(set-goal temporary-goal2 0)
	(up-full-reset-search))

#load-if-not-defined INFINITE-RESOURCES-START
(defrule
	(true)
=>
	(up-modify-goal max-farms g:= villager-count)
	(up-modify-goal max-farms s:%* sn-food-gatherer-percentage)
	(up-modify-goal temporary-goal2 g:= max-farms)
	(up-get-fact unit-type-count villager-food temporary-goal)
	(up-modify-goal max-farms g:- temporary-goal)
	(up-modify-goal max-farms g:+ farmer-count)
	(up-modify-goal max-farms c:max 0)
	(up-modify-goal temporary-goal2 c:+ min-siege);
	(up-modify-goal max-farms g:min temporary-goal2)
	(up-modify-goal temporary-goal2 g:= forage-count)
	(up-modify-goal temporary-goal2 c:%* 150); 133
	(up-modify-goal temporary-goal2 c:max 0)
	(up-modify-goal temporary-goal2 c:min 8); 6
	(up-get-fact unit-type-count villager-forager temporary-goal)
	(up-modify-goal temporary-goal g:- temporary-goal2)
	(up-modify-goal temporary-goal c:max 0))
(defrule
;(or	(strategic-number sn-current-age >= fcastlea)
;	(up-research-status c: castle-age >= research-available))
	(true)
=>
	(up-get-fact unit-type-count villager-hunter temporary-goal2)
	(up-modify-goal temporary-goal3 g:= hunt-count)
	(up-modify-goal temporary-goal3 c:max 1); 0
	(up-modify-goal temporary-goal3 c:min 4); 6
	(up-modify-goal temporary-goal3 c:%* 800)
	(up-modify-goal temporary-goal2 g:- temporary-goal3); 12; 10
	(up-modify-goal temporary-goal2 c:max 0)
	(up-modify-goal temporary-goal g:+ temporary-goal2)
	(up-get-fact unit-type-count villager-shepherd temporary-goal2)
	(up-modify-goal temporary-goal2 c:- 8); 7
	(up-modify-goal temporary-goal2 c:max 0)	
	(up-modify-goal temporary-goal g:+ temporary-goal2)
	(up-get-fact unit-type-count villager-fisherman temporary-goal2)
;	(up-modify-goal temporary-goal2 c:- 1)
	(up-modify-goal temporary-goal3 g:= shore-count)
	(up-modify-goal temporary-goal3 c:max 0)
	(up-modify-goal temporary-goal3 c:min 4); 6
	(up-modify-goal temporary-goal2 g:- temporary-goal3)
	(up-modify-goal temporary-goal2 c:max 0)
;	(up-chat-data-to-player my-player-number "temporary-goalFi: %d" g: temporary-goal)
	(up-modify-goal temporary-goal g:+ temporary-goal2))
(defrule
	(up-compare-goal strategy == fast-imp)
	(up-research-status c: imperial-age <= research-unavailable)
	(strategic-number sn-current-age < cimperial)
	(current-age == castle-age)
=>
	(up-jump-rule 2))
(defrule
(or	(up-compare-goal forage-count <= 2); 3
(or	(and	(goal strategy maa-opener)
		(building-type-count-total barracks >= 1))
(or	(strategic-number sn-current-age >= fcastlea)
(or	(and	(strategic-number sn-current-age >= dfeudal)
		(strategic-number sn-current-age s:>= strategy-type))
(or	(and	(up-research-status c: castle-age >= research-available)
		(current-age-time >= 5))
(or	(up-research-status c: farm-tech1 >= research-pending)
	(and	(unit-type-count villager >= 7)
		(unit-type-count villager-food < 6))))))))
=>
	(up-modify-goal max-farms g:+ temporary-goal)
;	(up-chat-data-to-player my-player-number "max-farms: %d" g: max-farms)
	(up-modify-goal max-farms c:max 0)
	(up-jump-rule 1))
(defrule
(or	(and	(goal strategy s-flush)
		(building-type-count-total stable >= 1))
	(current-age <= dark-age))
=>
	(up-modify-goal max-farms g:+ temporary-goal)
;	(up-chat-data-to-player my-player-number "max-farms2: %d" g: max-farms)
	(up-modify-goal max-farms c:max 0))
(defrule
	(game-time < 360); DM etc
;	(current-age >= castle-age)
	(up-compare-goal excess-food >= 1200)
	(unit-type-count-total villager < 24)
	(up-compare-goal max-farms >= 1)
=>
;	(set-goal max-farms 0)
	(up-modify-goal max-farms g:min farmer-count)
	(up-modify-goal max-farms c:max 0))
(defrule
	(goal strategy grush)
	(game-time < 900)
	(building-type-count-total dock <= 2); 0
	(unit-type-count-total villager < 30)
	(wood-amount < 210); hmm
(or	(up-compare-goal total-food-amount >= vill-cost)
	(up-pending-objects c: villager >= 2))
	(up-compare-goal max-farms >= 1)
=>
;	(set-goal max-farms 0)
	(up-modify-goal max-farms g:min farmer-count)
	(up-modify-goal max-farms c:max 0))
(defrule
	(false); handled elsewhere
(not	(building-available farm))
	(building-available pasture)
	(up-compare-goal max-farms >= 1)
=>
	(up-modify-goal max-farms c:+ 1)
	(up-modify-goal max-farms c:z/ 2))
#else
(defrule
	(true)
=>
	(set-strategic-number sn-maximum-food-drop-distance 0)
	(set-strategic-number sn-maximum-wood-drop-distance 0)
	(set-strategic-number sn-maximum-gold-drop-distance 0)
	(set-strategic-number sn-maximum-stone-drop-distance 0)
	(set-strategic-number sn-maximum-hunt-drop-distance 0)
	(set-strategic-number sn-percent-civilian-gatherers 0)
	(set-strategic-number sn-cap-civilian-gatherers 0)
	(set-strategic-number sn-cap-civilian-builders 200)
	(set-strategic-number sn-percent-civilian-builders 100)
	(set-goal max-farms 0))
#end-if

(defrule
	(goal attacking yes)
	(strategic-number sn-safe-town-size s:< sn-maximum-town-size)
; test	(goal attack-method town-size-attack)
;	(goal target-system yes)
	(up-projectile-detected projectile-fortification < 3000)
	(up-projectile-detected projectile-fortification >= 0)
	(players-building-type-count target-player castle <= 0);	(up-building-type-in-town c: castle <= 0)
	(players-building-type-count target-player bombard-tower <= 0);	(up-building-type-in-town c: bombard-tower <= 0)
	(players-building-type-count target-player watch-tower <= 0)
	(players-building-type-count target-player guard-tower <= 0)
	(players-building-type-count target-player keep <= 0)
	(players-building-type-count target-player donjon <= 0)
	(players-building-type-count target-player krepost <= 0)
(or	(population g:>= max-civ-pop); test
(or	(unit-type-count battering-ram-line >= 1)
(or	(unit-type-count armored-elephant-line >= 1)
(or	(unit-type-count trebuchet-set >= 1)
(or	(unit-type-count traction-trebuchet >= 1)
	(unit-type-count bombard-cannon-line >= 2))))))
=>
	(up-modify-sn sn-safe-town-size c:+ 1)
	(up-modify-sn sn-safe-town-size s:min sn-maximum-town-size))

(defrule
	(up-compare-const ability-to-kite <= 75)
=>
	(set-difficulty-parameter ability-to-maintain-distance 75)); 0
(defrule; test
	(up-compare-const ability-to-kite <= 81)
(or	(strategic-number sn-military-superiority >= 2)
	(and	(strategic-number sn-military-superiority >= 0)
		(goal attacking yes)))
=>
	(set-difficulty-parameter ability-to-maintain-distance 81)); 25
(defrule; test
	(up-compare-const ability-to-kite <= 88)
	(strategic-number sn-military-superiority >= 3)
	(goal attacking yes)
=>
	(set-difficulty-parameter ability-to-maintain-distance 88)); 50
(defrule; test
	(up-compare-const ability-to-kite <= 94)
	(strategic-number sn-military-superiority >= 4)
	(goal attacking yes)
=>
	(set-difficulty-parameter ability-to-maintain-distance 94)); 75
(defrule
	(military-population < 40)
(or	(goal attacking no)
	(and	(military-population g:< ten-pop)
		(population g:< desired-civ-pop)))
(or	(goal under-attack yes)
(or	(population g:< desired-civ-pop)
	(and	(town-under-attack)
		(strategic-number sn-military-superiority <= -1))))
=>
	(set-difficulty-parameter ability-to-maintain-distance 0))
(defrule
	(unit-type-count fire-galley-line >= 1)
	(soldier-count <= 1)
	(unit-type-count galley-line <= 0)
	(unit-type-count siege-ship <= 0)
	(unit-type-count longboat-line <= 0)
	(unit-type-count caravel-line <= 0)
	(unit-type-count turtle-ship-line <= 0)
=>
	(set-difficulty-parameter ability-to-maintain-distance 100))
(defrule
	(population g:>= del-civ-pop)
	(soldier-count >= 2)
=>
	(set-difficulty-parameter ability-to-maintain-distance 100))

(defrule
(or	(and	(civ-selected mongol)
		(and	(up-set-target-by-id g: scouting-unit)
			(up-object-data object-data-base-type == scout-cavalry)))
(or	(and	(players-civ any-ally mongol)
		(and	(up-set-target-by-id g: scouting-unit)
			(up-object-data object-data-base-type == scout-cavalry)))
	(and	(players-civ any-ally armenians)
		(and	(up-set-target-by-id g: scouting-unit)
			(up-object-data object-data-class == infantry-class)))))
=>
	(up-modify-goal scout-los c:+ 2)
	(up-modify-goal scout-los c:min 20)
	(disable-self))
(defrule
	(current-age >= feudal-age)
=>
	(up-modify-goal scout-los c:+ feudal-scout-los-bonus)
	(up-modify-goal scout-los c:min 20)
	(disable-self))
(defrule
	(true)
=>
	(up-modify-goal neg-scout-dist g:= scout-los)
	(up-modify-goal neg-scout-dist c:* -2)
	(up-modify-goal neg-scout-dist c:max -20)
	(up-modify-goal scout-dist g:= scout-los)
	(up-modify-goal scout-dist c:* 2)
	(up-modify-goal scout-dist c:min 20))

