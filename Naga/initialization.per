	(and	(up-resource-amount amount-exploration >= 10)
		(and	(up-get-fact players-in-game any temporary-goal)
			(and	(up-modify-goal temporary-goal2 c:= 10000)
				(and	(up-modify-goal temporary-goal2 g:z/ map-size)
					(and	(up-modify-goal temporary-goal2 g:z/ temporary-goal)
						(and	(up-modify-goal temporary-goal2 c:min 50)
							(up-resource-amount amount-exploration g:>= temporary-goal2)))))))))
=>
