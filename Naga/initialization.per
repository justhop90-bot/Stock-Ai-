(defrule
	(up-compare-goal TC-up != no)
	(building-type-count-total town-center < 3)
	(population g:< max-civ-pop); hmm
	(up-compare-goal custom-civ-pop-total g:< desired-civ-pop); hmm
	(civilian-population g:< desired-civ-pop); hmm
=>
	(set-goal TC-up no))
(defrule
	(up-compare-goal TC-up != yes)
(or	(building-type-count-total town-center >= 3)
(or	(population g:>= max-civ-pop); hmm
(or	(up-compare-goal custom-civ-pop-total g:>= desired-civ-pop); hmm
	(civilian-population g:>= desired-civ-pop)))); hmm
	(building-type-count-total town-center >= 1)
=>
	(set-goal TC-up yes))
(defrule
(or	(goal TC-up yes)
(or	(goal player-position pocket)
(or	(building-type-count-total siege-workshop >= 1)
(or	(building-type-count-total stable >= 2)
(or	(building-type-count-total archery-range >= 2)
(or	(building-type-count-total barracks >= 2)
(or	(building-type-count-total monastery >= 2)
(or	(building-type-count-total castle >= 1)
