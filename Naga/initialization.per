	(up-modify-goal pond-fishing c:max 1)
	(disable-self))
(defrule
	(up-compare-goal pond-fishing <= 1)
	(building-type-count dock >= 1)
	(up-idle-unit-count idle-type-fishing-ship >= 1)
	(up-gaia-type-count c: shore-fish-class <= 0)
	(up-gaia-type-count c: ocean-fish-class <= 0)
	(up-gaia-type-count c: whale-class <= 0)
=>
	(up-modify-goal pond-fishing c:max 2))
(defrule
	(up-compare-goal pond-fishing <= 1)
	(building-type-count dock >= 1)
	(up-idle-unit-count idle-type-fishing-ship >= 1)
=>
	(up-full-reset-search)
	(up-find-local c: fishing-ship-class c: 20)
	(up-remove-objects search-local object-data-idling != 1))
(defrule
	(up-compare-goal pond-fishing <= 1)
	(building-type-count dock >= 1)
	(up-idle-unit-count idle-type-fishing-ship >= 1)
	(up-set-target-object search-local c: 0)
=>
	(up-get-object-data object-data-map-zone-id temporary-goal)
	(up-filter-status c: status-gather c: list-active)
	(up-find-resource c: shore-fish-class c: 40)
	(up-find-resource c: ocean-fish-class c: 40)
	(up-find-resource c: whale-class c: 40)
	(up-remove-objects search-remote object-data-map-zone-id g:!= temporary-goal))
(defrule
	(up-compare-goal pond-fishing <= 1)
	(building-type-count dock >= 1)
	(up-idle-unit-count idle-type-fishing-ship >= 1)
	(up-set-target-object search-local c: 0)
(not	(up-set-target-object search-remote c: 0))
=>
	(up-modify-goal pond-fishing c:max 2))

(defrule
	(up-compare-goal pond-fishing >= 1)
(or	(and	(up-compare-goal custom-civ-pop-total g:>= min-number-vills)
		(building-type-count-total dock <= 0))
(or	(up-compare-goal under-attack != no)
(or	(and	(up-compare-goal dead-villagers >= 1)
		(unit-type-count fishing-ship-class <= 0))
(or	(and	(up-compare-goal enemy-boats != no)
		(and	(up-compare-goal navy-count g:< e-biggest-navy)
			(or	(up-compare-goal enemy-age >= dfeudal)
				(players-current-age any-enemy >= feudal-age))))
	(and	(building-type-count-total fish-trap <= 0)
		(and	(up-compare-goal excess-food >= 1000)
			(or	(up-compare-goal custom-civ-pop-total g:>= desired-civ-pop)
				(population g:>= max-civ-pop))))))))
=>
	(set-goal pond-fishing 0))
(defrule
	(up-compare-goal pond-fishing >= 1)
(or	(unit-type-count fishing-ship-class >= 1)
	(building-type-count fish-trap >= 1))
=>
	(up-full-reset-search)
	(up-find-local c: fishing-ship-class c: 20)
	(up-find-local c: fish-trap c: 20)
	(up-remove-objects search-local object-data-under-attack != 1))
(defrule
	(up-compare-goal pond-fishing >= 1)
(or	(unit-type-count fishing-ship-class >= 1)
	(building-type-count fish-trap >= 1))
	(up-set-target-object search-local c: 0)
=>
	(set-goal pond-fishing 0))


(defrule
(or	(up-compare-goal map-type >= type-islands)
(or	(map-type islands)
	(map-type team-islands)))
(or	(goal enemy-boats no)
	(strategic-number sn-minimum-water-body-size-for-dock > 700))
=>
	(set-goal enemy-boats yes)
	(up-modify-goal map-type c:max type-water)
	(up-modify-sn sn-minimum-water-body-size-for-dock c:min 700)
	(up-jump-rule 3))
(defrule
(or	(players-building-type-count any-enemy dock >= 1)
(or	(players-unit-type-count any-enemy fishing-ship >= 1)
(or	(players-unit-type-count any-enemy oystering-ship >= 1)
(or	(players-unit-type-count any-enemy whaling-ship >= 1)
(or	(players-unit-type-count any-enemy transport-ship >= 1)
	(up-compare-goal e-biggest-navy >= 1))))))
(or	(up-compare-goal enemy-boats != yes)
	(up-compare-goal map-type <= type-land))
=>
	(set-goal enemy-boats yes)
	(up-modify-goal map-type c:max type-water)
	(up-modify-sn sn-minimum-water-body-size-for-dock c:min 1000)
	(up-jump-rule 2))
(defrule
	(up-compare-goal effective-fish >= 64)
(or	(strategic-number sn-minimum-water-body-size-for-dock > 1000)
	(up-compare-goal map-type <= type-land))
=>
	(up-modify-goal map-type c:max type-water)
	(up-modify-sn sn-minimum-water-body-size-for-dock c:min 1000)
	(up-jump-rule 1))
(defrule 
	(up-compare-goal enemy-boats != no)
	(up-compare-goal map-type <= type-water)
	(players-building-type-count every-enemy dock <= 0)
	(players-unit-type-count every-enemy fishing-ship <= 0)
	(players-unit-type-count every-enemy oystering-ship <= 0)
	(players-unit-type-count every-enemy whaling-ship <= 0)
	(players-unit-type-count every-enemy transport-ship <= 0)
	(up-compare-goal e-biggest-navy <= 0)
=>
	(set-goal enemy-boats no)
	(up-modify-sn sn-minimum-water-body-size-for-dock c:max 1400)); end mini jumps
(defrule
	(false); temp
	(up-compare-flag starting-dropsite-flag == f-dock)
=>
	(up-modify-sn sn-minimum-water-body-size-for-dock c:min 1000))

(defrule
;	(wood-amount >= 200)
	(up-compare-goal strategy-type2 != type-water)
	(building-type-count-total dock <= 0)
(or	(and	(false);(strategic-number sn-current-age <= dark)
		(or	(unit-type-count villager >= 15)
			(up-compare-goal enemy-age >= dfeudal)))
(or	(up-compare-goal custom-civ-pop-total g:>= desired-civ-pop)
(or	(civilian-population g:>= desired-civ-pop)
	(population g:>= max-civ-pop))))
	(building-type-count-total town-center >= 1)
;	(building-type-count-total wood-placement-camp >= 1)
=>
	(up-modify-goal effective-fish c:min 0))
(defrule
	(up-compare-goal strategy-type2 != type-water)
	(unit-type-count-total fishing-ship >= 4); 3
(or	(goal enemy-boats yes);
	(unit-type-count-total fishing-ship >= 8)); 5
	(building-type-count-total dock <= 1)
	(up-compare-goal map-type <= type-water)
=>
	(up-modify-goal effective-fish c:min 0))




(defrule
	(players-building-count target-player <= 0)
=>
	(up-jump-rule 4))
(defrule
	(up-compare-goal max-pop >= 300)
=>
	(up-modify-goal temporary-goal g:= max-pop)
	(up-modify-goal temporary-goal c:- 100)
	(up-modify-goal temporary-goal c:z/ 100)
	(up-modify-sn sn-minimum-attack-group-size g:max temporary-goal)
	(up-modify-sn sn-maximum-attack-group-size g:max allowed-num-military)
	(up-modify-sn sn-maximum-attack-group-size c:min 20)
	(up-jump-rule 4))
(defrule
	(strategic-number sn-target-player-number g:== winning-player)
	(up-compare-goal victory-time < 1000)
	(up-compare-goal victory-time >= 0)
=>
	(up-jump-rule 2))
(defrule
(or	(difficulty == easiest)
(or	(difficulty == easy)
	(difficulty == moderate)))
=>
	(set-goal temporary-goal diff-id)
	(up-modify-goal temporary-goal c:max 1)
	(up-modify-goal temporary-goal c:* 2)
	(up-modify-goal temporary-goal g:min allowed-num-military)
	(up-modify-sn sn-minimum-attack-group-size g:max temporary-goal)
	(up-modify-sn sn-maximum-attack-group-size g:max allowed-num-military)
	(up-modify-sn sn-maximum-attack-group-size c:min 20)
	(up-jump-rule 2))
(defrule
(or	;(and
	(up-compare-const diff-fp <= 0)
	;	(difficulty == hard))
	(and	(up-compare-goal gl-threat-time >= 8000)
		(strategic-number sn-siege <= 0)))
=>
	(set-goal temporary-goal diff-id)
	(up-modify-goal temporary-goal c:max 1)
	(up-modify-goal temporary-goal c:* 2)
	(up-modify-goal temporary-goal g:min allowed-num-military)
	(up-modify-sn sn-minimum-attack-group-size g:max temporary-goal)
	(up-modify-sn sn-maximum-attack-group-size g:max allowed-num-military)
	(up-modify-sn sn-maximum-attack-group-size c:min 20)
	(up-jump-rule 1)); end jump
(defrule
(or	(strategic-number sn-minimum-attack-group-size != 1)
	(strategic-number sn-maximum-attack-group-size != 1))
(nor	(map-type islands)
	(map-type team-islands))
	(up-compare-goal map-type <= type-water)
	(up-compare-flag micro-flag != f-drush-micro)
	(up-compare-flag micro-flag != f-scrush-micro)
=>
	(set-strategic-number sn-minimum-attack-group-size 1)
;	(up-chat-data-to-self "minimum-attack-group-size: %d" s: sn-minimum-attack-group-size)
	(set-strategic-number sn-maximum-attack-group-size 1)); end jump
(defrule
;	(goal attack-method attack-groups)
	(false)
	(goal map-type type-land)
	(up-compare-flag micro-flag != f-drush-micro)
	(up-compare-flag micro-flag != f-scrush-micro)
	(players-military-population every-enemy <= 1)
=>
	(up-modify-sn sn-maximum-attack-group-size c:max 20))

(defrule
(or	(strategic-number sn-minimum-attack-group-size <= 0)
(or	(strategic-number sn-minimum-attack-group-size g:> my-mpop)
(or	(strategic-number sn-minimum-attack-group-size g:> allowed-num-military)
	(strategic-number sn-minimum-attack-group-size s:> sn-maximum-attack-group-size))))
=>
;	(up-chat-data-to-self "minimum-attack-group-size (SF): %d" s: sn-minimum-attack-group-size)
	(up-modify-sn sn-minimum-attack-group-size g:min my-mpop)
	(up-modify-sn sn-minimum-attack-group-size g:min allowed-num-military)
	(up-modify-sn sn-minimum-attack-group-size s:min sn-maximum-attack-group-size)
	(up-modify-sn sn-minimum-attack-group-size c:min 20)
	(up-modify-sn sn-minimum-attack-group-size c:max 1))

(defrule
	(unit-type-count-total transport-ship >= 1)
(or	(strategic-number sn-minimum-attack-group-size < 5)
