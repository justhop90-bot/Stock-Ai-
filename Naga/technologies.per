(defrule
	(true)
=>
	(set-goal tech-flag 0)
	(set-goal tech-flag2 0)
	(set-goal tech-flag3 0)
	(set-goal tech-flag4 0)
	(set-goal tech-flag5 0)
	(set-goal ur-C-goal no)
	(set-goal ur-I-goal no))
;=============================================================
;
; Age advancement
;
;=============================================================
#load-if-not-defined DIFFICULTY-MODERATE
#load-if-not-defined DIFFICULTY-HARD
#load-if-not-defined DIFFICULTY-HARDEST
#load-if-not-defined DIFFICULTY-EXTREME
(defrule
	(up-compare-const diff-fp != 1)
	(player-in-game any-human)
	(players-current-age every-enemy <= dark-age)
	(players-current-age every-ally <= dark-age)
(or	(difficulty != moderate)
	(up-compare-goal enemy-age <= dark))
=>
	(up-jump-rule 4))
#end-if
#end-if
#end-if
#end-if
(defrule
	(and	(goal strategy fast-imp)
		(unit-type-count-total villager < fi-vills))
=>
	(up-jump-rule 2))
(defrule
	(research-available feudal-age)
	(building-type-count town-center >= 1)
(or	(up-compare-goal total-food-amount >= 1235); 990 ; (food-amount >= 700); 720
(or	(unit-type-count-total villager >= dark-vills)
	(and	(goal player-position flank)
		(or	(players-current-age focus-player >= feudal-age)
			(and	(up-compare-goal enemy-age >= dfeudal)
				(up-compare-const custom-civ-pop g:> focus-cpop))))))
=>
	(up-modify-flag tech-flag c:+ 1)
	(up-jump-rule 2))
(defrule
	(research-available feudal-age)
	(building-type-count town-center >= 1)
(or	(and	(up-compare-goal total-food-amount >= 990); 780 ; (food-amount >= 650)
		(up-compare-goal custom-civ-pop >= 30))
(or	(goal strategy sling)
	(up-compare-goal strategy-type == feudal-war)))
=>
	(up-modify-flag tech-flag c:+ 1)
	(up-jump-rule 1)); end jump
(defrule
	(research-available feudal-age)
	(building-type-count town-center >= 1)
	(up-compare-goal train-villager != yes)
(or	(building-type-count-total town-center >= 2)
(or	(up-pending-objects c: villager <= 0)
	(and	(up-pending-objects c: villager <= 1)
		(and	(up-set-target-by-id g: position-self-id)
			(up-object-data object-data-progress-value >= 90))))); >=
=>
	(up-modify-flag tech-flag c:+ 1)); end jumps
;=============================================================
#load-if-not-defined DIFFICULTY-MODERATE
#load-if-not-defined DIFFICULTY-HARD
#load-if-not-defined DIFFICULTY-HARDEST
#load-if-not-defined DIFFICULTY-EXTREME
(defrule
	(up-compare-const diff-fp != 1)
	(player-in-game any-human)
	(players-current-age every-enemy <= feudal-age)
	(players-current-age every-ally <= feudal-age)
=>
	(up-jump-rule 1))
#end-if
#end-if
#end-if
#end-if
(defrule
	(research-available castle-age)
	(building-type-count town-center >= 1)
=>
	(up-modify-flag tech-flag c:+ 2)); end jump
;=============================================================
#load-if-not-defined DIFFICULTY-MODERATE
#load-if-not-defined DIFFICULTY-HARD
#load-if-not-defined DIFFICULTY-HARDEST
#load-if-not-defined DIFFICULTY-EXTREME
(defrule
	(up-compare-const diff-fp != 1)
	(player-in-game any-human)
	(players-current-age every-enemy <= castle-age)
	(players-current-age every-ally <= castle-age)
=>
	(up-jump-rule 1))
#end-if
#end-if
#end-if
#end-if
(defrule
	(research-available imperial-age)
	(building-type-count town-center >= 1)
=>
	(up-modify-flag tech-flag c:+ 4)); end jump
;=============================================================
(defrule
(or	(and	(up-compare-flag tech-flag == 1)
		(and	(research-available feudal-age)
			(can-afford-research feudal-age)))
(or	(and	(up-compare-flag tech-flag == 2)
		(and	(research-available castle-age)
			(can-afford-research castle-age)))
	(and	(up-compare-flag tech-flag == 4)
		(and	(research-available imperial-age)
			(can-afford-research imperial-age)))))
=>
	(up-full-reset-search)
	(up-find-local c: town-center c: 10)
	(up-remove-objects search-local object-data-under-attack >= 1)
	(up-remove-objects search-local object-data-progress-type <= -2)
	(up-remove-objects search-local object-data-train-count >= 2)
	(up-clean-search search-local object-data-progress-type search-order-asc))
(defrule
(or	(and	(up-compare-flag tech-flag == 1)
		(and	(research-available feudal-age)
			(can-afford-research feudal-age)))
(or	(and	(up-compare-flag tech-flag == 2)
		(and	(research-available castle-age)
			(can-afford-research castle-age)))
	(and	(up-compare-flag tech-flag == 4)
		(and	(research-available imperial-age)
			(can-afford-research imperial-age)))))
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-progress-type >= 1)
=>
	(up-clean-search search-local object-data-progress-value search-order-desc))
(defrule
	(up-compare-flag tech-flag == 1)
	(research-available feudal-age)
	(can-afford-research feudal-age)
	(up-set-target-object search-local c: 0)
=>
	;(chat-to-player every-ally text-advancing-feudal); "I am advancing to the Feudal Age."
	(chat-to-player my-player-number text-advancing-feudal); "I am advancing to the Feudal Age."
	(up-remove-objects search-local object-data-index >= 1)
	(up-target-point 0 action-research c: feudal-age)
	(up-modify-sn sn-current-age c:max dfeudal)
	(up-modify-sn sn-maximum-town-size c:min 12)
	(set-strategic-number sn-enable-boar-hunting 1)
	(up-modify-flag tech-flag c:- 1))
(defrule
	(up-compare-flag tech-flag == 2)
	(research-available castle-age)
	(can-afford-research castle-age)
	(up-set-target-object search-local c: 0)
=>
	;(chat-to-player every-ally text-advancing-castle); "I am advancing to the Castle Age."
	(chat-to-player my-player-number text-advancing-castle); "I am advancing to the Castle Age."
	(up-remove-objects search-local object-data-index >= 1)
	(up-target-point 0 action-research c: castle-age)
	(up-modify-sn sn-current-age c:max fcastlea)
	(up-modify-sn sn-maximum-town-size c:min 14)
	(up-modify-flag tech-flag c:- 2))
(defrule
	(up-compare-flag tech-flag == 4)
	(research-available imperial-age)
	(can-afford-research imperial-age)
	(up-set-target-object search-local c: 0)
=>
	;(chat-to-player every-ally text-advancing-imperial); "I am advancing to the Imperial Age."
	(chat-to-player my-player-number text-advancing-imperial); "I am advancing to the Imperial Age."
	(up-remove-objects search-local object-data-index >= 1)
	(up-target-point 0 action-research c: imperial-age)
	(up-modify-sn sn-current-age c:max cimperial)
	(up-modify-sn sn-maximum-town-size c:min 18)
	(up-modify-flag tech-flag c:- 4))
(defrule
	(up-compare-flag tech-flag == 1)
	(can-research feudal-age)
=>
	;(chat-to-player every-ally text-advancing-feudal); "I am advancing to the Feudal Age."
	(chat-to-player my-player-number text-advancing-feudal); "I am advancing to the Feudal Age."
	(research feudal-age)
	(up-modify-sn sn-current-age c:max dfeudal)
	(up-modify-sn sn-maximum-town-size c:min 12)
	(set-strategic-number sn-enable-boar-hunting 1)
	(up-modify-flag tech-flag c:- 1))
(defrule
	(up-compare-flag tech-flag == 2)
	(can-research castle-age)
=>
	;(chat-to-player every-ally text-advancing-castle); "I am advancing to the Castle Age."
	(chat-to-player my-player-number text-advancing-castle); "I am advancing to the Castle Age."
	(research castle-age)
	(up-modify-sn sn-current-age c:max fcastlea)
	(up-modify-sn sn-maximum-town-size c:min 14)
	(up-modify-flag tech-flag c:- 2))
(defrule
	(up-compare-flag tech-flag == 4)
	(can-research imperial-age)
=>
	;(chat-to-player every-ally text-advancing-imperial); "I am advancing to the Imperial Age."
	(chat-to-player my-player-number text-advancing-imperial); "I am advancing to the Imperial Age."
	(research imperial-age)
	(up-modify-sn sn-current-age c:max cimperial)
	(up-modify-sn sn-maximum-town-size c:min 18)
	(up-modify-flag tech-flag c:- 4))
;=============================================================
; Unique upgrades
;=============================================================
(defrule
(nor	(civ-selected byzantine)
(or	(civ-selected briton)
(or	(civ-selected chinese)
(or	(civ-selected mongol)
(or	(civ-selected korean)
(or	(civ-selected italian)
(or	(civ-selected berbers)
(or	(civ-selected portuguese)
(or	(civ-selected slavic)
(or	(civ-selected vietnamese)
	(civ-selected sicilians)))))))))))
=>
	(up-jump-rule 3))
(defrule
	(up-compare-goal strategy != besar)
=>
	(up-jump-rule 2))
(defrule
	(up-compare-const uu-type != archer-uu)
	(up-compare-const uu-type != powder-uu)
	(strategic-number sn-monks >= 15)
	(unit-type-count-total scout-cavalry-line s:< sn-monks)
	(unit-type-count-total eagle-scout-line s:< sn-monks)
(or	(research-available ri-devotion)
(or	(research-available ri-faith)
	(research-available ri-heresy)))
=>
	(up-jump-rule 1))
(defrule
	(up-compare-flag power-unit-flag != f-unique)
	(strategic-number sn-current-age >= cimperial)
	(up-compare-flag power-unit-flag != f-paladin)
	(up-compare-flag power-unit-flag != f-champion)
	(up-compare-flag power-unit-flag != f-cavalry-archer)
	(up-compare-flag power-unit-flag != f-hand-cannoneer)
	(up-compare-flag power-unit-flag != f-arbalester)
	(up-compare-flag power-unit-flag != f-eagle-warrior)
	(up-compare-flag power-unit-flag != f-battle-elephant)
	(up-compare-flag power-unit-flag != f-steppe-lancer)
;	(up-compare-flag power-unit-flag != f-hussar)
	(up-compare-flag power-unit-flag != f-elephant-archer)
	(up-compare-flag power-unit-flag != f-condottiero)
	(up-compare-flag power-unit-flag != f-camel-rider)
	(up-compare-flag power-unit-flag != f-fire-lancer)
=>
	(up-modify-flag power-unit-flag c:+ f-unique)); end jumps

(defrule
	(up-compare-flag power-unit-flag != f-unique)
;(or	(up-compare-goal trade-units >= 25)
(or	(and	(unit-type-count-total my-unique-unit-line g:< train-unique)
		(or	(up-research-status c: my-unique-unit-upgrade >= research-pending)
			(population g:>= max-civ-pop)))
(or	(unit-type-count-total my-unique-unit-line >= 6)
(or	(unit-type-count-total tarkan-set >= 6)
(or	(unit-type-count-total serjeant-set >= 6)
	(unit-type-count-total huskarl-set >= 6)))))
=>
	(up-modify-flag power-unit-flag c:+ f-unique))

(defrule
	(up-compare-flag tech-flag != 8)
	(research-available my-unique-unit-upgrade)
	(building-type-count castle >= 1)
(or	(up-compare-flag power-unit-flag == f-unique)
	(up-compare-goal excess-gold >= 2900)); 3600
=>
	(up-modify-flag tech-flag c:+ 8)
	(up-jump-rule 1))
(defrule
	(up-compare-flag tech-flag != 8)
	(research-available my-unique-unit-upgrade)
	(building-type-count castle >= 1)
	(up-compare-goal excess-gold >= 2500)
(or	(population g:>= max-civ-pop)
(or	(population >= 192)
(or	(up-compare-goal relic-count >= 3); 4
(or	(up-compare-goal trade-units >= 30); 40
	(up-compare-goal trade-units g:>= desired-trade-pop)))))
=>
	(up-modify-flag tech-flag c:+ 8)
	(up-jump-rule 1))
(defrule
	(up-compare-flag tech-flag == 8)
	(can-research my-unique-unit-upgrade)
=>
	(research my-unique-unit-upgrade)
	(up-modify-flag tech-flag c:- 8))


(defrule
(nor	(civ-selected aztec)
(or	(civ-selected briton)
(or	(civ-selected byzantine)
(or	(civ-selected chinese)
(or	(civ-selected frankish)
(or	(civ-selected viking)
(or	(civ-selected berbers)
(or	(civ-selected khmer)
(or	(civ-selected portuguese)
(or	(civ-selected incan)
(or	(civ-selected dravidians)
(or	(civ-selected georgians)
	(civ-selected romans)))))))))))))
=>
	(up-jump-rule 2))
(defrule
	(up-research-status c: my-unique-unit-upgrade >= research-pending)
	(up-compare-flag tech-flag != 32)
	(research-available my-unique-research)
	(building-type-count castle >= 1)
=>
	(up-modify-flag tech-flag c:+ 32))
(defrule
	(up-compare-goal ur-I-goal != yes)
	(up-research-status c: my-unique-unit-upgrade >= research-pending)
(or	(unit-type-count-total my-unique-unit-line >= 10)
(or	(and	(civ-selected hun)
		(unit-type-count-total tarkan-set >= 10))
	(and	(civ-selected gothic)
		(unit-type-count-total huskarl-set >= 10))))
=>
	(set-goal ur-I-goal yes)); end jump


#load-if-defined GOTHIC-CIV
(defrule
(or	(players-civ any-ally italian)
(or	(unit-available condottiero)
	(unit-available condottiero)))
	(up-compare-flag power-unit-flag != f-condottiero)
(nor(players-civ focus-player aztec)
(or	(players-civ focus-player mayan)
(or	(players-civ focus-player incan)
	(players-civ any-enemy japanese))))
	(up-research-status c: imperial-age >= research-pending);	(up-compare-flag power-unit-flag != f-condottiero)
	(strategic-number sn-current-age >= cimperial)
(or	(up-compare-goal trade-units >= 4)
	(up-compare-goal relic-count >= 2))
(or	(players-civ focus-player bohemians)
(or	(up-compare-goal trade-units >= 2)
	(up-compare-goal relic-count >= 1)))
	(up-compare-flag power-unit-flag != f-paladin)
	(up-compare-flag power-unit-flag != f-unique)
	(up-compare-flag power-unit-flag != f-champion)
=>
	(up-modify-flag power-unit-flag c:+ f-condottiero)
	(disable-self))
(defrule
	(up-compare-flag power-unit-flag != f-unique)
(or	(up-compare-flag power-unit-flag != f-condottiero)
	(up-compare-goal trade-units >= 30))
(or	(and	(strategic-number sn-archers >= 18)
		(strategic-number sn-gunpowder < 12))
	(and	(current-age >= imperial-age)
		(and	(building-type-count-total castle >= 1)
			(up-compare-flag power-unit-flag != f-champion))))
	(strategic-number sn-current-age >= cimperial)
=>
	(up-modify-flag power-unit-flag c:+ f-unique)
	(disable-self))
(defrule
	(up-compare-flag power-unit-flag != f-unique)
(or	(players-civ focus-player mayan)
	(players-civ target-player mayan))
	(strategic-number sn-current-age >= cimperial)
=>
	(up-modify-flag power-unit-flag c:+ f-unique)
	(disable-self))
(defrule
(or	(unit-type-count-total huskarl-set >= 1)
(or	(up-research-status c: my-unique-unit-upgrade >= research-pending)
	(and	(up-compare-flag power-unit-flag == f-unique)
		(up-research-status c: my-unique-unit-upgrade != research-available))))
(or	(up-compare-goal strategy-type <= castle-war)
	(strategic-number sn-current-age >= cimperial))
(or	(gold-amount >= 650); 850
(or	(up-compare-flag power-unit-flag == f-unique)
	(unit-type-count-total my-unique-unit-line g:< train-unique)))
;	(nand	(up-research-status c: ri-champion >= research-pending)
;		(up-research-status c: ri-perfusion < research-pending)))
	(up-compare-flag tech-flag != 16)
	(research-available my-second-unique-research)
	(building-type-count castle >= 1)
=>
	(up-modify-flag tech-flag c:+ 16))
(defrule
	(up-compare-goal ur-C-goal != yes)
	(research-available my-second-unique-research)
	(building-type-count castle >= 1)
	(up-research-status c: my-unique-unit-upgrade != research-available)
	(unit-type-count-total my-unique-unit-line g:< train-unique)
	(up-compare-flag power-unit-flag == f-unique)
	(strategic-number sn-current-age >= cimperial)
	(up-research-status c: imperial-age != research-pending)
	(building-type-count-total barracks >= 1)
(or	(up-research-status c: my-unique-research != research-available)
(or	(and	(building-type-count castle <= 1)
		(building-type-count-total castle <= 2))
(or	(up-compare-goal custom-civ-pop g:>= desired-civ-pop)
	(population g:>= max-civ-pop))))
=>
	(set-goal ur-C-goal yes))
(defrule
(or	(up-compare-goal custom-civ-pop g:>= desired-civ-pop)
(or	(unit-type-count-total spearman-line g:< train-pike)
(or	(unit-type-count-total condottiero g:< train-condottiero)
(or	(up-research-status c: ri-champion >= research-pending)
(or	(up-compare-flag power-unit-flag == f-champion)
(or	(up-compare-flag power-unit-flag == f-condottiero)
	(and	(up-compare-flag power-unit-flag == f-unique)
		(up-research-status c: ri-anarchy >= research-pending))))))))
	(up-compare-flag tech-flag != 32)
	(research-available my-unique-research)
	(building-type-count castle >= 1)
=>
	(up-modify-flag tech-flag c:+ 32))
(defrule
	(up-compare-goal ur-I-goal != yes)
	(research-available my-unique-research)
	(building-type-count castle >= 1)
(or	(up-compare-flag power-unit-flag == f-champion)
(or	(up-compare-flag power-unit-flag == f-condottiero)
	(up-compare-flag power-unit-flag == f-unique)))
	(up-compare-goal excess-food >= 2600)
	(up-compare-goal excess-gold >= 1300)
	(building-type-count-total barracks >= 1)
=>
	(set-goal ur-I-goal yes))
#end-if
#load-if-defined HUN-CIV
#load-if-defined VICTORY-STANDARD
(defrule
	(players-building-type-count any-enemy wonder >= 1)
	(building-type-count-total wonder <= 0)
	(players-building-type-count every-ally wonder <= 0)
	(up-compare-flag tech-flag != 32)
	(research-available my-unique-research)
	(building-type-count castle >= 1)
=>
	(up-modify-flag tech-flag c:+ 32))
(defrule
	(up-compare-goal ur-I-goal != yes)
	(research-available my-unique-research)
	(building-type-count castle >= 1)
	(game-time > 8)
	(up-compare-goal victory-time >= 0)
	(up-compare-goal victory-time <= 750)
(not	(hold-relics))
	(building-type-count wonder <= 0)
	(players-building-type-count every-ally wonder <= 0)
(or	(players-building-type-count any-enemy wonder >= 1)
	(enemy-captured-relics))
=>
	(set-goal ur-I-goal yes))
#end-if
(defrule
(or	(enemy-captured-relics)
	(population g:>= max-pop))
	(up-compare-flag tech-flag != 32)
	(research-available my-unique-research)
	(building-type-count castle >= 1)
=>
	(up-modify-flag tech-flag c:+ 32))
(defrule
	(up-compare-goal ur-I-goal != yes)
	(research-available my-unique-research)
	(building-type-count castle >= 1)
	(enemy-captured-relics)
=>
	(set-goal ur-I-goal yes))
(defrule
	(up-research-status c: my-unique-unit-upgrade >= research-pending)
(or	(up-compare-flag power-unit-flag == f-unique)
(or	(unit-type-count-total my-unique-unit-line g:< train-unique)
(or	(unit-type-count-total my-unique-unit-line >= 4)
	(unit-type-count-total tarkan-line >= 4))))
	(up-compare-flag tech-flag != 16)
	(research-available my-second-unique-research)
	(building-type-count castle >= 1)
=>
	(up-modify-flag tech-flag c:+ 16))
(defrule
	(up-compare-goal ur-C-goal != yes)
	(research-available my-second-unique-research)
	(building-type-count castle >= 1)
	(up-research-status c: my-unique-unit-upgrade != research-available)
	(unit-type-count-total my-unique-unit-line g:< train-unique)
	(up-compare-flag power-unit-flag == f-unique)
	(strategic-number sn-current-age >= cimperial)
	(up-research-status c: imperial-age != research-pending)
	(building-type-count-total stable >= 1)
=>
	(set-goal ur-C-goal yes))
#end-if
#load-if-defined CELTIC-CIV
(defrule
	(up-compare-flag power-unit-flag != f-unique)
	(up-compare-flag power-unit-flag != f-paladin); hm
	(up-compare-flag power-unit-flag != f-champion); hm
	(strategic-number sn-current-age >= cimperial)
(or	(strategic-number sn-archers < 25); 25
(or	(strategic-number sn-shock-infantry >= 10); 15
	(strategic-number sn-husks >= 10))); 15
;	(goal escrowing no)
;(or	(up-compare-goal custom-civ-pop g:>= desired-civ-pop);	(civilian-population g:>= desired-civ-pop)
;	(up-compare-goal custom-civ-pop >= 90);	(civilian-population >= 90));
;	(building-type-count castle >= 1)
=>
	(up-modify-flag power-unit-flag c:+ f-unique))
(defrule
(or	(unit-type-count-total siege-weapon-class >= 4)
(or	(unit-type-count-total scorpion-class >= 4)
(or	(unit-type-count-total unpacked-trebuchet-class >= 1)
(or	(unit-type-count-total packed-trebuchet-class >= 1)
(or	(up-research-status c: ri-siege-onager >= research-pending)
(or	(up-research-status c: ri-heavy-scorpion >= research-pending)
(or	(up-research-status c: ri-siege-ram >= research-pending)
	(up-compare-goal excess-gold >= 1200))))))))
	(up-compare-flag tech-flag != 32)
	(research-available my-unique-research)
	(building-type-count castle >= 1)
=>
	(up-modify-flag tech-flag c:+ 32))
(defrule
	(up-compare-goal ur-I-goal != yes)
	(research-available my-unique-research)
	(building-type-count castle >= 1)
(or	(unit-type-count-total siege-weapon-class >= 8)
