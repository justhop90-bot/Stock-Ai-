	(and	(goal attacking yes)
		(or	(up-compare-goal navy-count g:>= thirty-pop)
			(or	(up-compare-goal navy-count-total g:>= max-navy)
				(or	(up-compare-goal navy-count g:>= e-biggest-navy)
					(population g:>= max-civ-pop)))))))); del
=>
