;=============================================================
; Townsize attack and groups - Actual attacking
;=============================================================
(defrule
(or	(up-compare-goal attacking != yes)
	(up-compare-goal gather-inside != no))
=>
	(set-goal attack-in-progress no))
(defrule
	(goal attacking yes)
	(goal gather-inside no)
=>
	(set-goal attack-in-progress yes))
(defrule
	(goal attacking yes)
	(goal attack-in-progress no)
	(not(enemy-buildings-in-town))
	(strategic-number sn-maximum-town-size g:< target-distance)
(or	(strategic-number sn-percent-attack-soldiers < 100)
	(strategic-number sn-number-attack-groups < 1000))
=>
	(chat-local-to-self "Starting attack.")
	(set-goal attack-start yes)
	(enable-timer reset-now-timer 1)); test

(defrule
	(up-compare-goal attack-method != town-size-attack)
=>
	(set-goal attack-method town-size-attack))
(defrule
	(up-compare-goal attack-method != attack-groups)
(or	(difficulty == easiest)
(or	(difficulty == easy)
(or	(difficulty == moderate)
(or	(up-compare-goal map-size >= 256)
	(goal strategy stonewall)))))
=>
	(set-goal attack-method attack-groups)
	(up-jump-rule 2))
(defrule
	(up-compare-goal attack-method != attack-groups)
(or	(up-compare-goal map-type >= type-water)
(or	(up-compare-goal map-type >= type-islands)
(or	(players-building-count target-player <= 0); every-enemy
(or	(players-building-type-count any-enemy stone-wall-line >= 6)
	(players-building-type-count any-enemy gate-class >= 2)))))
=>
	(set-goal attack-method attack-groups)
	(up-jump-rule 1))
(defrule
	(up-compare-goal attack-method != attack-groups)
	(up-compare-goal attacking != no)
	(up-get-target-fact building-count 0 temporary-goal)
	(up-compare-goal temporary-goal <= 0)
	(players-building-count target-player <= 0)
=>
	(set-goal attack-method attack-groups)); end jump

(defrule
	(up-compare-goal attack-method != town-size-attack)
=>
	(disable-self))
(defrule
	(up-compare-goal attack-method != attack-groups)
=>
