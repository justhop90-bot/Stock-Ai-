	(up-modify-goal temporary-goal2 c:max 7); 6
	(up-modify-goal temporary-goal2 g:min temporary-goal)
	(up-modify-sn sn-number-civilian-militia g:max temporary-goal2)
	(up-modify-sn sn-allow-civilian-offense c:max 2)
	(up-modify-sn sn-allow-civilian-defense c:max 2)
	(set-strategic-number sn-villager-attack-reset 0)); end mini jump
(defrule
;	(enemy-buildings-in-town)
(or	(up-building-type-in-town c: watch-tower >= 1)
	(up-building-type-in-town c: donjon >= 1))
	(strategic-number sn-maximum-town-size < 32);
	(up-compare-goal target-distance < 26)
	(goal attacking no)
	(up-compare-goal dead-villagers <= 1)
	(up-projectile-detected projectile-watch-tower < 4000)
	(players-building-type-count target-player palisade-wall <= 0)
	(players-building-type-count target-player stone-wall-line <= 0)
	(players-building-type-count target-player gate <= 0)
	(players-military-population target-player < 3)
=>
	(up-modify-sn sn-number-civilian-militia c:max 8)
	(up-modify-sn sn-allow-civilian-offense c:max 2)
	(set-strategic-number sn-villager-attack-reset 0))
(defrule
	(strategic-number sn-maximum-town-size < 32);
	(up-compare-goal target-distance < 26)
	(goal attacking no)
	(up-compare-goal dead-villagers <= 1)
	(up-projectile-detected projectile-watch-tower >= 4000)
	(players-building-type-count target-player palisade-wall <= 0)
	(players-building-type-count target-player stone-wall-line <= 0)
	(players-building-type-count target-player gate <= 0)
	(players-military-population target-player < 3)
=>
	(up-modify-sn sn-number-civilian-militia c:max 8)
	(up-modify-sn sn-allow-civilian-offense c:max 2)
	(set-strategic-number sn-villager-attack-reset 0)); end jump
(defrule
	(up-compare-const infinite-resources == yes)
	(unit-type-count villager >= 11)
=>
	(up-modify-goal temporary-goal g:= villager-count)
	(up-modify-goal temporary-goal c:- 10)
	(up-modify-goal temporary-goal c:max 0)
	(up-modify-sn sn-number-civilian-militia g:max temporary-goal)
	(up-modify-sn sn-allow-civilian-offense c:max 2)
	(set-strategic-number sn-villager-attack-reset 0))
;==============================================================
; Misc
;==============================================================
(defrule
	(goal enough-siege no)
=>
	(up-get-fact unit-type-count-total trebuchet-set temporary-goal)
	(up-modify-goal temporary-goal2 g:= temporary-goal)
	(up-get-fact unit-type-count-total battering-ram-line temporary-goal)
	(up-modify-goal temporary-goal2 g:+ temporary-goal)
	(up-get-fact unit-type-count-total armored-elephant-line temporary-goal)
	(up-modify-goal temporary-goal2 g:+ temporary-goal)
	(up-get-fact unit-type-count-total bombard-cannon-line temporary-goal)
	(up-modify-goal temporary-goal2 g:+ temporary-goal)
	(up-get-fact unit-type-count-total traction-trebuchet temporary-goal)
	(up-modify-goal temporary-goal2 g:+ temporary-goal)
	(up-get-fact unit-type-count-total petard temporary-goal)
	(up-modify-goal temporary-goal c:z/ 2)
	(up-modify-goal temporary-goal c:max 0)
	(up-modify-goal temporary-goal2 g:+ temporary-goal))
(defrule
	(goal enough-siege no)
(or	(current-age <= feudal-age)
(or	(population g:< siege-pop); del-civ-pop
(or	(up-compare-goal temporary-goal2 >= min-siege)
(or	(up-compare-goal my-mpop g:>= allowed-num-military)
(or	(unit-type-count-total bombard-cannon-line >= 6)
(or	(unit-type-count-total trebuchet-set >= 3)
(or	(unit-type-count-total traction-trebuchet >= 3)
(or	(unit-type-count-total armored-elephant-line >= 5)
	(unit-type-count-total battering-ram-line >= 5)))))))))
=>
	(set-goal enough-siege yes))
;==============================================================
(defrule
	(soldier-count <= 0)
	(timer-triggered reset-now-timer)
=>
	(disable-timer reset-now-timer))
(defrule
	(warboat-count <= 0)
	(timer-triggered reset-navy-timer)
=>
	(disable-timer reset-navy-timer))
(defrule
	(up-compare-flag micro-flag == f-drush-micro)
	(goal drush-waypoint 2)
	(timer-triggered reset-now-timer)
	(up-timer-status reset-cooldown-timer != timer-running)
=>
	(set-goal drush-waypoint 1))
(defrule
	(up-compare-flag micro-flag == f-drush-micro)
	(timer-triggered reset-now-timer)
	(up-timer-status reset-cooldown-timer != timer-running)
=>
	(disable-timer reset-now-timer)
	(up-reset-unit c: -1)
	(up-set-attack-stance -1 c: stance-aggressive)
	(chat-local-to-self text-resetting-military)
;	(set-strategic-number sn-enemy-sighted-response-distance 8)
	(enable-timer reset-cooldown-timer 2))
(defrule
;	(up-compare-flag micro-flag != f-drush-micro)
	(timer-triggered reset-now-timer)
	(up-timer-status reset-cooldown-timer != timer-running)
=>
	(disable-timer reset-now-timer)
	(up-reset-unit c: -1)
	(up-set-attack-stance -1 c: stance-aggressive)
	(chat-local-to-self text-resetting-military)
;	(set-strategic-number sn-enemy-sighted-response-distance 8)
	(enable-timer reset-cooldown-timer 2)); 3
(defrule
	(timer-triggered reset-navy-timer)
;	(up-timer-status three-seconds != timer-running)
;	(up-timer-status reset-cooldown-timer != timer-running)
=>
	(disable-timer reset-navy-timer)
	(chat-local-to-self text-resetting-navy); -nm
	(up-reset-unit c: warship-class)
	(up-set-attack-stance warship-class c: stance-aggressive)
;;	(set-strategic-number sn-enemy-sighted-response-distance 8)
;	(enable-timer reset-cooldown-timer 2)
)

(defrule
	(timer-triggered retreat-timer)
=>
	(disable-timer retreat-timer))
(defrule
	(timer-triggered reset-cooldown-timer)
=>
	(disable-timer reset-cooldown-timer))
(defrule
	(up-timer-status patrol-timer == timer-disabled)
	(up-timer-status retreat-timer != timer-running)
	(up-timer-status reset-now-timer != timer-running)
	(up-compare-flag micro-flag != f-patrol-defense)
	(up-compare-flag micro-flag != f-patrol-help)
	(up-timer-status unit-control-flare-timer2 == timer-disabled)
=>
	(disable-timer retreat-timer)); test


(defrule
	(timer-triggered group9)
	(up-group-size c: 9 >= 1)
=>
	(chat-local-to-self "Resetting group9.")
	(disable-timer group9)
	(up-full-reset-search)
	(up-set-group search-local c: 9)
	(up-target-point 0 action-stop -1 stance-aggressive)
	(up-modify-group-flag 0 c: 9)
	(up-reset-group c: 9))

(defrule
	(up-group-size c: 9 >= 1)
=>
	(up-set-target-point self-x)
	(up-full-reset-search)
	(up-set-group search-local c: 9)
	(up-remove-objects search-local object-data-distance >= 8))
(defrule
	(up-group-size c: 9 >= 1)
	(up-set-target-object search-local c: 0)
=>
	(chat-local-to-self "Cleaning units out of group9.")
	(up-target-point 0 action-stop -1 stance-aggressive)
	(up-full-reset-search)
	(up-set-group search-local c: 9)
	(up-remove-objects search-local object-data-distance < 8)
	(up-modify-group-flag 0 c: 9)
	(up-reset-group c: 9)
	(up-create-group 0 0 c: 9)
	(up-modify-group-flag 1 c: 9))


(defrule
(or	(goal attack-start yes)
;(or	(timer-triggered thirty-seconds)
(or	(timer-triggered stance-timer)
(or	(timer-triggered reset-now-timer)
	(and	(strategic-number sn-maximum-town-size <= 14)
		(up-timer-status retreat-timer == timer-running)))));); just retreated
=>
	(up-update-targets))