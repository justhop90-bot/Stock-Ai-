(defrule
	(population g:< del-civ-pop)
	(up-timer-status reset-navy-timer != timer-running)
	(unit-type-count siege-ship < 3)
	(unit-type-count turtle-ship-line < 12)
(or	(up-projectile-detected projectile-castle < 3000)
	(up-projectile-detected projectile-bombard-tower < 3000))
(or	(up-projectile-target projectile-fortification == warship-class)
(or	(up-projectile-target projectile-castle == warship-class)
	(up-projectile-target projectile-bombard-tower == warship-class)))
=>
;	(chat-local-to-self "Retreat: Warships.0")
	(up-set-attack-stance warship-class c: stance-defensive)
	(up-retreat-to dock c: warship-class)
	(enable-timer reset-navy-timer 15)
	(set-strategic-number sn-percent-attack-boats 0)
	(set-strategic-number sn-number-boat-attack-groups 0))
(defrule
	(population g:< max-civ-pop)
	(up-timer-status reset-navy-timer != timer-running)
	(unit-type-count siege-ship <= 0)
	(unit-type-count turtle-ship-line <= 2)
	(up-compare-goal navy-count < 8); 16
(or	(up-projectile-detected projectile-town-center < 3000)
	(up-projectile-detected projectile-watch-tower < 3000))
(or	(up-projectile-target projectile-fortification == warship-class)
(or	(up-projectile-target projectile-town-center == warship-class)
	(up-projectile-target projectile-watch-tower == warship-class)))
=>
;	(chat-local-to-self "Retreat: Warships.1")
