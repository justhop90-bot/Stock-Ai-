(defrule
	(true)
=>
	(up-modify-sn sn-focus-player-number g:= attacking-enemy)
	(up-full-reset-search)
	(up-modify-goal temporary-goal3 g:= attacking)
	(up-modify-goal temporary-goal3 g:* map-size); 200
