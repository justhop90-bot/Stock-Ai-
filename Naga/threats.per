	(up-compare-goal ep-id <= 8)
=>
	(up-modify-goal temporary-goal3 s:= sn-focus-player-number)
	(up-modify-sn sn-focus-player-number g:= ep-id)
	(up-get-focus-fact unit-type-count monk temporary-goal10); for now
