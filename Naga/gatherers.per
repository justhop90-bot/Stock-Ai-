(defrule
	(strategic-number sn-minimum-civilian-explorers <= 0)
(or	(up-compare-goal gl-game-time s:< sn-home-exploration-time)
	(players-building-count every-enemy <= 0))
(or	(unit-type-count controlled-animal-class s:>= sn-total-number-explorers)
	(and	(up-set-target-by-id g: scouting-unit)
		(and	(up-object-data object-data-class != controlled-animal-class)
			(and	(up-modify-goal temporary-goal s:= sn-total-number-explorers)
				(and	(up-modify-goal temporary-goal c:- 1)
					(unit-type-count controlled-animal-class g:>= temporary-goal))))))
=>
	(up-jump-rule 2))
(defrule
(not	(up-set-target-by-id g: scouting-unit))
	(unit-type-count-total villager >= 2)
(or	(up-resource-amount amount-exploration < 12); test
(or	(nand	(resource-found wood)
		(up-gaia-type-count-total c: wood s:>= sn-required-forest-tiles))
	(nor	(resource-found food)
		(or	(up-compare-goal current-livestock-food >= 250)
			(or	(up-compare-goal forage-count >= 2)
				(unit-type-count villager-food >= 9))))))
=>
	(up-jump-rule 1))
(defrule
(or	(unit-type-count-total villager <= 1)
(or	(up-set-target-by-id g: scouting-unit)
(or	(up-compare-goal dead-villagers s:>= sn-current-age)
	(and	(and	(dropsite-min-distance wood s:<= sn-maximum-wood-drop-distance)
				(dropsite-min-distance wood >= 0))
		(and	(dropsite-min-distance food s:<= sn-maximum-food-drop-distance)
			(dropsite-min-distance food >= 0))))))
=>
	(set-strategic-number sn-percent-civilian-explorers 0)
	(set-strategic-number sn-minimum-civilian-explorers 0)
	(set-strategic-number sn-cap-civilian-explorers 0)
	(up-modify-sn sn-total-number-explorers g:= scout-count)
	(up-modify-sn sn-number-explore-groups g:= scout-count)); end jump


(defrule
	(up-compare-goal nomad-start >= 1)
	(building-type-count town-center >= 1)
	(unit-type-count livestock-class >= 1)
=>
	(up-full-reset-search)
	(up-set-target-point self-x)
	(up-filter-distance c: 6 c: -1)
	(up-find-local c: livestock-class c: 24)
	(up-remove-objects search-local object-data-action == actionid-move)
	(up-target-point 0 action-move -1 -1)
	(disable-self))

#load-if-not-defined DIFFICULTY-EASIEST
