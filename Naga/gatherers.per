	(building-type-count-total stable >= 1)
	(building-type-count-total town-center >= 3)
(or	(strategic-number sn-current-age >= cimperial)
	(up-research-status c: imperial-age >= research-available))
=>
	(set-goal temporary-goal 10); 9
	(up-modify-goal temporary-goal g:+ temporary-goal7)
	(up-get-fact building-type-count-total stable temporary-goal2)
	(up-modify-goal temporary-goal3 g:= temporary-goal2)
	(up-modify-goal temporary-goal2 c:* 6)
	(up-modify-goal temporary-goal2 c:max 0)
	(up-modify-goal temporary-goal2 c:min 18)
	(up-modify-goal temporary-goal2 c:+ 2)
	(up-modify-goal temporary-goal2 g:+ temporary-goal6)
	(up-modify-goal temporary-goal2 c:max 8); 7
	(up-modify-goal temporary-goal3 c:* 5); 6
	(up-modify-goal temporary-goal3 c:max 0)
	(up-modify-goal temporary-goal3 c:min 15)
	(set-goal temporary-goal4 0)
	(up-modify-goal temporary-goal5 g:= temporary-goal)
	(up-modify-goal temporary-goal5 g:+ temporary-goal2)
	(up-modify-goal temporary-goal5 g:+ temporary-goal3)
	(up-modify-goal temporary-goal5 g:+ temporary-goal4)
	(up-modify-goal temporary-goal5 g:- villager-count)
	(up-modify-goal temporary-goal5 c:min 0)
	(up-modify-goal temporary-goal5 c:* -1)
	(up-modify-goal temporary-goal5 c:min 1)
	(up-modify-goal temporary-goal2 g:+ temporary-goal5))
(defrule
(or	(up-compare-goal temporary-goal >= 1)
(or	(up-compare-goal temporary-goal2 >= 1)
(or	(up-compare-goal temporary-goal3 >= 1)
	(up-compare-goal temporary-goal4 >= 1))))
=>
	(up-modify-goal temporary-goal5 g:= temporary-goal)
	(up-modify-goal temporary-goal5 g:+ temporary-goal2)
	(up-modify-goal temporary-goal5 g:+ temporary-goal3)
	(up-modify-goal temporary-goal5 g:+ temporary-goal4)
;	(up-chat-data-to-player my-player-number "Wood-vills: %d" g: temporary-goal)
;	(up-chat-data-to-player my-player-number "Food-vills: %d" g: temporary-goal2)
;	(up-chat-data-to-player my-player-number "Gold-vills: %d" g: temporary-goal3)
;	(up-chat-data-to-player my-player-number "Stone-vills: %d" g: temporary-goal4)
	(up-modify-sn sn-wood-gatherer-percentage g:= temporary-goal)
	(up-modify-sn sn-food-gatherer-percentage g:= temporary-goal2)
	(up-modify-sn sn-gold-gatherer-percentage g:= temporary-goal3)
	(up-modify-sn sn-stone-gatherer-percentage g:= temporary-goal4)
	(up-modify-sn sn-wood-gatherer-percentage g:%/ temporary-goal5)
	(up-modify-sn sn-food-gatherer-percentage g:%/ temporary-goal5)
	(up-modify-sn sn-gold-gatherer-percentage g:%/ temporary-goal5)
	(up-modify-sn sn-stone-gatherer-percentage g:%/ temporary-goal5)
;	(up-chat-data-to-player my-player-number "Wood-%: %d" s: sn-wood-gatherer-percentage)
;	(up-chat-data-to-player my-player-number "Food-%: %d" s: sn-food-gatherer-percentage)
;	(up-chat-data-to-player my-player-number "Gold-%: %d" s: sn-gold-gatherer-percentage)
;	(up-chat-data-to-player my-player-number "Stone-%: %d" s: sn-stone-gatherer-percentage)
)
(defrule
(or	(strategic-number sn-gold-gatherer-percentage <= 12)
	(strategic-number sn-current-age <= feudal))
=>
	(up-jump-rule 3))
(defrule
(or	(up-research-status c: ri-bow-saw == research-available)
	(up-research-status c: farm-tech2 == research-available))
;	(building-type-count-total stable >= 1); 2
(or	(building-type-count-total town-center >= 3)
(or	(up-compare-goal custom-civ-pop-total >= 50)
	(population g:>= desired-civ-pop))); civilian?
=>
	(up-modify-sn sn-wood-gatherer-percentage c:+ 2)
	(up-modify-sn sn-food-gatherer-percentage c:+ 2)
	(up-modify-sn sn-gold-gatherer-percentage c:- 4)
	(up-jump-rule 2))
(defrule
(or	(up-research-status c: ri-scale-barding == research-available)
	(and	(up-research-status c: ri-forging == research-available)
		(unit-type-count-total cavalry-class >= 10)))
;	(building-type-count-total stable >= 1); 2
(or	(building-type-count-total town-center >= 3)
(or	(up-compare-goal custom-civ-pop-total >= 50)
	(population g:>= desired-civ-pop))); civilian?
=>
	(up-modify-sn sn-food-gatherer-percentage c:+ 1)
	(up-modify-sn sn-gold-gatherer-percentage c:- 1)
	(up-jump-rule 1))
(defrule
(or	(up-research-status c: ri-scale-barding == research-available); test
(or	(up-research-status c: ri-gold-mining == research-available)
	(up-research-status c: ri-hand-cart == research-available))); imp unavailable
;	(building-type-count-total stable >= 1); 2
(or	(building-type-count-total town-center >= 3)
(or	(up-compare-goal custom-civ-pop-total >= 50)
	(population g:>= desired-civ-pop))); civilian?
=>
	(up-modify-sn sn-wood-gatherer-percentage c:+ 1)
	(up-modify-sn sn-food-gatherer-percentage c:+ 1)
	(up-modify-sn sn-gold-gatherer-percentage c:- 2)); end jumps


(defrule
(or	(up-compare-goal strategy != steppe-rush)
