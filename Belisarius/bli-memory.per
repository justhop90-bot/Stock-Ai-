; Belisarius bli-memory.per — Prompt 2 INFORMATION MEMORY.
; Latch only what was actually observed. Each *-at goal stores an EXPIRY
; (game-time + 300s). Refresh re-arms the expiry. Decay fires only when the
; expiry passed AND the thing is no longer visible. No omniscience.

; --- touch helper: every latch also re-arms the global refresh deadline ---
; (inlined per rule to keep single authority: memory owns its timestamps.)

; --- production buildings ---
(defrule
  (players-building-type-count any-enemy stable >= 1)
  (up-compare-goal bli-em-stable == bli-no)
=>
  (set-goal bli-em-stable bli-yes)
  (up-modify-goal bli-em-stable-at g:= bli-game-time)
  (up-modify-goal bli-em-stable-at c:+ 300)
  (up-modify-goal bli-last-enemy-contact g:= bli-game-time)
  (up-modify-goal bli-refresh-due g:= bli-game-time)
  (up-modify-goal bli-refresh-due c:+ 300))
(defrule
  (players-building-type-count any-enemy stable >= 1)
  (up-compare-goal bli-em-stable == bli-yes)
=>
  (up-modify-goal bli-em-stable-at g:= bli-game-time)
  (up-modify-goal bli-em-stable-at c:+ 300)
  (up-modify-goal bli-last-enemy-contact g:= bli-game-time)
  (up-modify-goal bli-refresh-due g:= bli-game-time)
  (up-modify-goal bli-refresh-due c:+ 300))
(defrule
  (players-building-type-count any-enemy archery-range >= 1)
  (up-compare-goal bli-em-range == bli-no)
=>
  (set-goal bli-em-range bli-yes)
  (up-modify-goal bli-em-range-at g:= bli-game-time)
  (up-modify-goal bli-em-range-at c:+ 300)
  (up-modify-goal bli-last-enemy-contact g:= bli-game-time)
  (up-modify-goal bli-refresh-due g:= bli-game-time)
  (up-modify-goal bli-refresh-due c:+ 300))
(defrule
  (players-building-type-count any-enemy archery-range >= 1)
  (up-compare-goal bli-em-range == bli-yes)
=>
  (up-modify-goal bli-em-range-at g:= bli-game-time)
  (up-modify-goal bli-em-range-at c:+ 300)
  (up-modify-goal bli-last-enemy-contact g:= bli-game-time)
  (up-modify-goal bli-refresh-due g:= bli-game-time)
  (up-modify-goal bli-refresh-due c:+ 300))
