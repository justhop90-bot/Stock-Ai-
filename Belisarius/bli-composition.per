; Belisarius bli-composition.per — Prompt 6 COMPOSITION + COUNTER-COUNTER + ROLE LIFECYCLE (C5).
; Authority: this file owns role demand drivers and target counts.
; Roles persist with hysteresis: evidence accumulates demand, absence decays it.
; Targets are desired unit counts; production rules in bli-production fulfill them.
; Transitions (Spear→Halb, Skirm→Elite, Archer→Xbow→Arbalest, Scout→LightCav→Hussar) are separate gates.

; ================= DEMAND DRIVERS — SPEAR (anti-cavalry frontline) =================
; Evidence: cavalry seen, cavalry predicted, defensive feudal posture
; Decay: when no active target (target == 0) OR target satisfied (units >= target)
; STANDING FLOOR: minimum persistent demand regardless of threat evidence
(defrule
  (current-age == feudal-age)
  (up-compare-goal bli-strategy != bli-strat-fast-castle)
=>
  (up-modify-goal bli-demand-spear c:+ DEMAND_INC_LIGHT))
(defrule
  (or (up-compare-goal bli-target-spear c:== 0)
    (and (up-compare-goal bli-target-spear c:> 0)
      (unit-type-count-total spearman-line c:>= bli-target-spear)))
=>
  (up-modify-goal bli-demand-spear c:- DEMAND_DECAY))
(defrule
  (up-compare-goal bli-int-cav == bli-inv-light)
=>
  (up-modify-goal bli-demand-spear c:+ DEMAND_INC_LIGHT))
(defrule
  (up-compare-goal bli-int-cav == bli-inv-meaningful)
=>
  (up-modify-goal bli-demand-spear c:+ DEMAND_INC_MEANINGFUL))
(defrule
  (up-compare-goal bli-int-cav == bli-inv-heavy)
=>
  (up-modify-goal bli-demand-spear c:+ DEMAND_INC_HEAVY))
(defrule
  (up-compare-goal bli-pred-cav-more == bli-yes)
=>
  (up-modify-goal bli-demand-spear c:+ DEMAND_INC_PREDICTED))
(defrule
  (up-compare-goal bli-strategy == bli-strat-defensive-feudal)
  (current-age == feudal-age)
=>
  (up-modify-goal bli-demand-spear c:+ DEMAND_INC_LIGHT))
(defrule
  (up-compare-goal bli-strategy == bli-strat-ranged-defense)
  (current-age == feudal-age)
=>
  (up-modify-goal bli-demand-spear c:+ DEMAND_INC_MEANINGFUL))
(defrule
  (up-compare-goal bli-strategy == bli-strat-knight-play)
  (current-age == feudal-age)
=>
  (up-modify-goal bli-demand-spear c:+ DEMAND_INC_MEANINGFUL))
; Sustain: active target exists but units < target
(defrule
  (up-compare-goal bli-target-spear c:> 0)
  (unit-type-count-total spearman-line c:< bli-target-spear)
=>
  (up-modify-goal bli-demand-spear c:+ DEMAND_INC_LIGHT))
; Clamp demand
(defrule
  (up-compare-goal bli-demand-spear g:> DEMAND_MAX)
=>
  (set-goal bli-demand-spear DEMAND_MAX))
(defrule
  (up-compare-goal bli-demand-spear c:< 0)
=>
  (set-goal bli-demand-spear 0))
; Convert demand to target count (with floor when role active)
(defrule
  (true)
=>
  (up-modify-goal bli-target-spear g:= bli-demand-spear)
  (up-modify-goal bli-target-spear c:* TARGET_SPEAR_PER_DEMAND))
(defrule
  (up-compare-goal bli-target-spear c:> 0)
  (up-compare-goal bli-target-spear c:< TARGET_SPEAR_MIN)
=>
  (set-goal bli-target-spear TARGET_SPEAR_MIN))

; ================= DEMAND DRIVERS — SKIRM (anti-ranged) =================
; Evidence: archers seen, ranged support predicted
; Decay: when no active target (target == 0) OR target satisfied (units >= target)
; STANDING FLOOR: minimum persistent demand regardless of threat evidence
(defrule
  (current-age == feudal-age)
  (or (up-compare-goal bli-strategy == bli-strat-ranged-defense)
    (or (up-compare-goal bli-strategy == bli-strat-defensive-feudal)
      (up-compare-goal bli-strategy == bli-strat-scout-pressure)))
=>
  (up-modify-goal bli-demand-skirm c:+ DEMAND_INC_LIGHT))
(defrule
  (or (up-compare-goal bli-target-skirm c:== 0)
    (and (up-compare-goal bli-target-skirm c:> 0)
      (unit-type-count-total skirmisher-line c:>= bli-target-skirm)))
=>
  (up-modify-goal bli-demand-skirm c:- DEMAND_DECAY))
(defrule
  (up-compare-goal bli-int-archer == bli-inv-light)
=>
  (up-modify-goal bli-demand-skirm c:+ DEMAND_INC_LIGHT))
(defrule
  (up-compare-goal bli-int-archer == bli-inv-meaningful)
=>
  (up-modify-goal bli-demand-skirm c:+ DEMAND_INC_MEANINGFUL))
(defrule
  (up-compare-goal bli-int-archer == bli-inv-heavy)
=>
  (up-modify-goal bli-demand-skirm c:+ DEMAND_INC_HEAVY))
(defrule
  (up-compare-goal bli-pred-range-support == bli-yes)
=>
  (up-modify-goal bli-demand-skirm c:+ DEMAND_INC_PREDICTED))
(defrule
  (up-compare-goal bli-strategy == bli-strat-ranged-defense)
  (current-age == feudal-age)
=>
  (up-modify-goal bli-demand-skirm c:+ DEMAND_INC_HEAVY))
(defrule
  (up-compare-goal bli-strategy == bli-strat-defensive-feudal)
  (current-age == feudal-age)
=>
  (up-modify-goal bli-demand-skirm c:+ DEMAND_INC_MEANINGFUL))
; Sustain: active target exists but units < target
(defrule
  (up-compare-goal bli-target-skirm c:> 0)
  (unit-type-count-total skirmisher-line c:< bli-target-skirm)
=>
  (up-modify-goal bli-demand-skirm c:+ DEMAND_INC_LIGHT))
(defrule
  (up-compare-goal bli-demand-skirm g:> DEMAND_MAX)
=>
  (set-goal bli-demand-skirm DEMAND_MAX))
(defrule
  (up-compare-goal bli-demand-skirm c:< 0)
=>
  (set-goal bli-demand-skirm 0))
(defrule
  (true)
=>
  (up-modify-goal bli-target-skirm g:= bli-demand-skirm)
  (up-modify-goal bli-target-skirm c:* TARGET_SKIRM_PER_DEMAND))
(defrule
  (up-compare-goal bli-target-skirm c:> 0)
  (up-compare-goal bli-target-skirm c:< TARGET_SKIRM_MIN)
=>
  (set-goal bli-target-skirm TARGET_SKIRM_MIN))

