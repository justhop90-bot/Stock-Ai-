; ================= DEMAND DRIVERS — MONK (multi-factor: relics, healing, conversion, cavalry) =================
; Evidence: relics visible, cavalry threat, own army worth healing, enemy conversion targets
; NOT tied solely to cavalry memory
; Decay: when no active target (target == 0) OR target satisfied (units >= target)
; STANDING FLOOR: minimum persistent demand in Castle for healing/conversion/relics
(defrule
  (current-age == castle-age)
  (or (up-compare-goal bli-strategy == bli-strat-defensive-feudal)
    (or (up-compare-goal bli-strategy == bli-strat-ranged-defense)
      (up-compare-goal bli-strategy == bli-strat-castle-pressure)))
=>
  (up-modify-goal bli-demand-monk c:+ DEMAND_INC_LIGHT))
(defrule
  (or (up-compare-goal bli-target-monk c:== 0)
    (and (up-compare-goal bli-target-monk c:> 0)
      (unit-type-count-total monk c:>= bli-target-monk)))
=>
  (up-modify-goal bli-demand-monk c:- DEMAND_DECAY))
(defrule
  (current-age == castle-age)
  (up-compare-goal bli-relic-seen == bli-yes)
  (gold-amount >= 200)
=>
  (up-modify-goal bli-demand-monk c:+ DEMAND_INC_HEAVY))
(defrule
  (current-age == castle-age)
  (or (up-compare-goal bli-int-cav == bli-inv-meaningful)
    (up-compare-goal bli-int-cav == bli-inv-heavy))
  (military-population >= 8)
=>
  (up-modify-goal bli-demand-monk c:+ DEMAND_INC_MEANINGFUL))
(defrule
  (current-age == castle-age)
  (up-compare-goal bli-own-knight c:> 0)
  (military-population >= 10)
=>
  (up-modify-goal bli-demand-monk c:+ DEMAND_INC_LIGHT))
(defrule
  (current-age == castle-age)
  (players-unit-type-count any-enemy knight-line >= 2)
=>
  (up-modify-goal bli-demand-monk c:+ DEMAND_INC_MEANINGFUL))
(defrule
  (up-compare-goal bli-relic-seen == bli-yes)
  (gold-amount >= 200)
=>
  (up-modify-goal bli-demand-monk c:+ DEMAND_INC_HEAVY))
; Sustain: active target exists but units < target
(defrule
  (up-compare-goal bli-target-monk c:> 0)
  (unit-type-count-total monk c:< bli-target-monk)
=>
  (up-modify-goal bli-demand-monk c:+ DEMAND_INC_LIGHT))
(defrule
  (up-compare-goal bli-demand-monk g:> DEMAND_MAX)
=>
  (set-goal bli-demand-monk DEMAND_MAX))
(defrule
  (up-compare-goal bli-demand-monk c:< 0)
=>
  (set-goal bli-demand-monk 0))
(defrule
  (true)
=>
  (up-modify-goal bli-target-monk g:= bli-demand-monk)
  (up-modify-goal bli-target-monk c:* TARGET_MONK_PER_DEMAND))
(defrule
  (up-compare-goal bli-target-monk c:> 0)
  (up-compare-goal bli-target-monk c:< TARGET_MONK_MIN)
=>
  (set-goal bli-target-monk TARGET_MONK_MIN))

; ================= DEMAND DRIVERS — SIEGE (positional problem solver) =================
; Evidence: castle-pressure strategy, enemy castle plan, enemy fortifications seen
; Decay: when no active target (target == 0) OR target satisfied (units >= target)
; STANDING FLOOR: minimum persistent demand in Castle for siege capability
(defrule
  (current-age == castle-age)
  (up-compare-goal bli-strategy != bli-strat-trash-transition)
=>
  (up-modify-goal bli-demand-siege c:+ DEMAND_INC_LIGHT))
(defrule
  (or (up-compare-goal bli-target-siege c:== 0)
    (and (up-compare-goal bli-target-siege c:> 0)
      (unit-type-count-total battering-ram-line c:>= bli-target-siege)))
=>
  (up-modify-goal bli-demand-siege c:- DEMAND_DECAY))
(defrule
  (up-compare-goal bli-strategy == bli-strat-castle-pressure)
=>
  (up-modify-goal bli-demand-siege c:+ DEMAND_INC_HEAVY))
(defrule
