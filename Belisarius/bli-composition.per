(defrule
  (current-age == castle-age)
  (or (unit-type-count-total scout-cavalry-line >= 3)
    (unit-type-count-total knight-line >= 3))
=>
  (up-modify-goal bli-demand-mobile c:+ DEMAND_INC_MEANINGFUL))
(defrule
  (current-age == castle-age)
  (or (up-compare-goal bli-int-archer == bli-inv-meaningful)
    (up-compare-goal bli-int-archer == bli-inv-heavy))
=>
  (up-modify-goal bli-demand-mobile c:+ DEMAND_INC_LIGHT))
(defrule
  (current-age == imperial-age)
  (up-compare-goal bli-strategy == bli-strat-trash-transition)
=>
  (up-modify-goal bli-demand-mobile c:+ DEMAND_INC_HEAVY))
; Sustain: active target exists but units < target
(defrule
  (up-compare-goal bli-target-mobile c:> 0)
  (unit-type-count-total scout-cavalry-line c:< bli-target-mobile)
=>
  (up-modify-goal bli-demand-mobile c:+ DEMAND_INC_LIGHT))
(defrule
  (up-compare-goal bli-demand-mobile g:> DEMAND_MAX)
=>
  (set-goal bli-demand-mobile DEMAND_MAX))
(defrule
  (up-compare-goal bli-demand-mobile c:< 0)
=>
  (set-goal bli-demand-mobile 0))
(defrule
  (true)
=>
  (up-modify-goal bli-target-mobile g:= bli-demand-mobile)
  (up-modify-goal bli-target-mobile c:* TARGET_MOBILE_PER_DEMAND))
(defrule
  (up-compare-goal bli-target-mobile c:> 0)
  (up-compare-goal bli-target-mobile c:< TARGET_MOBILE_MIN)
=>
  (set-goal bli-target-mobile TARGET_MOBILE_MIN))

; ================= DEMAND DRIVERS — CAMEL (Byzantine anti-cavalry) =================
; Evidence: heavy cavalry threat, Castle/Imperial, gold available
; Byzantine bonus: -20% cost, +1 pierce armor
; Decay: when no active target (target == 0) OR target satisfied (units >= target)
; STANDING FLOOR: minimum persistent Camel demand when heavy cavalry threat exists
(defrule
  (current-age == castle-age)
  (or (up-compare-goal bli-int-cav == bli-inv-meaningful)
    (up-compare-goal bli-int-cav == bli-inv-heavy))
  (gold-amount >= 200)
=>
  (up-modify-goal bli-demand-camel c:+ DEMAND_INC_MEANINGFUL))
(defrule
  (current-age == imperial-age)
  (or (up-compare-goal bli-int-cav == bli-inv-meaningful)
    (up-compare-goal bli-int-cav == bli-inv-heavy))
  (gold-amount >= 200)
=>
  (up-modify-goal bli-demand-camel c:+ DEMAND_INC_MEANINGFUL))
; Sustain: active target exists but units < target
(defrule
  (up-compare-goal bli-target-camel c:> 0)
  (unit-type-count-total camel-line c:< bli-target-camel)
=>
  (up-modify-goal bli-demand-camel c:+ DEMAND_INC_LIGHT))
(defrule
  (up-compare-goal bli-demand-camel g:> DEMAND_MAX)
=>
  (set-goal bli-demand-camel DEMAND_MAX))
(defrule
  (up-compare-goal bli-demand-camel c:< 0)
=>
  (set-goal bli-demand-camel 0))
(defrule
  (true)
=>
  (up-modify-goal bli-target-camel g:= bli-demand-camel)
  (up-modify-goal bli-target-camel c:* TARGET_CAMEL_PER_DEMAND))
(defrule
  (up-compare-goal bli-target-camel c:> 0)
  (up-compare-goal bli-target-camel c:< TARGET_CAMEL_MIN)
=>
  (set-goal bli-target-camel TARGET_CAMEL_MIN))

; ================= COMPOSITION ARBITRATION (Byzantine) =================
; Explicit priority ordering for stable production:
; 1. Camel (anti-cavalry) > Light Cavalry/Hussar (mobility/raiding) > Knight (heavy cav)
; Priority enforced by production rules checking higher-priority targets first
; If Camel target > 0, Stable produces Camels first
; Then Light Cavalry/Hussar if mobile target > 0
; Then Knight if knight target > 0 and no higher priority

; ================= DEMAND DRIVERS — CATAPHRACT (Byzantine situational) =================
; Evidence: Byzantine, Castle/Imperial, castle standing, meaningful/heavy infantry, gold
; Decay: when no active target (target == 0) OR target satisfied (units >= target)
; STANDING FLOOR: minimum persistent demand for Byzantine unique unit in Castle/Imperial
(defrule
  (civ-selected byzantine)
  (or (current-age == castle-age)
    (current-age == imperial-age))
  (building-type-count-total castle >= 1)
=>
  (up-modify-goal bli-demand-cata c:+ DEMAND_INC_LIGHT))
(defrule
  (or (up-compare-goal bli-target-cata c:== 0)
    (and (up-compare-goal bli-target-cata c:> 0)
      (unit-type-count-total cataphract-line c:>= bli-target-cata)))
=>
  (up-modify-goal bli-demand-cata c:- DEMAND_DECAY))
(defrule
  (civ-selected byzantine)
  (or (current-age == castle-age)
    (current-age == imperial-age))
  (building-type-count-total castle >= 1)
  (up-compare-goal bli-int-inf == bli-inv-meaningful)
  (gold-amount >= 500)
=>
  (up-modify-goal bli-demand-cata c:+ DEMAND_INC_MEANINGFUL))
(defrule
  (civ-selected byzantine)
  (or (current-age == castle-age)
    (current-age == imperial-age))
  (building-type-count-total castle >= 1)
  (up-compare-goal bli-int-inf == bli-inv-heavy)
  (gold-amount >= 500)
=>
  (up-modify-goal bli-demand-cata c:+ DEMAND_INC_HEAVY))
; Sustain: active target exists but units < target
(defrule
  (up-compare-goal bli-target-cata c:> 0)
  (unit-type-count-total cataphract-line c:< bli-target-cata)
=>
  (up-modify-goal bli-demand-cata c:+ DEMAND_INC_LIGHT))
(defrule
  (up-compare-goal bli-demand-cata g:> DEMAND_MAX)
=>
  (set-goal bli-demand-cata DEMAND_MAX))
(defrule
  (up-compare-goal bli-demand-cata c:< 0)
=>
  (set-goal bli-demand-cata 0))
(defrule
  (true)
=>
  (up-modify-goal bli-target-cata g:= bli-demand-cata)
  (up-modify-goal bli-target-cata c:* TARGET_CATA_PER_DEMAND))
(defrule
  (up-compare-goal bli-target-cata c:> 0)
  (up-compare-goal bli-target-cata c:< TARGET_CATA_MIN)
=>
  (set-goal bli-target-cata TARGET_CATA_MIN))

; ================= COUNTER-COUNTER ADJUSTMENTS (demand modifiers, not boolean flips) =================
; Pure spears + mixed enemy → add skirm demand
(defrule
  (up-compare-goal bli-demand-spear c:> 10)
  (or (up-compare-goal bli-opp-mixed == bli-yes)
    (up-compare-goal bli-pred-range-support == bli-yes))
  (up-compare-goal bli-demand-skirm c:< DEMAND_INC_MEANINGFUL)
=>
  (up-modify-goal bli-demand-skirm c:+ DEMAND_INC_MEANINGFUL))
; Skirms + cavalry threat → ensure spear demand
(defrule
  (up-compare-goal bli-demand-skirm c:> 10)
  (or (up-compare-goal bli-int-cav == bli-inv-meaningful)
    (up-compare-goal bli-int-cav == bli-inv-heavy))
  (up-compare-goal bli-demand-spear c:< DEMAND_INC_LIGHT)
=>
  (up-modify-goal bli-demand-spear c:+ DEMAND_INC_LIGHT))
; Knights + infantry threat → add archer demand
(defrule
  (up-compare-goal bli-demand-knight c:> 5)
  (or (up-compare-goal bli-int-inf == bli-inv-meaningful)
    (up-compare-goal bli-int-inf == bli-inv-heavy))
  (up-compare-goal bli-demand-archer c:< DEMAND_INC_LIGHT)
=>
  (up-modify-goal bli-demand-archer c:+ DEMAND_INC_LIGHT))

; ================= ROLE TRANSITION GATES (C5: age/upgrade progression) =================
; Spear → Halb: sufficient mass + Castle/Imperial + cavalry remains relevant
(defrule
  (current-age == castle-age)
  (up-compare-goal bli-target-spear c:>= 8)
  (or (up-compare-goal bli-int-cav == bli-inv-meaningful)
    (or (up-compare-goal bli-int-cav == bli-inv-heavy)
      (up-compare-goal bli-pred-cav-more == bli-yes)))
=>
  (set-goal bli-role-spear-to-halb bli-yes))
(defrule
  (current-age == imperial-age)
  (up-compare-goal bli-target-spear c:>= 6)
=>
  (set-goal bli-role-spear-to-halb bli-yes))
(defrule
  (or (current-age == dark-age)
    (or (current-age == feudal-age)
      (and (current-age == castle-age)
        (and (up-compare-goal bli-int-cav == bli-inv-none)
          (and (up-compare-goal bli-pred-cav-more == bli-no)
            (up-compare-goal bli-target-spear c:< 8))))))
=>
  (set-goal bli-role-spear-to-halb bli-no))

; Skirm → Elite Skirm: sufficient mass + Imperial + ranged pressure sustained
(defrule
  (current-age == imperial-age)
  (up-compare-goal bli-target-skirm c:>= 8)
  (or (up-compare-goal bli-int-archer != bli-inv-none)
    (up-compare-goal bli-pred-range-support == bli-yes))
=>
  (set-goal bli-role-skirm-to-elite bli-yes))
(defrule
  (or (current-age != imperial-age)
    (or (up-compare-goal bli-target-skirm c:< 8)
      (and (up-compare-goal bli-int-archer == bli-inv-none)
        (up-compare-goal bli-pred-range-support == bli-no))))
=>
  (set-goal bli-role-skirm-to-elite bli-no))

; Archer → Crossbow: Castle age + archer mass + ranged strategy or mixed need
(defrule
  (current-age == castle-age)
  (up-compare-goal bli-target-archer c:>= 8)
  (or (up-compare-goal bli-strategy == bli-strat-archer-pressure)
    (or (up-compare-goal bli-opp-mixed == bli-yes)
      (up-compare-goal bli-int-inf != bli-inv-none)))
=>
  (set-goal bli-role-archer-to-xbow bli-yes))
(defrule
  (or (current-age != castle-age)
    (or (up-compare-goal bli-target-archer c:< 8)
      (and (up-compare-goal bli-strategy != bli-strat-archer-pressure)
        (and (up-compare-goal bli-opp-mixed == bli-no)
          (up-compare-goal bli-int-inf == bli-inv-none)))))
=>
  (set-goal bli-role-archer-to-xbow bli-no))

; Archer → Arbalest: Imperial + crossbow done + archer mass worth upgrading
(defrule
  (current-age == imperial-age)
  (research-completed ri-bodkin-arrow)
  (up-compare-goal bli-target-archer c:>= 10)
=>
  (set-goal bli-role-archer-to-arbalest bli-yes))
(defrule
  (or (current-age != imperial-age)
    (up-compare-goal bli-target-archer c:< 10))
=>
  (set-goal bli-role-archer-to-arbalest bli-no))

; Scout → Light Cav: Castle + existing scout mass + mobility role active
(defrule
  (current-age == castle-age)
  (up-compare-goal bli-target-mobile c:>= 4)
  (unit-type-count-total scout-cavalry-line >= 3)
=>
  (set-goal bli-role-scout-to-lightcav bli-yes))
(defrule
  (or (current-age != castle-age)
    (up-compare-goal bli-target-mobile c:< 4))
=>
  (set-goal bli-role-scout-to-lightcav bli-no))

; Light Cav → Hussar: Imperial + trash transition or mobility scaling
(defrule
  (current-age == imperial-age)
  (or (up-compare-goal bli-strategy == bli-strat-trash-transition)
    (and (up-compare-goal bli-target-mobile c:>= 6)
      (unit-type-count-total light-cavalry >= 4)))
=>
  (set-goal bli-role-lightcav-to-hussar bli-yes))
(defrule
  (current-age != imperial-age)
=>
  (set-goal bli-role-lightcav-to-hussar bli-no))
(defrule
  (current-age == imperial-age)
  (up-compare-goal bli-strategy != bli-strat-trash-transition)
  (up-compare-goal bli-target-mobile c:< 6)
=>
  (set-goal bli-role-lightcav-to-hussar bli-no))
(defrule
  (current-age == imperial-age)
  (up-compare-goal bli-strategy != bli-strat-trash-transition)
  (unit-type-count-total light-cavalry < 4)
=>
  (set-goal bli-role-lightcav-to-hussar bli-no))