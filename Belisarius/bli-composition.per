  (up-compare-goal bli-int-castle-plan == bli-yes)
=>
  (up-modify-goal bli-demand-siege c:+ DEMAND_INC_MEANINGFUL))
(defrule
  (current-age >= castle-age)
  (or (players-building-type-count any-enemy castle >= 1)
    (or (players-building-type-count any-enemy watch-tower >= 2)
      (players-building-type-count any-enemy palisade-wall >= 5)))
=>
  (up-modify-goal bli-demand-siege c:+ DEMAND_INC_LIGHT))
; Sustain: active target exists but units < target
