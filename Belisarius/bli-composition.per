  (up-compare-goal bli-target-siege c:> 0)
  (unit-type-count-total battering-ram-line c:< bli-target-siege)
=>
  (up-modify-goal bli-demand-siege c:+ DEMAND_INC_LIGHT))
(defrule
  (up-compare-goal bli-demand-siege g:> DEMAND_MAX)
=>
  (set-goal bli-demand-siege DEMAND_MAX))
(defrule
  (up-compare-goal bli-demand-siege c:< 0)
=>
  (set-goal bli-demand-siege 0))
(defrule
  (true)
=>
  (up-modify-goal bli-target-siege g:= bli-demand-siege)
  (up-modify-goal bli-target-siege c:* TARGET_SIEGE_PER_DEMAND))
(defrule
  (up-compare-goal bli-target-siege c:> 0)
  (up-compare-goal bli-target-siege c:< TARGET_SIEGE_MIN)
=>
  (set-goal bli-target-siege TARGET_SIEGE_MIN))

; ================= DEMAND DRIVERS — MOBILE (raiding, map control, trash transition) =================
; Evidence: existing raid force, chasing ranged, trash transition strategy
; Decay: when no active target (target == 0) OR target satisfied (units >= target)
; STANDING FLOOR: minimum persistent mobile demand in Castle/Imperial
; FEUDAL MOBILE: Scout/Light Cav demand in Feudal for raiding/mobility
(defrule
  (or (current-age == castle-age)
    (current-age == imperial-age))
  (up-compare-goal bli-strategy != bli-strat-trash-transition)
=>
  (up-modify-goal bli-demand-mobile c:+ DEMAND_INC_LIGHT))
