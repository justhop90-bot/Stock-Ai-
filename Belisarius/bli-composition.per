=>
  (up-modify-goal bli-demand-archer c:+ DEMAND_INC_MEANINGFUL))
(defrule
  (up-compare-goal bli-int-inf == bli-inv-heavy)
  (current-age == feudal-age)
=>
  (up-modify-goal bli-demand-archer c:+ DEMAND_INC_HEAVY))
(defrule
  (up-compare-goal bli-opp-main == bli-opp-infantry)
