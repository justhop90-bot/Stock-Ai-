; --- Prompt 5 economy focus init + Dark-age allocation (engine applies on first pass) ---
(defrule
  (true)
=>
  (set-goal bli-eco-focus bli-eco-balanced)
  (set-strategic-number sn-food-gatherer-percentage 75)
  (set-strategic-number sn-wood-gatherer-percentage 25)
  (set-strategic-number sn-gold-gatherer-percentage 0)
  (set-strategic-number sn-stone-gatherer-percentage 0)
  (up-assign-builders c: house c: 1)
  (up-assign-builders c: town-center-foundation c: 2)
  (disable-self))

