; ================= PRODUCTION SCALING (capacity follows target depth) =================
; A second building is justified when one cannot fill the need in required timing:
; mixed demand, heavy commitment, or deep standing deficit.

; 2nd Barracks: heavy spear demand, or mixed infantry+ranged demand, or heavy cav threat
; Respect Castle bank protection.
(defrule
  (building-type-count-total barracks == 1)
  (can-build barracks)
  (or (up-compare-goal bli-target-spear c:>= 12)
    (or (and (up-compare-goal bli-target-spear c:> 0)
      (or (up-compare-goal bli-target-skirm c:> 0)
        (up-compare-goal bli-target-archer c:> 0)))
      (and (up-compare-goal bli-int-cav == bli-inv-heavy)
        (up-compare-goal bli-target-spear c:> 0))))
  (wood-amount >= 175)
  (up-compare-goal bli-castle-bank-protected == bli-no)
=>
  (build barracks))

; 2nd Archery Range: double ranged demand, or committed archer flood behind schedule, or skirmisher-only pressure
; Respect Castle bank protection.
(defrule
  (building-type-count-total archery-range == 1)
  (can-build archery-range)
  (or (and (up-compare-goal bli-target-skirm c:> 0)
        (up-compare-goal bli-target-archer c:> 0))
    (and (up-compare-goal bli-target-skirm c:> 0)
      (and (up-compare-goal bli-target-archer c:< 1)
        (wood-amount >= 175))))
  (up-compare-goal bli-castle-bank-protected == bli-no)
=>
  (build archery-range))
(defrule
  (building-type-count-total archery-range == 1)
  (can-build archery-range)
  (up-compare-goal bli-strategy == bli-strat-archer-pressure)
  (up-compare-goal bli-target-archer c:> 0)
  (unit-type-count-total archer-line < 4)
  (wood-amount >= 175)
  (up-compare-goal bli-castle-bank-protected == bli-no)
=>
  (build archery-range))

; 3rd Range: very heavy ranged commitment (20+ target)
; Respect Castle bank protection.
(defrule
  (building-type-count-total archery-range == 2)
  (can-build archery-range)
  (or (up-compare-goal bli-target-archer c:>= 20)
    (up-compare-goal bli-target-skirm c:>= 20))
  (wood-amount >= 175)
  (up-compare-goal bli-castle-bank-protected == bli-no)
=>
  (build archery-range))

; First Stable in Castle: mobility target > 0 but no stable yet
; Respect Castle bank protection.
(defrule
  (current-age == castle-age)
  (building-type-count-total stable <= 0)
  (can-build stable)
  (up-compare-goal bli-target-mobile c:> 0)
  (up-compare-goal bli-castle-bank-protected == bli-no)
=>
  (build stable))

; 2nd Stable: heavy mobility commitment (12+ target)
; Respect Castle bank protection.
(defrule
  (current-age >= castle-age)
  (building-type-count-total stable == 1)
  (can-build stable)
  (up-compare-goal bli-target-mobile c:>= 12)
  (wood-amount >= 175)
  (up-compare-goal bli-castle-bank-protected == bli-no)
=>
  (build stable))

; Siege Workshop: siege target > 0 in Castle+
; Respect Castle bank protection.
(defrule
  (current-age == castle-age)
  (building-type-count-total siege-workshop <= 0)
  (can-build siege-workshop)
  (up-compare-goal bli-target-siege c:> 0)
  (up-compare-goal bli-castle-bank-protected == bli-no)
=>
  (build siege-workshop))

; Monastery: monk target > 0 in Feudal+ (relics, healing, conversion)
; Respect Castle bank protection.
(defrule
  (current-age == feudal-age)
  (building-type-count-total monastery <= 0)
  (can-build monastery)
  (up-compare-goal bli-target-monk c:> 0)
  (up-compare-goal bli-castle-bank-protected == bli-no)
=>
  (build monastery))
(defrule
  (current-age == castle-age)
  (building-type-count-total monastery <= 0)
  (can-build monastery)
  (up-compare-goal bli-target-monk c:> 0)
  (up-compare-goal bli-castle-bank-protected == bli-no)
=>
  (build monastery))

; University: Imperial prep — needed for ballistics/chemistry when archer target exists
; Also needed for Imperial transition (chemistry, architecture, siege engineers)
; Respect Castle bank protection.
(defrule
  (current-age == castle-age)
  (building-type-count-total university <= 0)
  (can-build university)
  (up-compare-goal bli-target-archer c:> 0)
  (up-compare-goal bli-castle-bank-protected == bli-no)
=>
  (build university))
(defrule
  (current-age == castle-age)
  (building-type-count-total university <= 0)
  (can-build university)
  (up-compare-goal bli-commit-id == bli-commit-imperial)
  (up-compare-goal bli-castle-bank-protected == bli-no)
=>
  (build university))

; Castle: pressure strategy or answering fortification, stone in hand
; Respect Castle bank protection.
(defrule
  (current-age == castle-age)
  (building-type-count-total castle <= 0)
  (can-build castle)
  (stone-amount >= 650)
  (or (up-compare-goal bli-strategy == bli-strat-castle-pressure)
    (up-compare-goal bli-int-castle-plan == bli-yes))
  (up-compare-goal bli-castle-bank-protected == bli-no)
=>
  (build castle))

; 2nd Castle: heavy siege/cataphract commitment or castle pressure
; Respect Castle bank protection.
(defrule
  (current-age == castle-age)
  (building-type-count-total castle == 1)
  (can-build castle)
  (stone-amount >= 650)
  (or (up-compare-goal bli-target-cata c:>= 4)
    (or (up-compare-goal bli-target-siege c:>= 4)
      (up-compare-goal bli-strategy == bli-strat-castle-pressure)))
  (up-compare-goal bli-castle-bank-protected == bli-no)
=>
  (build castle))