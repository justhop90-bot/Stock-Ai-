; Belisarius bli-production.per — Prompt 6 PRODUCTION (capacity as strategy, C5: target-driven).
; Authority: training all military + building 2nd+ production, siege workshop,
; monastery, castle. bli-opening owns the FIRST barracks/stable/range/market/smith.
; Training uses target counts (bli-target-*) from bli-composition; trains only the deficit.
; Building rules trigger when target > 0 and infrastructure missing/insufficient.

; ================= TRAINING (deficit against target; effective = live + queued) =================
; unit-type-count-total counts standing + queued, so each rule trains only the missing remainder.
; When target is met, training stops; existing units retained; resources redirect to next priority.

; Spears / Halberdier: target from bli-target-spear, bank-guarded
; Respect Castle bank protection.
(defrule
  (can-train spearman-line)
  (up-compare-goal bli-target-spear c:> 0)
  (unit-type-count-total spearman-line c:< bli-target-spear)
  (or (up-compare-goal bli-commit-id == bli-no)
    (up-compare-goal bli-spend-food >= 100))
  (up-compare-goal bli-castle-bank-protected == bli-no)
=>
  (train spearman-line))

; Skirmisher / Elite Skirmisher: target from bli-target-skirm
; Respect Castle bank protection.
(defrule
  (can-train skirmisher-line)
  (up-compare-goal bli-target-skirm c:> 0)
  (unit-type-count-total skirmisher-line c:< bli-target-skirm)
  (or (up-compare-goal bli-commit-id == bli-no)
    (up-compare-goal bli-spend-food >= 100))
  (up-compare-goal bli-castle-bank-protected == bli-no)
=>
  (train skirmisher-line))

; Archer / Crossbow / Arbalest: target from bli-target-archer, bank-guarded
; Fast Castle protects its bank: don't train archers from committed food unless defending
; Respect Castle bank protection.
(defrule
  (can-train archer-line)
  (up-compare-goal bli-target-archer c:> 0)
  (unit-type-count-total archer-line c:< bli-target-archer)
  (or (up-compare-goal bli-strategy != bli-strat-fast-castle)
    (or (food-amount < 700)
      (gold-amount >= 200)))
  (or (up-compare-goal bli-commit-id == bli-no)
    (or (up-compare-goal bli-spend-food >= 150)
      (up-compare-goal bli-enemy-in-town == bli-yes)))
  (up-compare-goal bli-castle-bank-protected == bli-no)
=>
  (train archer-line))

; Scout (Feudal): target from bli-target-scout
; Respect Castle bank protection.
(defrule
  (current-age == feudal-age)
  (can-train scout-cavalry-line)
  (up-compare-goal bli-target-scout c:> 0)
  (unit-type-count-total scout-cavalry-line c:< bli-target-scout)
  (or (up-compare-goal bli-commit-id == bli-no)
    (or (up-compare-goal bli-spend-food >= 100)
      (up-compare-goal bli-enemy-in-town == bli-yes)))
  (up-compare-goal bli-castle-bank-protected == bli-no)
=>
  (train scout-cavalry-line))
; Light Cav / Hussar (Castle+): target from bli-target-mobile (mobility role)
; Respect Castle bank protection.
(defrule
  (current-age == castle-age)
  (can-train light-cavalry)
  (up-compare-goal bli-target-mobile c:> 0)
  (unit-type-count-total light-cavalry c:< bli-target-mobile)
  (or (up-compare-goal bli-commit-id == bli-no)
    (or (up-compare-goal bli-spend-food >= 100)
      (up-compare-goal bli-enemy-in-town == bli-yes)))
  (up-compare-goal bli-castle-bank-protected == bli-no)
=>
  (train light-cavalry))
(defrule
  (current-age == imperial-age)
  (can-train hussar)
  (up-compare-goal bli-target-mobile c:> 0)
  (unit-type-count-total hussar c:< bli-target-mobile)
  (or (up-compare-goal bli-commit-id == bli-no)
    (or (up-compare-goal bli-spend-food >= 100)
      (up-compare-goal bli-enemy-in-town == bli-yes)))
  (up-compare-goal bli-castle-bank-protected == bli-no)
=>
  (train hussar))

