; Belisarius bli-villagers.per — Prompt 5 VILLAGER MANAGEMENT + BUILDERS.
; Authority: reassignment-by-percentages lives in bli-economy; this file owns
; protection (militia), threat-sized response, and builder assignments.
; It never trains villagers (bli-opening owns that) and never sets gatherer
; percentages. Response reflects threat magnitude, not blind panic (§35).

; ================= BUILDER PROTECTION & CONSTRUCTION CONTINUITY =================
; Builders under light threat should NOT abandon construction.
; Track buildings under construction and their assigned builders.
; Only retreat builders when threat is genuinely overwhelming.

; ================= BUILDER PROTECTION & CONSTRUCTION CONTINUITY =================
; Builders under light threat should NOT abandon construction.
; Track buildings under construction using pending-objects conditions directly in rules.
; Only retreat builders when threat is genuinely overwhelming.

; ================= MILITIA (small isolated threat: villagers defend) =================

; Moderate threat (3-5 units): builders evacuate only if construction is near complete
(defrule
  (up-enemy-units-in-town >= 3)
  (up-enemy-units-in-town <= 5)
  (military-population < 8)
  (or (current-age == dark-age)
    (current-age == feudal-age))
  (up-compare-goal bli-any-construction-pending == bli-yes)
=>
  (set-strategic-number sn-number-civilian-militia 0))

; Heavy threat (6+ units or castle age): all civilians evacuate, construction abandoned
(defrule
  (or (up-enemy-units-in-town >= 6)
    (current-age >= castle-age))
  (up-compare-goal bli-any-construction-pending == bli-yes)
=>
  (set-strategic-number sn-number-civilian-militia 0))

; Construction completion tracking: when building finishes, log it
; Building destruction tracking: if building destroyed while under construction, flag for rebuild
(defrule
  (up-compare-goal bli-pending-houses > 0)
  (building-type-count-total house > 0)
=>
  (set-goal bli-pending-houses 0))
