; ================= MILITIA (small isolated threat: villagers defend) =================
; 1-3 enemies inside with almost no army: fight with villagers, keep economy.
(defrule
  (up-enemy-units-in-town >= 1)
  (up-enemy-units-in-town <= 3)
  (military-population < 5)
  (or (current-age == dark-age)
    (current-age == feudal-age))
=>
  (set-strategic-number sn-allow-civilian-defense 1)
  (set-strategic-number sn-number-civilian-militia 3))
; Larger or later threat: villagers are not the answer (army/defense own it).
(defrule
  (or (up-enemy-units-in-town >= 4)
    (or (military-population >= 5)
      (current-age >= castle-age)))
  (strategic-number sn-number-civilian-militia >= 1)
=>
  (set-strategic-number sn-number-civilian-militia 0))
; Stand down once cleared.
(defrule
  (up-enemy-units-in-town <= 0)
  (not (town-under-attack))
  (strategic-number sn-number-civilian-militia >= 1)
=>
  (set-strategic-number sn-number-civilian-militia 0))

; ================= RAID REPLACEMENT (recognize the economic consequence) =================
; Raiders killed villagers: the loss is already counted in bli-vill-count
; snapshots; opening caps retrain automatically. Here, shift wood toward
; recovery (farms were likely idled) instead of merely waiting.
(defrule
  (up-compare-goal bli-enemy-in-town == bli-yes)
  (civilian-population < 25)
  (current-age == feudal-age)
  (wood-amount >= 120)
  (can-build farm)
  (idle-farm-count <= 1)
=>
  (build farm))
